#!/usr/bin/env bash
# huginn-llm — one question to a serving machine's local model, answer on stdout.
#
# The P6 delegation lane: the door through which huginn-side agents (and the
# owner, over ssh) hand a task to the local tier instead of spending Claude.
# Host-side for the same reasons as huginn-rounds/huginn-devices beside it: the
# bearer token never leaves this machine, and there is ONE implementation of
# "ask the local tier" rather than one per caller.
#
# It rides the ordinary chat lane — create, send, poll, read, DELETE — so the
# whole serving path is exercised, exactly like the daily smoke. The chat is
# removed on success AND on failure: a delegation tool must not litter the
# owner's chat list (--keep exists for debugging a bad answer).
#
#   huginn-llm [--model <row-id>] [--timeout <s>] [--keep] "prompt"
#   echo "text" | huginn-llm -            (prompt from stdin, e.g. summarise)
#
# Refusals are the daemon's own words (they name the MACHINE since 2.78.0);
# an offline tier is exit 1 with the reason, never a hang.
set -u

API=http://127.0.0.1:8787
TOKEN_FILE=/etc/huginn-appd/token
[ -s "$TOKEN_FILE" ] || { echo "huginn-llm: no appd token at $TOKEN_FILE" >&2; exit 1; }
TOKEN="$(cat "$TOKEN_FILE")"
# ⚠ THE TOKEN NEVER GOES ON A COMMAND LINE. /proc/<pid>/cmdline is readable by
# every account on this host and the token is root-equivalent - and this script
# polls, one curl every two seconds for as long as the model takes, so an
# `-H "Authorization: Bearer ..."` argument kept it on display the whole time.
# The header reaches curl through a file descriptor instead (-H @file, curl
# 7.55+), and printf is a bash builtin, so no process carries the token in its
# arguments. scripts/test-no-token-argv.sh holds every script to this.
appd_curl() {
  curl -H @<(printf 'Authorization: Bearer %s\n' "$TOKEN") -H "content-type: application/json" "$@"
}

MODEL= TIMEOUT=120 KEEP= PROMPT=
while [ $# -gt 0 ]; do
  case "$1" in
    --model)   MODEL="${2:?--model needs a value}"; shift 2 ;;
    --timeout) TIMEOUT="${2:?--timeout needs a value}"; shift 2 ;;
    --keep)    KEEP=1; shift ;;
    -h|--help)
      # ⚠ ITS OWN TEXT, NOT THE FILE HEADER. This was first a line range
      # (`sed -n '2,20p'`, which ended on `set -u` once the header grew) and
      # then the comment block - which kept the header's em-dashes, its 81-
      # column first line and its design notes in front of a person who asked
      # how to call it. The renderers' line grammar (see huginn-archive): the
      # (o> line, a blank line, rows at 2, details at 4, 7-bit, nothing past
      # column 79.
      cat <<'EOF'
(o> huginn - llm

  huginn-llm [--model <row-id>] [--timeout <s>] [--keep] "prompt"
    One question to a serving machine's local model; the answer on stdout.
    The default model is the first local row that is serving.
  echo "text" | huginn-llm -
    The prompt from stdin, e.g. to summarise a file.

  --model <row-id>   pin one machine's local-model row
  --timeout <s>      give up after this many seconds (default 120)
  --keep             keep the chat afterwards, for debugging a bad answer

  It rides the ordinary chat lane and removes the chat on success and on
  failure. Refusals are the daemon's own words; an offline tier is exit 1
  with the reason, never a hang.
EOF
      exit 0 ;;
    --*) echo "huginn-llm: unknown flag $1" >&2; exit 2 ;;
    *) PROMPT="${PROMPT:+$PROMPT }$1"; shift ;;
  esac
done
if [ "$PROMPT" = "-" ]; then PROMPT=$(cat); fi
[ -n "$PROMPT" ] || { echo "huginn-llm: no prompt (arg or '-' for stdin)" >&2; exit 2; }

py() { python3 -c "$1" 2>/dev/null; }

# ONE definition for every string from the daemon that reaches the terminal:
# the answer on stdout and the refusals on stderr. The answer is model text, and
# a model writes what it read - an ESC [ 2K or an OSC 52 in a log it was asked
# to summarise comes back out verbatim, and the terminal executes it. So C0 and
# C1 controls become spaces, the rule huginn-archive and its siblings apply.
# Unlike theirs, newline and tab survive: an answer is prose and code, not a
# one-line label. (scripts/test-llm-output.sh feeds it the sequences.)
CLEAN_PY='
CTRL = dict.fromkeys([c for c in list(range(0, 32)) + list(range(127, 160)) if c not in (9, 10)], 32)
def clean(v):
    return str(v).translate(CTRL)
'

# Default model: the first AVAILABLE local row — the same door a person's
# "+ Local" button opens. --model pins a specific machine's row.
if [ -z "$MODEL" ]; then
  MODEL=$(appd_curl -s -m 15 "$API/v1/models?local=1" | py "
import json,sys
for m in json.load(sys.stdin).get('models',[]):
    if m.get('family')=='local' and m.get('available'):
        print(m['id']); break")
  [ -n "$MODEL" ] || { echo "huginn-llm: no machine is serving local models right now" >&2; exit 1; }
fi

TITLE=$(printf '%s' "llm: $PROMPT" | tr '\n' ' ' | head -c 60)
CHAT=$(appd_curl -s -m 15 -X POST "$API/v1/chats" \
  -d "$(python3 -c "import json,sys; print(json.dumps({'model': sys.argv[1], 'title': sys.argv[2]}))" "$MODEL" "$TITLE")")
CID=$(printf '%s' "$CHAT" | py "import json,sys; print(json.load(sys.stdin).get('id',''))")
if [ -z "$CID" ]; then
  echo "huginn-llm: refused - $(printf '%s' "$CHAT" | py "$CLEAN_PY
import json,sys; print(clean(json.load(sys.stdin).get('error','?')))")" >&2
  exit 1
fi

SETTLED=""
cleanup() {
  # A run still active past our timeout is the real leak: the daemon refuses to
  # DELETE a chat while its run is active (409), so without cancelling first the
  # chat is orphaned AND the generate run keeps burning on the serving box. Only
  # needed when we never observed the run settle (a timeout or a mid-run error).
  [ -z "$SETTLED" ] && appd_curl -s -m 10 -X POST "$API/v1/chats/$CID/cancel" >/dev/null 2>&1
  [ -n "$KEEP" ] && return
  # Cancel is SIGTERM-then-SIGKILL and takes a moment to settle; retry the DELETE
  # while it still 409s so the chat is not left behind.
  for _ in 1 2 3 4 5; do
    code=$(appd_curl -s -m 10 -o /dev/null -w '%{http_code}' -X DELETE "$API/v1/chats/$CID")
    [ "$code" = 409 ] || break
    sleep 1
  done
}
trap cleanup EXIT

SENT=$(appd_curl -s -m 15 -X POST "$API/v1/chats/$CID/messages" \
  -d "$(python3 -c "import json,sys; print(json.dumps({'text': sys.stdin.read()}))" <<<"$PROMPT")")
printf '%s' "$SENT" | grep -q '"ok":true' || {
  echo "huginn-llm: send refused - $(printf '%s' "$SENT" | py "$CLEAN_PY
import json,sys; print(clean(json.load(sys.stdin).get('error','?')))")" >&2
  exit 1; }

DEADLINE=$(( $(date +%s) + TIMEOUT ))
while [ "$(date +%s)" -lt "$DEADLINE" ]; do
  sleep 2
  R=$(appd_curl -s -m 15 "$API/v1/chats/$CID")
  RUN=$(printf '%s' "$R" | py "import json,sys; print(json.load(sys.stdin).get('running'))")
  if [ "$RUN" = "False" ]; then
    SETTLED=1   # the run finished on its own; DELETE will not 409, no cancel needed
    ANSWER=$(printf '%s' "$R" | py "$CLEAN_PY
import json,sys
c = json.load(sys.stdin)
a = [m for m in c.get('messages',[]) if m.get('type')=='assistant']
print(clean((a[-1].get('text') or '') if a else ''))")
    if [ -n "$ANSWER" ]; then printf '%s\n' "$ANSWER"; exit 0; fi
    echo "huginn-llm: the run finished with no answer (see the chat with --keep)" >&2
    exit 1
  fi
done
echo "huginn-llm: no answer within ${TIMEOUT}s - the machine may be loading the model; retry or raise --timeout" >&2
exit 1
