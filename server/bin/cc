#!/bin/bash
# cc [session] [solo] — attach to (or create) a persistent, reattachable Claude Code tmux session.
#   default : attach/create; if other devices are attached, the view mirrors (smallest screen wins)
#   solo    : attach detaching ALL other clients -> resume as the sole client, full size
# Detach with Alt-d (or Ctrl-b d); reattach from any device. New sessions start `claude` for you.
# Working directory: $HUGINN_WORKDIR (default: $HOME)
# Default TERM when the SSH client didn't send one (Windows OpenSSH has no $TERM):
# without this, tmux aborts with "open terminal failed: not a terminal".
export TERM="${TERM:-xterm-256color}"
SESSION=main
SOLO=
for a in "$@"; do
  if [ "$a" = solo ]; then SOLO=1; else SESSION="$a"; fi
done
# Reject malformed names so a typo'd flag (e.g. 'huginn --hlp') can't spawn a junk
# session. Allowed: letters, digits, underscore - matches the client-side check.
if ! [[ "$SESSION" =~ ^[A-Za-z0-9_]+$ ]]; then
  echo "cc: invalid session name '$SESSION' (allowed: letters, digits, underscore)" >&2
  exit 2
fi
# Session names are case-insensitive: lowercase so 'Test' and 'test' map to ONE
# tmux session (tmux itself is case-sensitive). Backstop to the client-side canon.
SESSION="${SESSION,,}"
# '=' anchors an EXACT tmux target. tmux resolves -t by exact, then PREFIX, then
# glob, so a unique prefix silently resolves: `cc jt solo` would force-detach the
# real client of a session named 'jtyper'. `new-session -s` below is unaffected
# (it takes a creation name, not a target), so only the attach path needs this.
if [ -n "$SOLO" ] && tmux has-session -t "=$SESSION" 2>/dev/null; then
  exec tmux attach -d -t "=$SESSION"
fi
# Open in the project dir, but never let a missing/unreadable workdir become a hard
# failure: `tmux new-session -c` exits in well under a second if the directory is
# gone or on a stalled mount, and the client's reconnect loop would then churn
# forever showing only "link dropped" while the real error scrolls past.
WORKDIR="${HUGINN_WORKDIR:-$HOME}"
[ -d "$WORKDIR" ] || { echo "cc: $WORKDIR is not available - opening in $HOME instead" >&2; WORKDIR="$HOME"; }
# New sessions auto-launch Claude Code. With claude as the window's first program there
# is no idle bash prompt to misread the terminal's device-attributes replies (the tmux 3.6
# startup queries) as commands -> kills the "61: command not found" spam. Exit claude and
# you fall through to a normal login shell. (Attaching to an EXISTING session ignores this.)
exec tmux new-session -A -s "$SESSION" -c "$WORKDIR" 'claude; exec "$SHELL" -l'
