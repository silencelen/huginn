#!/bin/bash
# cc [session [solo]] — attach to (or create) a persistent, reattachable Claude Code tmux session.
#   default : attach/create; if other devices are attached, the view mirrors (smallest screen wins)
#   solo    : attach detaching ALL other clients -> resume as the sole client, full size
# Detach with Alt-d (or Ctrl-b d); reattach from any device. New sessions start `claude` for you.
# Working directory: $HUGINN_WORKDIR (default: $HOME)
# Default TERM when the SSH client didn't send one (Windows OpenSSH has no $TERM):
# without this, tmux aborts with "open terminal failed: not a terminal".
export TERM="${TERM:-xterm-256color}"
# -u on both tmux calls below: tmux draws every non-ASCII character as '_' for a client
# whose locale is not UTF-8, and an SSH login lands in the server's locale (LANG=C on a
# stock Debian container) unless the client sends its own, which Windows never does.
# Claude Code's screen is mostly box drawing and symbols.
# ⚠ THE NAME COMES FIRST; `solo` IS THE FLAG ONLY IN SECOND PLACE. `solo` is also
# a session name: the daemon creates one, the desktop's "Open in terminal" sends
# `huginn attach 'solo'`, and every client opens it as `cc solo` (`cc solo solo`
# to take it solo). Read as the flag wherever it stood, the word sent that attach
# to MAIN instead, with `attach -d`, which detaches every other device there, and
# a session called solo could not be opened at all.
# Every client since 2026-06-16 sends the name first (`cc main solo` for a bare
# `huginn solo`). `cc solo <name>` is the order the very first clients sent, and
# it still means <name>, solo: no caller puts anything else second.
SESSION=main
SOLO=
[ $# -ge 1 ] && SESSION="$1"
if [ "${2:-}" = solo ]; then SOLO=1
elif [ $# -ge 2 ] && [ "$1" = solo ]; then SESSION="$2"; SOLO=1
fi
# Session names are case-insensitive: lowercase so 'Test' and 'test' map to ONE
# tmux session (tmux itself is case-sensitive). Backstop to the client-side canon,
# and done BEFORE the check so the rule is written once, in one case.
SESSION="${SESSION,,}"
# Reject malformed names so a typo'd flag (e.g. 'huginn --hlp') can't spawn a junk
# session - a leading '-' is not a name. Allowed: lowercase letters, digits,
# underscore and '-', at most 50 characters - the SAME rule the daemon, the
# desktop and the phone enforce, and the same one huginn.sh/huginn.ps1 check.
#
# ⚠ '-' was refused here and accepted by the daemon, so `ssh huginn cc build-box`
# exited 2 for a session both GUI clients could open. '.' stays banned: tmux
# rewrites it to '_' and hands back a name nobody asked for.
if ! [[ "$SESSION" =~ ^[a-z0-9_][a-z0-9_-]{0,49}$ ]]; then
  echo "cc: invalid session name '$SESSION' (allowed: lowercase letters, digits, underscore and -; max 50)" >&2
  exit 2
fi
# '=' anchors an EXACT tmux target. tmux resolves -t by exact, then PREFIX, then
# glob, so a unique prefix silently resolves: `cc api solo` would force-detach the
# real client of a session named 'api-refactor'. `new-session -s` below is unaffected
# (it takes a creation name, not a target), so only the attach path needs this.
if [ -n "$SOLO" ] && tmux has-session -t "=$SESSION" 2>/dev/null; then
  exec tmux -u attach -d -t "=$SESSION"
fi
# Open in the project dir, but never let a missing/unreadable workdir become a hard
# failure: `tmux new-session -c` exits in well under a second if the directory is
# gone or on a stalled mount, and the client's reconnect loop would then churn
# forever showing only "link dropped" while the real error scrolls past.
WORKDIR="${HUGINN_WORKDIR:-$HOME}"
[ -d "$WORKDIR" ] || { echo "cc: $WORKDIR is not available - opening in $HOME instead" >&2; WORKDIR="$HOME"; }
# New sessions auto-launch Claude Code. With claude as the window's first program there
# is no idle bash prompt to misread the terminal's device-attributes replies (the tmux 3.6
# startup queries) as commands -> kills the "61: command not found" spam. Exit claude and
# you fall through to a normal login shell. (Attaching to an EXISTING session ignores this.)
exec tmux -u new-session -A -s "$SESSION" -c "$WORKDIR" 'claude; exec "$SHELL" -l'
