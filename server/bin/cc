#!/bin/bash
# cc [session] [solo] — attach to (or create) a persistent, reattachable Claude Code tmux session.
#   default : attach/create; if other devices are attached, the view mirrors (smallest screen wins)
#   solo    : attach detaching ALL other clients -> resume as the sole client, full size
# Detach with Alt-d (or Ctrl-b d); reattach from any device. Run `claude` inside.
# Working directory: $HUGINN_WORKDIR (default: $HOME)
# Default TERM when the SSH client didn't send one (Windows OpenSSH has no $TERM):
# without this, tmux aborts with "open terminal failed: not a terminal".
export TERM="${TERM:-xterm-256color}"
WORKDIR="${HUGINN_WORKDIR:-$HOME}"
SESSION=main
SOLO=
for a in "$@"; do
  if [ "$a" = solo ]; then SOLO=1; else SESSION="$a"; fi
done
# Reject malformed names so a typo'd flag (e.g. 'huginn --hlp') can't spawn a junk
# session. Allowed: letters, digits, underscore - matches the client-side check.
if ! [[ "$SESSION" =~ ^[A-Za-z0-9_]+$ ]]; then
  echo "cc: invalid session name '$SESSION' (allowed: letters, digits, underscore)" >&2
  exit 2
fi
if [ -n "$SOLO" ] && tmux has-session -t "$SESSION" 2>/dev/null; then
  exec tmux attach -d -t "$SESSION"
fi
exec tmux new-session -A -s "$SESSION" -c "$WORKDIR"
