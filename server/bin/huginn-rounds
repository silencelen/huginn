#!/usr/bin/env bash
# huginn-rounds — what this host does on a schedule, as text.
#
# HOST-SIDE ON PURPOSE, like huginn-status beside it. Both CLI clients (bash and
# PowerShell) just run this over ssh, so the rendering exists ONCE. A client that
# formatted the JSON itself would be a second implementation to keep in step, and
# the two would drift the first time a field was added — which is exactly what
# already happened to the two clients' version constants.
#
# It also means the token never leaves this machine: the clients reach appd by
# ssh'ing here and reading /etc/huginn-appd/token locally, and this keeps that
# property rather than teaching a laptop a new credential.
set -u

# --help, before the token check, exit 0 - the one convention the renderers
# share; see huginn-archive.
case "${1:-}" in
  -h|--help)
    # The line grammar: see huginn-archive.
    cat <<'EOF'
(o> huginn - rounds

  huginn-rounds
    What this host does on a schedule, when each last ran, and what it
    found.
EOF
    exit 0 ;;
  '') ;;
  *) echo "usage: huginn-rounds" >&2; exit 1 ;;
esac

# The state table: marks and words come from server/lib/state-table.json, through
# its generated bash reader, so a mark means the same thing here as in every other
# renderer. Beside this file in the tree; /usr/local/lib/huginn on a host
# (server/setup.sh installs it). Exported, so the python below reads os.environ.
_lib="$(dirname "$(readlink -f "$0")")/../lib"
[ -r "$_lib/state-table.sh" ] || _lib=/usr/local/lib/huginn
# shellcheck source=../lib/state-table.sh
. "$_lib/state-table.sh" 2>/dev/null \
  || { echo "huginn-rounds: missing $_lib/state-table.sh - re-run server/setup.sh" >&2; exit 1; }

TOKEN_FILE=/etc/huginn-appd/token
[ -s "$TOKEN_FILE" ] || { echo "huginn-rounds: no appd token at $TOKEN_FILE" >&2; exit 1; }
TOKEN="$(cat "$TOKEN_FILE")"

# ⚠ THE DAEMON PROVES ITSELF BEFORE THE TOKEN LEAVES. 8787 is not a privileged
# port: while huginn-appd is stopped or restarting, any account on this host can
# bind 127.0.0.1:8787, and a plain-HTTP call handed it the root-equivalent token.
# So the call is HTTPS, pinned to the public key in appd's own certificate, which
# only root can read. curl checks the pin during the handshake, before a byte of
# the request is sent, and -k (which only skips the CA check a self-signed
# certificate cannot pass) does not switch it off. No readable certificate, no
# call: there is no plain-HTTP fallback. The certificate is where appd keeps it
# (server/appd/lib/tls.js): HUGINN_APPD_TLS_CERT, else
# <HUGINN_APPD_DATA>/tls/cert.pem, each from this environment and then from the
# unit (site.conf can set them), in the order server/appd/install.sh reads them.
appd_pin() {
  local unit cert="${HUGINN_APPD_TLS_CERT:-}" data="${HUGINN_APPD_DATA:-}" key
  if [ -z "$cert" ]; then
    unit="$(systemctl show huginn-appd -p Environment --value 2>/dev/null | tr ' ' '\n')"
    cert="$(sed -n 's/^HUGINN_APPD_TLS_CERT=//p' <<<"$unit" | tail -1)"
    [ -n "$data" ] || data="$(sed -n 's/^HUGINN_APPD_DATA=//p' <<<"$unit" | tail -1)"
    cert="${cert:-${data:-/var/lib/huginn-appd}/tls/cert.pem}"
  fi
  key="$(openssl x509 -in "$cert" -noout -pubkey 2>/dev/null)" || key=""
  if [ -z "$key" ]; then
    echo "huginn-rounds: cannot read huginn-appd's certificate $cert" >&2
    echo "               (the token goes only to a daemon that proves it holds that key)" >&2
    return 1
  fi
  printf 'sha256//%s' "$(openssl pkey -pubin -outform der <<<"$key" 2>/dev/null | openssl dgst -sha256 -binary | openssl base64 -A)"
}
PIN="$(appd_pin)" || exit 1
# ⚠ THE TOKEN NEVER GOES ON A COMMAND LINE. /proc/<pid>/cmdline is readable by
# every account on this host and the token is root-equivalent, so an
# `-H "Authorization: Bearer ..."` argument handed it to anyone who looked while
# curl ran. The header reaches curl through a file descriptor instead (-H @file,
# curl 7.55+), and printf is a bash builtin, so no process carries the token in
# its arguments. scripts/test-no-token-argv.sh holds every script to this.
appd_curl() { curl -k --pinnedpubkey "$PIN" -H @<(printf 'Authorization: Bearer %s\n' "$TOKEN") "$@"; }

BODY="$(appd_curl -sf -m 10 \
  https://127.0.0.1:8787/v1/rounds 2>/dev/null)" || {
  # 90 is curl's "the key is not the pinned one": something else holds the port.
  if [ "$?" = 90 ]; then
    echo "huginn-rounds: whatever holds 127.0.0.1:8787 is not huginn-appd (wrong key); the token was not sent" >&2
  else
    echo "huginn-rounds: huginn-appd is not answering on 127.0.0.1:8787" >&2
  fi
  echo "               (systemctl status huginn-appd)" >&2
  exit 1
}

# JSON on stdin, from a builtin printf, never on argv: every account here can read
# /proc/<pid>/cmdline, and a round's report is not theirs. The pipe is python's
# own stdin, so a caller feeding THIS script from a pipe is not competing with it.
printf '%s' "$BODY" | python3 -c '
import json, os, sys, time

E = os.environ
d = json.load(sys.stdin)
rounds = d.get("rounds", [])
# The one line grammar (BRAND.md section 3): the one-row raven and the surface.
print("(o> huginn - rounds")
if not rounds:
    print()
    print("  No rounds yet. A round is work this host does on a schedule and")
    print("  reports back on -- create one from the phone or desktop client.")
    print()
    sys.exit(0)

# The same vocabulary the apps use, so a round does not mean one thing on a
# screen and another in a terminal. The marks are the state table: + all clear,
# > worth a look (info), ! needs you, and an unreadable report is info too -- it
# is something to read, not something that failed. "needs you" is the one that
# stands out, by its mark and its place first in the line, not by capitals.
WORD = {"ok": "all clear", "attention": "worth a look",
        "action": E["HUGINN_WORD_NEEDS_YOU"], "unknown": "unclear"}
MARK = {"ok": E["HUGINN_MARK_OK"], "attention": E["HUGINN_MARK_INFO"],
        "action": E["HUGINN_MARK_NEEDS_YOU"], "unknown": E["HUGINN_MARK_INFO"]}

# ONE definition, used on every string that reaches the screen.
#
# A terminal executes some of what it is handed. Report text is written by a
# model, and a model writes what it read -- a log line, a fetched page -- so a
# round title of "Nightly scan" followed by ESC [ 2K CR "ALL CLEAR" erased its own
# line and reprinted, and this listing showed ALL CLEAR for a round holding a DISK
# FULL headline and two action items. A newline in a short label split one finding
# into two rows just as well.
#
# The daemon now strips these at store time too. Both, deliberately: an older
# daemon and a hand-edited store are each real, and the renderer is the last place
# that can still be sure.
CTRL = dict.fromkeys(list(range(0, 32)) + list(range(127, 160)), 32)

def clean(v, n=0):
    if not isinstance(v, str):
        return ""
    out = " ".join(v.translate(CTRL).split())
    return out[:n] if n else out

def ago(sec):
    if not sec:
        return ""
    d = time.time() - sec
    if d < 60:   return "just now"
    if d < 3600: return "%dm ago" % (d // 60)
    if d < 86400:return "%dh ago" % (d // 3600)
    return "%dd ago" % (d // 86400)

def until(ms):
    if not ms:
        return "not scheduled"
    d = ms / 1000.0 - time.time()
    if d <= 0:    return "due now"
    if d < 3600:  return "in %dm" % (d // 60)
    if d < 86400: return "in %dh" % (d // 3600)
    if d < 172800: return "tomorrow"
    return "in %d days" % (d // 86400)

print()
for r in rounds:
    last = r.get("lastRun") or {}
    st = last.get("status")
    # A report that has been read and dealt with goes quiet. The status itself is
    # not rewritten -- it was true when it was written and still is; what changes
    # is that somebody has answered it. Recorded on the RUN, so the next fire
    # arrives un-acknowledged with no code to remember.
    ack = last.get("acknowledgedAt")
    acked = isinstance(ack, (int, float)) and ack > 0
    # Read and dealt with is ok; never run yet is waiting; running wins over both.
    if r.get("running"):
        mark = E["HUGINN_MARK_RUNNING"]
    elif not last:
        mark = E["HUGINN_MARK_WAITING"]
    else:
        mark = E["HUGINN_MARK_OK"] if acked else MARK.get(st, E["HUGINN_MARK_INFO"])
    # Running first. A round that is executing at this moment is executing
    # whatever its enabled flag says -- and disabling one mid-run is exactly how
    # you get here, so the state most worth seeing was the one being hidden.
    if r.get("running"):
        state = E["HUGINN_WORD_RUNNING"]
    elif not r.get("enabled"):
        state = "paused"
    else:
        state = until(r.get("nextRunAt"))

    print("  %s %s" % (mark, clean(r.get("title")) or "?"))
    where = clean(r.get("hostName")) or "this host"
    # Same trap as huginn-devices: a present-but-null key defeats the default
    # argument of .get. NOTE: no apostrophes anywhere in this block — the whole
    # program is inside a single-quoted python3 -c, so one closes it and the
    # shell starts parsing python. Extracting this block to test it CANNOT
    # catch that; only running the real script can.
    print("    %s  .  %s  .  %s  .  on %s"
          % (clean(r.get("cadence")) or "?", state, clean(r.get("mode")) or "ask", where))

    if last:
        bits = ["read" if acked else (WORD.get(st) or st or "unclear"), ago(last.get("at"))]
        shown = len(last.get("items") or [])
        # The daemon keeps 20 and records how many there really were. Printing
        # the kept count as the authoritative one put "20 items" directly under
        # a headline saying 500, and the number an operator acts on was the
        # wrong one of the two on the same screen.
        total = last.get("itemsTotal")
        if not isinstance(total, int) or total < shown:
            total = shown
        if total:
            if total > shown:
                bits.append("%d items, showing %d" % (total, shown))
            else:
                bits.append("%d item%s" % (total, "" if total == 1 else "s"))
        # An unmet goal is the one fact a cheerful headline can hide, so it is
        # said here rather than left to the reader to infer.
        if last.get("goalMet") is False:
            bits.append("did not finish")
        elif last.get("goalMet") is True:
            bits.append("goal met")
        if last.get("malformed"):
            bits.append("no report block")
        print("    %s" % "  .  ".join(b for b in bits if b))
        head = clean(last.get("headline"), 100)
        if head:
            print("    %s" % head)
        for it in (last.get("items") or [])[:5]:
            print("      - %s" % clean(it.get("title"), 88))
            sug = clean(it.get("suggest"), 86)
            if sug:
                print("        -> %s" % sug)
    else:
        print("    not run yet")
    print()

n = len(rounds)
print("  %d round%s" % (n, "" if n == 1 else "s"))
print()
'
