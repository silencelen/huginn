#!/bin/bash
# huginn-claude-title — reflect Claude Code's state in the terminal tab title.
#
# Driven by Claude Code hooks (see server/claude-hooks.json). Each hook invokes this
# with the event name as $1 and the event JSON on stdin. It maps the event to a state
# and pushes "<icon> <session>" to the terminal tab:
#
#     working    - Claude is working (a prompt is being processed / a tool is running)
#     needs you  - stopped for a permission or input request
#     waiting    - turn finished (or just launched), waiting for your next prompt
#
# The glyph for each is the state table's (server/lib/state-table.json), read
# through its generated bash reader: the Unicode glyph on a UTF-8 locale, the
# 7-bit mark otherwise.
#
# Propagation: the session runs in tmux on the host, and the outer terminal swallows
# inner title escapes (set-titles off), so we wrap the OSC-2 title in tmux's passthrough
# DCS — tmux forwards it verbatim to every attached client. Requires `allow-passthrough on`
# (set in tmux.conf). Hooks run with NO controlling tty, so /dev/tty is unavailable; we
# resolve the pane's tty via tmux ($TMUX_PANE) and write there instead.
#
# Contract: stays SILENT on stdout (UserPromptSubmit would inject stdout into the prompt)
# and always exits 0 (a non-zero exit on UserPromptSubmit/Stop can block the turn). It
# no-ops outside tmux, so headless `claude -p` / cron runs are unaffected.
#
# Icons are overridable via env (HUGINN_ICON_RUN / _NEEDYOU / _IDLE); the defaults are the brand's state glyphs.

set -u

command -v tmux >/dev/null 2>&1 || exit 0

# ⚠ CLAUDE CODE 2.1.300 CAN HOST A SESSION IN A BACKGROUND PTY: the pane runs
# `claude`, which runs a transient `claude daemon`, which runs `claude
# bg-pty-host`, which runs claude.exe — and the bg-pty-host leaves TMUX and
# TMUX_PANE out of the environment it hands on. Every hook then exited on the
# check below, so appd kept that session's old state and old session id, and the
# desktop's Conversation tab froze on yesterday's transcript while Screen kept
# streaming (2026-10-16, after a compaction continued it in a
# fork). So take them from the nearest ancestor that has them — and only when
# that pane's own shell is one of OUR ancestors, so a daemon that served another
# pane can never put this session's state on the wrong one (fail closed).
_is_ancestor() {   # $1 = pid: is it one of this hook's ancestors?
  local pid="$PPID" hops=0
  while [ "${pid:-0}" -gt 1 ] && [ "$hops" -lt 24 ]; do
    [ "$pid" = "$1" ] && return 0
    pid="$(awk '/^PPid:/{print $2}' "/proc/$pid/status" 2>/dev/null)" || return 1
    hops=$((hops + 1))
  done
  return 1
}
_ancestor_tmux() {
  local pid="$PPID" hops=0 env t p panepid
  while [ "${pid:-0}" -gt 1 ] && [ "$hops" -lt 16 ]; do
    env="$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null)"
    t="$(printf '%s\n' "$env" | sed -n 's/^TMUX=//p' | head -1)"
    p="$(printf '%s\n' "$env" | sed -n 's/^TMUX_PANE=//p' | head -1)"
    if [ -n "$t" ] && [ -n "$p" ]; then
      panepid="$(TMUX="$t" tmux display-message -p -t "$p" '#{pane_pid}' 2>/dev/null)" || return 1
      [ -n "$panepid" ] && _is_ancestor "$panepid" || return 1
      TMUX="$t"; TMUX_PANE="$p"; export TMUX TMUX_PANE
      return 0
    fi
    pid="$(awk '/^PPid:/{print $2}' "/proc/$pid/status" 2>/dev/null)" || return 1
    hops=$((hops + 1))
  done
  return 1
}
# ⚠ A CLAUDE CODE BACKGROUND JOB HAS NO PANE TO FIND. A session sent to the
# background runs on under a bg-pty-host that no pane's shell is an ancestor of,
# so the walk above rightly finds nothing, and
# every hook exited here: the session's state file kept what it said the moment
# the session left its pane, the apps showed it working for days, and no question
# or finish of its could alert. Its session id still names it, in the state file
# written before it left (see _bg_session). A job's hooks are handed
# CLAUDE_JOB_DIR; its process also carries CLAUDE_CODE_SESSION_KIND=bg, which
# Claude Code does NOT hand on to hooks (2.1.30x), so either one marks a job.
# Anything else without a pane (a headless `claude -p`, a cron run) still exits
# here.
bg_job=; bg_job_id=
if [ -z "${TMUX:-}" ] || [ -z "${TMUX_PANE:-}" ]; then
  if ! _ancestor_tmux; then
    [ -n "${CLAUDE_JOB_DIR:-}" ] || [ "${CLAUDE_CODE_SESSION_KIND:-}" = bg ] || exit 0
    bg_job=1
    bg_job_id="${CLAUDE_JOB_DIR:-}"; bg_job_id="${bg_job_id%/}"; bg_job_id="${bg_job_id##*/}"
  fi
fi
# Interactive tmux session only — headless runs have no $TMUX/$TMUX_PANE.
[ -n "$bg_job" ] || { [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; } || exit 0

# --- nested claude guard -----------------------------------------------------
# A claude started by a Bash tool INSIDE a tmux Claude session (`claude -p` for a
# scan, a bake-off, `huginn -p`) inherits $TMUX/$TMUX_PANE, so below it would
# resolve the SAME session name as the claude that owns the pane and write ITS
# session_id/transcript into that session's state file — flipping the file between
# two conversations on every hook event. huginn-appd re-reads it per poll, so a
# client watching the session saw its history replaced by the child's and back,
# the agent chips swap between two sessions' sets, and a 404 for an agent listed
# a second earlier, which the clients took for "needs appd 3.0" (2026-10-04).
#
# The hook's OWN environment cannot tell the two apart: a top-level claude also
# hands its hooks CLAUDECODE=1 and CLAUDE_CODE_SESSION_ID=<its own id>. The claude
# PROCESS's environment can — a top-level claude was started by a shell and has no
# CLAUDECODE; a nested one inherited CLAUDECODE=1 from the parent's Bash tool. So
# walk up to the nearest claude ancestor and read /proc. No claude found within a
# few hops = not nested (fail OPEN, i.e. the behaviour before this guard existed).
# HUGINN_CLAUDE_TITLE_NESTED=0|1 forces the verdict, for tests.
_is_claude_proc() {   # $1 = pid
  local comm cmd
  comm="$(cat "/proc/$1/comm" 2>/dev/null)" || return 1
  [ "$comm" = claude ] && return 0
  # A claude run through node: argv[0] is node and argv[1] is its cli.js.
  cmd="$(tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null)"
  case "$cmd" in
    claude\ *|*/claude\ *|*claude-code/cli.js*|*/claude/cli.js*) return 0 ;;
    # The native binary (2.1.300) runs as .../claude-code/bin/claude.exe.
    claude.exe\ *|*/claude.exe\ *|*/claude.exe) return 0 ;;
  esac
  return 1
}
_nested_claude() {
  case "${HUGINN_CLAUDE_TITLE_NESTED:-}" in 1) return 0 ;; 0) return 1 ;; esac
  local pid="$PPID" hops=0
  while [ "${pid:-0}" -gt 1 ] && [ "$hops" -lt 8 ]; do
    if _is_claude_proc "$pid"; then
      tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -q '^CLAUDECODE=' && return 0
      return 1
    fi
    pid="$(awk '/^PPid:/{print $2}' "/proc/$pid/status" 2>/dev/null)" || return 1
    hops=$((hops + 1))
  done
  return 1
}
_nested_claude && exit 0

# The brand's state glyphs (assets/brand/BRAND.md section 4), from the state table
# through its generated reader: working, needs you, waiting, as the Unicode glyph
# on a UTF-8 locale and the 7-bit mark otherwise. Single-width so a tab title never
# reflows; no emoji, so every terminal font has them. Beside this file in the tree;
# /usr/local/lib/huginn on a host (server/setup.sh installs it).
#
# ⚠ A MISSING TABLE COSTS THE GLYPH, NEVER THE STATE FILE. The state file below is
# what huginn-appd reads every session's state from; the title is decoration. So
# a host without the table still writes the file and titles the tab with the bare
# session name, and the state word is taken from the EVENT, not from the glyph
# (two overrides set to the same glyph would otherwise make two states one).
_lib="$(dirname "$(readlink -f "$0")")/../lib"
[ -r "$_lib/state-table.sh" ] || _lib=/usr/local/lib/huginn
D_RUN=; D_NEEDYOU=; D_IDLE=
# shellcheck source=../lib/state-table.sh
if . "$_lib/state-table.sh" 2>/dev/null; then
  D_RUN="$(huginn_state_glyph RUNNING)"
  D_NEEDYOU="$(huginn_state_glyph NEEDS_YOU)"
  D_IDLE="$(huginn_state_glyph WAITING)"
fi
ICON_RUN="${HUGINN_ICON_RUN:-$D_RUN}"
ICON_NEEDYOU="${HUGINN_ICON_NEEDYOU:-$D_NEEDYOU}"
ICON_IDLE="${HUGINN_ICON_IDLE:-$D_IDLE}"

event="${1:-}"
payload="$(cat 2>/dev/null)"            # hook JSON on stdin (may be empty)
# Fall back to the JSON event name if no arg was passed.
if [ -z "$event" ] && [ -n "$payload" ] && command -v jq >/dev/null 2>&1; then
  event="$(printf '%s' "$payload" | jq -r '.hook_event_name // empty' 2>/dev/null)"
fi

icon=; st=
case "$event" in
  # PostToolUseFailure (the tool threw) and PermissionDenied (auto mode refused
  # it) end a tool call like PostToolUse does; the turn goes on.
  UserPromptSubmit|PreToolUse|PostToolUse|PostToolUseFailure|PermissionDenied|SubagentStop|PreCompact|PostCompact) icon="$ICON_RUN"; st=running ;;
  Stop|SessionStart)                                    icon="$ICON_IDLE"; st=idle ;;
  Notification)
    # permission/input request -> needs you; post-turn idle nudge -> waiting; else attention.
    ntype=
    if [ -n "$payload" ] && command -v jq >/dev/null 2>&1; then
      ntype="$(printf '%s' "$payload" | jq -r '.notification_type // empty' 2>/dev/null)"
    fi
    case "$ntype" in
      idle_prompt) icon="$ICON_IDLE"; st=idle ;;
      *)           icon="$ICON_NEEDYOU"; st=attention ;;
    esac ;;
  SessionEnd) icon=""; st= ;;           # Claude exited to the shell -> drop the indicator
  *) exit 0 ;;
esac

# The tmux session a background job belongs to: the ONE state file that names this
# job's Claude session id, or else the job itself (a file written from here carries
# `job`, and a later fork changes the session id but not the job). None, or more
# than one: not ours to choose, so nothing is written.
_bg_session() {
  local dir="${HUGINN_CLAUDE_STATE_DIR:-/run/huginn-claude-state}" sid job f found='' n=0
  command -v jq >/dev/null 2>&1 || return 1
  sid="$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null)"
  job="$bg_job_id"
  [ -n "$sid$job" ] || return 1
  for f in "$dir"/*; do
    [ -f "$f" ] || continue
    case "${f##*/}" in *.tmp) continue ;; esac
    if jq -e --arg sid "$sid" --arg job "$job" \
        'type == "object" and (($sid != "" and .sessionId == $sid) or ($job != "" and .job == $job))' \
        "$f" >/dev/null 2>&1; then
      found="${f##*/}"; n=$((n + 1))
    fi
  done
  [ "$n" -eq 1 ] || return 1
  printf '%s' "$found"
}
if [ -n "$bg_job" ]; then
  # No pane, so no tab title either: only the files below.
  tty=
  sess="$(_bg_session)" || exit 0
else
  # One tmux call for both the pane tty and the session name.
  info="$(tmux display-message -p -t "$TMUX_PANE" '#{pane_tty}|#{session_name}' 2>/dev/null)" || exit 0
  tty="${info%%|*}"
  sess="${info#*|}"
  [ -n "$sess" ] || sess="claude"
fi

# --- a compaction puts back the state it interrupted ------------------------
# An idle compaction ("Compacted while idle, before the prompt cache expired")
# fires PreCompact, SessionStart(compact) and PostCompact with no turn around
# them, and its trigger is `auto`, the same as a compaction mid-turn. The
# PostCompact `running` was therefore the last word and the session read as
# working until the next prompt. So PreCompact keeps the state it found in the
# marker below and PostCompact puts it back: mid-turn that state is `running` and
# nothing changes; idle, it is `idle`. A manual /compact only ever runs between
# turns. A marker older than appd's own five-minute limit is not trusted.
STATE_DIR="${HUGINN_CLAUDE_STATE_DIR:-/run/huginn-claude-state}"
COMPACT_DIR="$STATE_DIR/.compacting"
_fresh_marker() { [ -n "$(find "$COMPACT_DIR/$sess" -mmin -5 2>/dev/null)" ]; }
prior=
case "$event" in
  PreCompact)
    trig=
    if [ -n "$payload" ] && command -v jq >/dev/null 2>&1; then
      trig="$(printf '%s' "$payload" | jq -r '.trigger // empty' 2>/dev/null)"
    fi
    if [ "$trig" = manual ]; then
      prior=idle
    elif [ -r "$STATE_DIR/$sess" ]; then
      prior="$(jq -r '.state // empty' "$STATE_DIR/$sess" 2>/dev/null)" || prior=
      [ -n "$prior" ] || prior="$(head -c 32 "$STATE_DIR/$sess" 2>/dev/null | tr -d '[:space:]')"
      # A second PreCompact for the same compaction finds the first one's
      # `running`; the first one's finding stands.
      if [ "$prior" = running ] && [ -s "$COMPACT_DIR/$sess" ] && _fresh_marker; then
        prior="$(head -c 16 "$COMPACT_DIR/$sess" 2>/dev/null)"
      fi
    fi ;;
  PostCompact)
    if _fresh_marker; then
      case "$(head -c 16 "$COMPACT_DIR/$sess" 2>/dev/null)" in
        idle)      icon="$ICON_IDLE"; st=idle ;;
        attention) icon="$ICON_NEEDYOU"; st=attention ;;
      esac
    fi ;;
esac

# Record the same state for machine consumers (huginn-appd's sessions list —
# the Huginn Android app): one file per session in /run/huginn-claude-state/.
# Ephemeral by design (tmpfs, cleared on reboot); cleared on SessionEnd.
#
# The file is JSON when jq is available, carrying the hook's session_id and
# transcript_path. That mapping is what lets a reader render this session's
# conversation STRUCTURALLY (thinking, tool calls, subagents) from
# ~/.claude/projects/*.jsonl instead of scraping the pane — there is no other
# way to learn which transcript belongs to which tmux session. Without jq it
# degrades to the bare state word, which readers still accept.
if [ -n "$st" ]; then
  # Owner-only: the file names enumerate every live session and each body carries
  # that session's transcript path and cwd, i.e. the whole project layout. Under
  # the default umask that lands 0755/0644 — harmless while huginn is single-user,
  # a free handout to the first non-root account that exists. The umask covers the
  # files this run creates; the chmod fixes a directory an earlier run left 0755.
  umask 077
  mkdir -p "$STATE_DIR" 2>/dev/null && chmod 700 "$STATE_DIR" 2>/dev/null
  # ⚠ `ts` IS MILLISECONDS, and it used to be seconds. The daemon's send queue
  # compares this stamp against a queued message's `Date.now()`, so a whole-second
  # stamp could never release an entry queued in the SAME second — up to 999 ms of
  # a gate that can only ever hold, which (with the transcript gate blind at the
  # same moment) dropped an automated send ten minutes later. appd reads the unit
  # off the magnitude, so a file this hook wrote before the change still works.
  if [ -n "$payload" ] && command -v jq >/dev/null 2>&1; then
    # ⚠ A TEMP NAME OF THIS PROCESS'S OWN, AND NEVER A BARE WORD OVER THE RECORD.
    # One session's hooks run at once (a turn that starts four background agents
    # fires four), and with one shared temp name the first rename took the temp
    # from under the others; their fallback then wrote the bare state word over
    # the JSON. A background job finds its file ONLY by the JSON's sessionId or
    # job (_bg_session), so from then on every event of that session gave up and
    # the apps lost its conversation until the session ended. A write that fails
    # now leaves the record as it was, for the next event to write again; the
    # bare word is only ever the first record of a session whose payload jq
    # could not read. (`*.tmp`, as before: _bg_session and appd's sweep skip it.)
    tmpf="$STATE_DIR/$sess.$$.tmp"
    # `job` only from a background job: what finds its file again after a fork.
    if printf '%s' "$payload" | jq -c --arg st "$st" --arg job "$bg_job_id" \
      '{state:$st, sessionId:(.session_id // null), transcript:(.transcript_path // null), cwd:(.cwd // null), ts:(now*1000|floor)}
       + (if $job != "" then {job:$job} else {} end)' \
      > "$tmpf" 2>/dev/null; then
      mv -fT "$tmpf" "$STATE_DIR/$sess" 2>/dev/null || rm -f "$tmpf" 2>/dev/null
    else
      rm -f "$tmpf" 2>/dev/null
      [ -e "$STATE_DIR/$sess" ] || printf '%s\n' "$st" > "$STATE_DIR/$sess" 2>/dev/null
    fi
  else
    printf '%s\n' "$st" > "$STATE_DIR/$sess" 2>/dev/null
  fi
else
  rm -f "$STATE_DIR/$sess" "$STATE_DIR/$sess.tmp" 2>/dev/null
fi

# --- compaction marker ------------------------------------------------------
# PreCompact starts it, PostCompact/Stop/SessionEnd clear it. huginn-appd reads
# STATE_DIR/compacting/<sess> to show a "compacting…" indicator reliably (the
# pane spinner only shows it while a screen is actually being captured). appd
# reads presence only; the body is the state word PostCompact restores (above).
# ⚠ THE LEADING DOT IS LOAD-BEARING. These directories sit in the SAME namespace
# as the flat per-session state files written above, and a session may legitimately
# be called `ask`, `plan` or `compacting` — at which point one half or the other
# breaks silently at exit 0: either that session's state JSON is moved INTO the
# directory (no state word, no transcript mapping, no conversation tab, ever) or
# every sidecar write on the host dies on ENOTDIR and no session gets a prompt
# sidecar at all. A leading dot is outside appd's name rule, so the collision
# cannot happen. appd reads the dotted directories and still clears the old ones.
case "$event" in
  PreCompact)
    umask 077
    mkdir -p "$COMPACT_DIR" 2>/dev/null && chmod 700 "$COMPACT_DIR" 2>/dev/null
    printf '%s' "$prior" > "$COMPACT_DIR/$sess" 2>/dev/null ;;
  PostCompact|Stop|SessionEnd)
    rm -f "$COMPACT_DIR/$sess" 2>/dev/null ;;
esac

# --- prompt sidecars: exact AskUserQuestion / ExitPlanMode tool inputs -------
#
# huginn-appd FUSES these with its pane scrape. The pane only shows a label
# truncated to the window width — a wrapped option loses its tail, a previewed
# one gains the neighbouring column — so the buttons drawn from the pane alone
# can be wrong or absent, and the width-dependent text even changes the answer
# fingerprint. The hook has the exact `tool_input`; writing it here lets the
# daemon serve correct labels while still taking liveness + the selection caret
# from the pane.
#
# Subdirectories, not "<sess>.ask" suffixes: a session may legitimately be named
# "x.ask", and appd's fs.watch on STATE_DIR is non-recursive but every event that
# touches a sidecar also rewrites the flat state file above, so ticks still fire.
# Dot-prefixed subdirectories, so a session may also legitimately be named "ask".
#
# Written on the PreToolUse that RAISES the dialog (which fires just before it
# renders — appd waits for the pane to catch up). Cleared the moment it can no
# longer be on screen: the tool's own PostToolUse (answered / approved), a new
# UserPromptSubmit (the composer replaced it, e.g. after an Esc-interrupt — the
# reliable signal, since Stop does not always fire on interrupt), Stop (turn
# ended), and SessionEnd. Deliberately NOT cleared on a DIFFERENT tool's
# PreToolUse: a background agent's tool calls fire PreToolUse in this same
# session while a main-thread question waits, and clearing there would rip a live
# sidecar away. A missed clear only ever leaves a stale sidecar, which fusion
# neutralises by requiring a matching live pane run; it can never invent buttons.
#
# JSON only — without jq there is nothing to fuse and the pane path stands alone.
if command -v jq >/dev/null 2>&1; then
  ASK_DIR="$STATE_DIR/.ask"
  PLAN_DIR="$STATE_DIR/.plan"
  _write_sidecar() {   # $1 = dir, $2 = tool
    umask 077
    mkdir -p "$1" 2>/dev/null && chmod 700 "$1" 2>/dev/null
    # A temp of this process's own, as for the state file above: two writers
    # sharing one name could rename the other's half-written file into place.
    printf '%s' "$payload" | jq -c --arg tool "$2" \
      '{v:1, tool:$tool, sessionId:(.session_id // null), ts:now|floor, input:(.tool_input // null)}' \
      > "$1/$sess.$$.tmp" 2>/dev/null \
      && mv -fT "$1/$sess.$$.tmp" "$1/$sess" 2>/dev/null
    rm -f "$1/$sess.$$.tmp" 2>/dev/null
  }
  _clear_sidecars() {
    rm -f "$ASK_DIR/$sess" "$ASK_DIR/$sess.tmp" "$PLAN_DIR/$sess" "$PLAN_DIR/$sess.tmp" 2>/dev/null
  }
  case "$event" in
    PreToolUse)
      tool_name="$(printf '%s' "$payload" | jq -r '.tool_name // empty' 2>/dev/null)"
      case "$tool_name" in
        AskUserQuestion) _write_sidecar "$ASK_DIR" AskUserQuestion ;;
        ExitPlanMode)    _write_sidecar "$PLAN_DIR" ExitPlanMode ;;
      esac ;;
    PostToolUse|PostToolUseFailure|PermissionDenied)
      tool_name="$(printf '%s' "$payload" | jq -r '.tool_name // empty' 2>/dev/null)"
      case "$tool_name" in
        AskUserQuestion) rm -f "$ASK_DIR/$sess" "$ASK_DIR/$sess.tmp" 2>/dev/null ;;
        ExitPlanMode)    rm -f "$PLAN_DIR/$sess" "$PLAN_DIR/$sess.tmp" 2>/dev/null ;;
      esac ;;
    UserPromptSubmit|Stop|SessionEnd) _clear_sidecars ;;
  esac

  # --- parked permission requests: drop what can no longer be answered --------
  #
  # huginn-permission-hook parks EVERY tool prompt as $STATE_DIR/.perm/<sess>/<id>.json
  # and waits on it; the daemon's request registry (lib/questions.js) lists the
  # file as a live question for as long as it exists. Answering the dialog at the
  # keyboard does not stop that hook, so the file would otherwise claim a
  # question for the hook's whole deadline. This is the other half of the
  # registry's liveness: the tool's own PostToolUse (it ran), PostToolUseFailure
  # (it ran and threw) or PermissionDenied (auto mode refused it) drops the
  # OLDEST request for that tool with that exact input — one, because parallel
  # subagents can park identical requests and each event ends one of them. A new
  # prompt or a Stop ends the main thread's requests (a subagent's, which carry
  # `agentId`, can outlive the turn in the background); a SubagentStop ends that
  # agent's; SessionEnd takes the directory. The waiting hook notices its file is
  # gone and exits on its own. Nothing here is a decision: the dialog, if it is
  # still up, is answered exactly as before.
  PERM_DIR="$STATE_DIR/.perm/$sess"
  _drop_perm_tool() {   # $1 = tool, $2 = tool_input JSON ('' = any): the oldest match
    local f best='' best_ts=0 ts
    [ -d "$PERM_DIR" ] || return 0
    for f in "$PERM_DIR"/*.json; do
      [ -f "$f" ] || continue
      if [ -n "$2" ]; then
        jq -e --arg t "$1" --argjson inp "$2" '.tool == $t and .input == $inp' "$f" >/dev/null 2>&1 || continue
      else
        jq -e --arg t "$1" '.tool == $t' "$f" >/dev/null 2>&1 || continue
      fi
      ts="$(jq -r '.ts // 0' "$f" 2>/dev/null)"
      case "$ts" in ''|*[!0-9]*) ts=0 ;; esac
      if [ -z "$best" ] || [ "$ts" -lt "$best_ts" ]; then best="$f"; best_ts="$ts"; fi
    done
    [ -n "$best" ] && rm -f "$best" 2>/dev/null
    return 0
  }
  _drop_perm_agent() {  # $1 = agent id ('' = the main thread): every request of that agent
    local f
    [ -d "$PERM_DIR" ] || return 0
    for f in "$PERM_DIR"/*.json; do
      [ -f "$f" ] || continue
      jq -e --arg a "$1" '(.agentId // "") == $a' "$f" >/dev/null 2>&1 && rm -f "$f" 2>/dev/null
    done
    return 0
  }
  case "$event" in
    PostToolUse|PostToolUseFailure|PermissionDenied)
      tool_name="$(printf '%s' "$payload" | jq -r '.tool_name // empty' 2>/dev/null)"
      tool_input="$(printf '%s' "$payload" | jq -c '.tool_input // empty' 2>/dev/null)"
      [ -n "$tool_name" ] && _drop_perm_tool "$tool_name" "$tool_input" ;;
    UserPromptSubmit|Stop) _drop_perm_agent '' ;;
    SubagentStop)
      agent_id="$(printf '%s' "$payload" | jq -r '.agent_id // empty' 2>/dev/null)"
      [ -n "$agent_id" ] && _drop_perm_agent "$agent_id" ;;
    SessionEnd) rm -rf "$PERM_DIR" 2>/dev/null ;;
  esac
fi

[ -n "$tty" ] && [ -w "$tty" ] || exit 0

if [ -n "$icon" ]; then title="$icon $sess"; else title="$sess"; fi

# OSC-2 set-title wrapped in tmux passthrough (the ESC before the OSC is doubled).
printf '\033Ptmux;\033\033]2;%s\007\033\\' "$title" > "$tty" 2>/dev/null
exit 0
