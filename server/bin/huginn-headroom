#!/usr/bin/env python3
# huginn-headroom - how much room is left, and what huginn did about it.
#
# HOST-SIDE ON PURPOSE, like huginn-rounds and huginn-devices beside it. Both CLI
# clients (bash and PowerShell) just run this over ssh, so the rendering exists
# ONCE. A client that formatted the JSON itself would be a second implementation
# to keep in step, and the two would drift the first time a field was added --
# which is exactly what already happened to the two clients' version constants.
#
# It also means the token never leaves this machine: the clients reach appd by
# ssh'ing here and reading /etc/huginn-appd/token locally, and this keeps that
# property rather than teaching a laptop a new credential. The token is read into
# one header and is never echoed, not even on an error path -- a renderer that
# prints the request it failed to make is a renderer that prints the credential.
#
# WHY PURE PYTHON, when rounds/devices are bash wrappers around `python3 -c`:
# that program lives inside a single-quoted shell string, so one apostrophe in a
# comment ends the program (huginn-rounds carries a warning about exactly that).
# There is more to say here than in either of those, `--json` wants to pass a body
# through untouched, and this way `python3 -m py_compile server/bin/huginn-headroom`
# is a real gate instead of a check of the wrapper's quoting.
#
# Exit codes, because a client may branch on them:
#   0  rendered
#   1  no token or no certificate, or appd answered but cannot serve headroom
#      (too old / HTTP error)
#   2  appd is not answering at all, or what answered is not appd
import http.client
import json
import os
import re
import runpy
import ssl
import subprocess
import sys
import time
import urllib.parse


def _state_table():
    """The brand state table, through its generated python reader.

    server/lib/state-table.py beside this file in the tree; /usr/local/lib/huginn
    on a host (server/setup.sh installs it). One source for every renderer's
    marks and words: server/lib/state-table.json.
    """
    here = os.path.dirname(os.path.realpath(__file__))
    for d in (os.path.join(here, "..", "lib"), "/usr/local/lib/huginn"):
        f = os.path.join(d, "state-table.py")
        if os.path.isfile(f):
            return runpy.run_path(f)
    sys.stderr.write("huginn-headroom: missing state-table.py - re-run server/setup.sh\n")
    sys.exit(1)


ST = _state_table()

TOKEN_FILE = "/etc/huginn-appd/token"
# HTTPS only, and pinned like the default (below): an override is not a way
# around the proof.
BASE = os.environ.get("HUGINN_APPD_URL") or "https://127.0.0.1:8787"

# ONE definition, used on every string that reaches the screen. A terminal
# executes some of what it is handed, and several of these strings (an arbiter
# `why`, a sentinel reason, a session name) are written by a model or by a person
# naming a tmux session. huginn-rounds learned this the hard way: a title holding
# ESC [ 2K CR erased its own line and reprinted, and the listing showed the wrong
# status for a round with a DISK FULL headline.
CTRL = dict.fromkeys(list(range(0, 32)) + list(range(127, 160)), 32)


def clean(v, n=0):
    if not isinstance(v, str):
        return ""
    out = " ".join(v.translate(CTRL).split())
    return out[:n] if n else out


def die(msg, code, hint=None):
    sys.stderr.write("huginn-headroom: %s\n" % msg)
    if hint:
        sys.stderr.write("                 %s\n" % hint)
    sys.exit(code)


# ⚠ THE DAEMON PROVES ITSELF BEFORE THE TOKEN LEAVES. 8787 is not a privileged
# port: while huginn-appd is stopped or restarting, any account on this host can
# bind 127.0.0.1:8787, and a plain-HTTP call handed it the root-equivalent token.
# So the call is HTTPS, and the certificate that answers must be appd's own -
# the one in its certificate file, which only root can read - compared after the
# handshake and before a byte of the request is written. No readable certificate,
# no call: there is no plain-HTTP fallback.
def appd_cert():
    """Where appd keeps its certificate (server/appd/lib/tls.js).

    HUGINN_APPD_TLS_CERT, else <HUGINN_APPD_DATA>/tls/cert.pem, each from this
    environment and then from the unit (site.conf can set them), in the order
    server/appd/install.sh reads them.
    """
    cert = os.environ.get("HUGINN_APPD_TLS_CERT") or ""
    if cert:
        return cert
    try:
        out = subprocess.run(
            ["systemctl", "show", "huginn-appd", "-p", "Environment", "--value"],
            capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        out = ""
    unit = {}
    for word in out.split():
        k, _, v = word.partition("=")
        unit[k] = v
    data = os.environ.get("HUGINN_APPD_DATA") or unit.get("HUGINN_APPD_DATA") or "/var/lib/huginn-appd"
    return unit.get("HUGINN_APPD_TLS_CERT") or os.path.join(data, "tls", "cert.pem")


def appd_der(path):
    """The DER of the first certificate in `path` (the leaf appd serves), or None."""
    try:
        with open(path) as fh:
            m = re.search(r"-----BEGIN CERTIFICATE-----.+?-----END CERTIFICATE-----", fh.read(), re.S)
        return ssl.PEM_cert_to_DER_cert(m.group(0)) if m else None
    except (OSError, ValueError):
        return None


class NotTheDaemon(Exception):
    pass


class PinnedHTTPS(http.client.HTTPSConnection):
    """HTTPS to the one certificate given, whatever any CA would say about it.

    No CA can vouch for a self-signed certificate, so the check is the pin:
    connect() does the handshake, compares the certificate it was shown with
    appd's own, and refuses before request() writes anything.
    """

    def __init__(self, host, port, der, timeout):
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        super().__init__(host, port, timeout=timeout, context=ctx)
        self.der = der

    def connect(self):
        super().connect()
        if self.sock.getpeercert(binary_form=True) != self.der:
            self.sock.close()
            self.sock = None
            raise NotTheDaemon()


def fetch():
    try:
        with open(TOKEN_FILE) as fh:
            token = fh.read().strip()
    except OSError:
        token = ""
    if not token:
        die("no appd token at %s" % TOKEN_FILE, 1)

    try:
        url = urllib.parse.urlsplit(BASE)
        host, port = url.hostname, url.port or 443
    except ValueError:
        url = host = port = None
    if not url or url.scheme != "https" or not host:
        die("HUGINN_APPD_URL must be https:// - the token never travels in the clear", 1)
    cert = appd_cert()
    der = appd_der(cert)
    if der is None:
        die("cannot read huginn-appd's certificate %s" % cert, 1,
            "(the token goes only to a daemon that proves it holds that key)")

    conn = PinnedHTTPS(host, port, der, timeout=10)
    try:
        conn.request("GET", url.path.rstrip("/") + "/v1/headroom",
                     headers={"Authorization": "Bearer " + token, "Accept": "application/json"})
        r = conn.getresponse()
        status, body = r.status, r.read()
    except NotTheDaemon:
        die("whatever holds %s is not huginn-appd (wrong certificate); the token was not sent" % BASE, 2,
            "(systemctl status huginn-appd)")
    except Exception:
        # Deliberately not printing the exception: a request error can carry the
        # request it failed to make, and the header travels with it.
        die("huginn-appd is not answering on %s" % BASE, 2,
            "(systemctl status huginn-appd)")
    finally:
        conn.close()
    # 404 is the FEATURE PROBE, not a bug: every appd before 3.0.0 serves
    # /v1/status and /v1/rounds happily and has never heard of this route. Say
    # which version is missing rather than "not found", because the person
    # reading it is the person who can deploy the daemon.
    if status == 404:
        die("headroom needs appd 3.0.0 or newer", 1,
            "(this host is running an older huginn-appd - deploy the daemon)")
    if status in (401, 403):
        die("appd refused the host token (HTTP %d)" % status, 1,
            "(check %s against the running daemon)" % TOKEN_FILE)
    if not 200 <= status < 300:
        die("appd answered HTTP %d for /v1/headroom" % status, 1)
    return body.decode("utf-8", "replace")


def ago(ms):
    """Epoch MILLISECONDS -> how long ago.

    ⚠ MILLISECONDS. Every timestamp on /v1/headroom is ms (lib/headroom's
    banner): serverTime, the sentinels' since, held[].since, resets[].seenAt,
    arbiter.lastSwitchAt / lastLadderAt / lastResumeAt / lastAction.at,
    sessions[].ladder.at and headsUpAt, accounts[].readAt. This read them as
    seconds, so `arbiter` printed "just now" for ever -- a time that never ages
    reads as a daemon that never acts.

    A value that is plainly seconds (anything below the year-2001 line) is still
    accepted, so this renderer keeps working against an older daemon rather than
    printing 1970.
    """
    if not isinstance(ms, (int, float)) or ms <= 0:
        return ""
    if ms < 1e11:
        ms = ms * 1000
    d = time.time() - ms / 1000.0
    if d < 0:
        return "just now"
    if d < 60:
        return "just now"
    if d < 3600:
        return "%dm ago" % (d // 60)
    if d < 86400:
        return "%dh ago" % (d // 3600)
    return "%dd ago" % (d // 86400)


def local_at(iso):
    """An ISO reset time -> a LOCAL clock time a person can compare to a watch.

    The endpoint speaks UTC with a trailing Z; the reader is sitting in front of
    a terminal in some other timezone, and "resets 2026-09-15T10:30:00Z" is a
    string nobody can act on. `fromisoformat` only learned to read Z in 3.11, so
    the Z is rewritten first -- this file also runs on whatever python a freshly
    set-up host has.
    """
    if not isinstance(iso, str) or not iso:
        return "unknown"
    txt = iso.strip()
    if txt.endswith("Z"):
        txt = txt[:-1] + "+00:00"
    try:
        import datetime
        dt = datetime.datetime.fromisoformat(txt)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=datetime.timezone.utc)
        loc = dt.astimezone()
        # `loc.tzinfo` is a FIXED offset, taken at the RESET instant -- rendering
        # `now` through it lands on a different calendar date than the host is on
        # whenever a DST transition sits between the two, so "resets today" read
        # "tomorrow" (and the reverse) for the ~14 hours a year either side of a
        # change. The local zone is the HOST's, always: ask the clock, not the
        # reset. The printed HH:MM was never wrong; the word in front of it was.
        now = datetime.datetime.now().astimezone()
        clock = loc.strftime("%H:%M")
        days = (loc.date() - now.date()).days
        if days == 0:
            return "today %s" % clock
        if days == 1:
            return "tomorrow %s" % clock
        if 0 < days < 7:
            return "%s %s" % (loc.strftime("%a"), clock)
        return loc.strftime("%Y-%m-%d %H:%M")
    except Exception:
        return clean(iso, 40)


# The same vocabulary the apps use, so a mode does not mean one thing on a screen
# and another in a terminal.
MODE_WORD = {"ok": "ok", "warn": "warn", "red": "red", "exhausted": "exhausted"}
WINDOW_WORD = {"session": "session", "weekly_all": "this week",
               "weekly_fable": "this week (Fable)"}


def pct_of(w):
    p = (w or {}).get("percent")
    return p if isinstance(p, (int, float)) else None


def window_line(key, w):
    """`this week (Fable)  .  92%  .  resets today 17:00`"""
    p = pct_of(w)
    label = clean(w.get("label")) or WINDOW_WORD.get(key, key)
    bits = [label, "%d%%" % round(p) if p is not None else "?%"]
    # `exceeded` is the endpoint saying the cap is already hit. 100% and
    # "exceeded" are not the same sentence and the second one is the one that
    # stops work, so it is said out loud rather than left to the percentage.
    if (w.get("severity") or "") == "exceeded":
        bits.append("exceeded")
    bits.append("resets " + local_at(w.get("resetsAt")))
    return "  .  ".join(bits)


def fullest(windows):
    """The one window that decides what this account can still do.

    Whichever is fullest: an account at 12% session and 92% Fable-week is a 92%
    account, and showing the first number first is how a limit arrives as a
    surprise.
    """
    best_k, best_w, best_p = None, None, -1
    for k, w in (windows or {}).items():
        if not isinstance(w, dict):
            continue
        p = pct_of(w)
        p = -1 if p is None else p
        if p > best_p:
            best_k, best_w, best_p = k, w, p
    return best_k, best_w


def render(d):
    out = []
    p = out.append
    # The one line grammar (BRAND.md section 3): the one-row raven and the surface.
    p("(o> huginn - headroom")
    p("")

    mode = clean(d.get("mode")) or "unknown"
    worst = d.get("worst") or {}
    head = "  Headroom: %s" % MODE_WORD.get(mode, mode.lower())
    wp = pct_of(worst)
    if worst and wp is not None:
        head += "   (%s at %d%%, %s)" % (
            clean(worst.get("label")) or WINDOW_WORD.get(worst.get("window"), "?"),
            round(wp), "resets " + local_at(worst.get("resetsAt")))
    p(head)
    p("")

    accounts = d.get("accounts") or {}
    if not accounts:
        p("  No usage read yet. huginn reads the plan endpoint once a minute while")
        p("  anything is running, and every half hour for saved logins.")
        p("")
    for slug, a in accounts.items():
        if not isinstance(a, dict):
            continue
        who = clean(a.get("email")) or clean(slug) or "?"
        # ⚠ LIVE vs SAVED, said on the row. A saved login's numbers can be hours
        # old and `agedLimits` zeroes a window whose reset has passed, so a cold
        # row reading 0% is a guess, not a reading -- and an operator who cannot
        # tell the two apart will switch to an account that is actually full.
        p("  %s %s" % (ST["MARK"]["running"] if a.get("live") else " ", who))
        windows = a.get("windows") or {}
        fk, fw = fullest(windows)
        if fk:
            p("    %s" % window_line(fk, fw))
        rest = ["%s %s" % (clean(w.get("label")) or WINDOW_WORD.get(k, k),
                           "%d%%" % round(pct_of(w)) if pct_of(w) is not None else "?%")
                for k, w in windows.items() if k != fk and isinstance(w, dict)]
        if rest:
            p("    %s" % "  .  ".join(rest))
        state = "live" if a.get("live") else "saved login, not active"
        when = ago(a.get("readAt"))
        p("    %s" % "  .  ".join(b for b in [state, ("read " + when) if when else ""] if b))
        p("")

    # Sessions huginn itself moved. Only these: a session a person moved by hand
    # is not the daemon's to report on, and the daemon never ladders it back.
    laddered = [s for s in (d.get("sessions") or [])
                if isinstance(s, dict) and isinstance(s.get("ladder"), dict) and s["ladder"].get("to")]
    stalled = [s for s in (d.get("sessions") or []) if isinstance(s, dict) and s.get("stalled")]
    if laddered:
        p("  Moved by huginn")
        for s in laddered:
            L = s["ladder"]
            note = [clean(L.get("delivery")) or "pending"]
            when = ago(L.get("at"))
            if when:
                note.append(when)
            p("    %s: %s -> %s  (%s)" % (
                clean(s.get("name"), 40) or "?", clean(L.get("from")) or "?",
                clean(L.get("to")) or "?", ", ".join(note)))
        p("")
    if stalled:
        p("  Waiting on a reset")
        for s in stalled:
            bits = [clean(s.get("name"), 40) or "?"]
            bits.append("auto-resume on" if s.get("autoResume") else "auto-resume off")
            p("    %s" % "  .  ".join(bits))
        p("")

    # Held spawns: the hook gate DELAYS agents while a sentinel is armed. Count
    # first, because the count is the thing that is unusual; the types say what
    # kind of work is queued behind it.
    held = [h for h in (d.get("held") or []) if isinstance(h, dict)]
    if held:
        kinds = {}
        for h in held:
            k = clean(h.get("agentType")) or "agent"
            kinds[k] = kinds.get(k, 0) + 1
        types = ", ".join("%s%s" % (k, " x%d" % n if n > 1 else "")
                          for k, n in sorted(kinds.items()))
        p("  Holding %d new agent%s: %s" % (len(held), "" if len(held) == 1 else "s", types))
        oldest = min((h.get("since") or 0) for h in held)
        when = ago(oldest)
        if when:
            p("    oldest held %s" % when)
        p("")

    sentinels = d.get("sentinels") or {}
    armed = [(k, v) for k, v in sentinels.items() if isinstance(v, dict)]
    if armed:
        p("  Sentinels")
        for k, v in armed:
            bits = [clean(k) or "?"]
            when = ago(v.get("since"))
            if when:
                bits.append("armed " + when)
            why = clean(v.get("reason"), 80)
            if why:
                bits.append(why)
            p("    %s" % "  .  ".join(bits))
        p("")
    elif sentinels:
        p("  Sentinels: none armed - new agents start normally")
        p("")

    arb = d.get("arbiter") or {}
    last = arb.get("lastAction")
    if isinstance(last, dict):
        # ⚠ THE DAEMON'S OWN FIELD NAMES: {type, at, name, to}. This read
        # `kind`/`action` and `session`, which the daemon has never emitted, so
        # every run printed a bare "Arbiter: acted" with no target. `kind` and
        # `action` are still accepted so an older daemon still renders.
        verb = (clean(last.get("type")) or clean(last.get("kind"))
                or clean(last.get("action")) or "acted")
        bits = [verb.replace("_", " ")]
        tgt = clean(last.get("name")) or clean(last.get("session")) or clean(last.get("slug"))
        if tgt:
            bits.append("on " + tgt)
        to = clean(last.get("to"))
        if to:
            bits.append("-> " + to)
        when = ago(last.get("at") or arb.get("lastLadderAt") or arb.get("lastSwitchAt"))
        if when:
            bits.append(when)
        p("  Arbiter: %s" % "  .  ".join(bits))
    else:
        p("  Arbiter: nothing done yet")
    # `why` is the whole point of the verb: the interesting question is almost
    # never "what did it do" but "why did it do NOTHING while I sat at 94%".
    why = clean(arb.get("why"), 240)
    if why:
        p("    why: %s" % why)
    p("")

    s = d.get("settings") or {}
    if s:
        bits = []
        if isinstance(s.get("headsUpPct"), (int, float)):
            bits.append("heads-up %d%%" % s["headsUpPct"])
        if isinstance(s.get("ladderPct"), (int, float)):
            bits.append("step down %d%%" % s["ladderPct"])
        if isinstance(s.get("stopPct"), (int, float)) and isinstance(s.get("stopFablePct"), (int, float)):
            bits.append("hold agents %d%% session / %d%% Fable week" % (s["stopPct"], s["stopFablePct"]))
        ladder = [clean(x) for x in (s.get("ladder") or []) if clean(x)]
        if ladder:
            bits.append("ladder " + " -> ".join(ladder))
        bits.append("auto-resume " + ("on" if s.get("autoResume") else "off"))
        if not s.get("autoResume"):
            # An OFF switch explains a stalled session that nothing picked up, and
            # that is the support question this line exists to answer in advance.
            bits.append("(a stalled session waits for you)")
        sw = s.get("accountSwitch") or {}
        if isinstance(sw, dict):
            bits.append("account switch " + ("on at %d%%" % sw["threshold"]
                                             if sw.get("enabled") and isinstance(sw.get("threshold"), (int, float))
                                             else "off"))
        p("  Settings: %s" % "  .  ".join(bits))
        p("")

    # The count footer every renderer ends on.
    n = sum(1 for a in accounts.values() if isinstance(a, dict))
    p("  %d account%s" % (n, "" if n == 1 else "s"))
    p("")
    return "\n".join(out)


# The renderers' line grammar (see huginn-archive): the (o> line, a blank
# line, rows at 2, details at 4, nothing past column 79.
USAGE = """(o> huginn - headroom

  huginn-headroom
    Usage left per account, what huginn moved or is holding, and why.
  huginn-headroom --json
    What the daemon said, unparsed, instead of rendering it.
"""


def main():
    args = sys.argv[1:]
    # --help is a QUESTION, NOT AN ERROR, and it used to be both: `--help`
    # printed "usage: huginn-headroom [--json]" on stderr and exited 1, which is
    # how a person asking for help learns they have made a second mistake. One
    # convention across the renderers: stdout, exit 0.
    if "-h" in args or "--help" in args:
        sys.stdout.write(USAGE)
        return
    want_json = "--json" in args
    for a in args:
        if a not in ("--json",):
            sys.stderr.write(USAGE)
            sys.exit(1)

    body = fetch()
    if want_json:
        # Straight through, unparsed on purpose: a client or a script asking for
        # --json wants what the daemon said, including fields this renderer is
        # too old to know about.
        sys.stdout.write(body if body.endswith("\n") else body + "\n")
        return
    try:
        d = json.loads(body)
    except ValueError:
        die("appd answered something that is not JSON", 1)
    print(render(d))


if __name__ == "__main__":
    main()
