#!/usr/bin/env bash
# huginn-devices — the machines that have offered themselves to huginn.
#
# Host-side for the same reasons as huginn-rounds beside it: one renderer, both
# clients thin, and the bearer token never leaves this machine.
set -u

TOKEN_FILE=/etc/huginn-appd/token
[ -s "$TOKEN_FILE" ] || { echo "huginn-devices: no appd token at $TOKEN_FILE" >&2; exit 1; }

BODY="$(curl -sf -m 10 -H "Authorization: Bearer $(cat "$TOKEN_FILE")" \
  http://127.0.0.1:8787/v1/devices 2>/dev/null)" || {
  echo "huginn-devices: huginn-appd is not answering on 127.0.0.1:8787" >&2
  echo "                (systemctl status huginn-appd)" >&2
  exit 1
}

python3 -c '
import json, sys, time

d = json.loads(sys.argv[1])
devs = d.get("devices", [])
if not devs:
    print()
    print("  No devices enrolled.")
    print()
    print("  A device is another machine that can run a chat in ITS context.")
    print("  Turn on \"Give Huginn access to this PC\" in the desktop client on")
    print("  the machine you want to offer, and it appears here.")
    print()
    sys.exit(0)

def ago(ms):
    if not ms:
        return "never"
    s = time.time() - ms / 1000.0
    if s < 60:    return "%ds ago" % s
    if s < 3600:  return "%dm ago" % (s // 60)
    if s < 86400: return "%dh ago" % (s // 3600)
    return "%dd ago" % (s // 86400)

print()
CTRL = dict.fromkeys(list(range(0, 32)) + list(range(127, 160)), 32)

def clean(v, n=0):
    if not isinstance(v, str):
        return ""
    out = " ".join(v.translate(CTRL).split())
    return out[:n] if n else out

for x in devs:
    # Enrolled scope AND what it will do right now, when they differ: "own,
    # read-only while locked" is a different situation from "enrolled read-only",
    # and showing only the second makes a locked machine look misconfigured.
    scope = x.get("scope") or "?"
    eff = x.get("effectiveScope") or scope
    scope_txt = scope if scope == eff else "%s -> %s while locked" % (scope, eff)

    if x.get("running"):
        state = "RUNNING a job"
    elif not x.get("online"):
        state = "not reachable  (last seen %s)" % ago(x.get("lastSeen"))
    elif x.get("queued"):
        state = "%d queued" % x["queued"]
    else:
        state = "idle"

    # `or "?"`, not `.get(k, "?")`: the default only covers a MISSING key, and a
    # key that is present-but-null sails straight through it and prints "None".
    print("  %-1s %s" % ("*" if x.get("online") else " ", clean(x.get("name")) or "?"))
    print("      %s  .  %s  .  %s" % (clean(x.get("platform")) or "?", scope_txt, state))
    extra = []
    # A device names ITSELF: root and version are whatever the far machine sent,
    # capped at 300 and 40 bytes and never inspected. Both land in a terminal.
    ver = clean(x.get("version"), 40)
    if ver:
        extra.append("v%s" % ver)
    root = clean(x.get("root"), 200)
    # ⚠ ONLY AT work SCOPE, because that is the only scope that uses it. The
    # policy matrix starts an `own` run in the account home directory, and this
    # line printed the enrolled root regardless -- so the host named a directory
    # that ran nothing, while the machine itself said something different. The
    # runner now says so at enrolment too; both ends had to change, because
    # either one alone leaves the two disagreeing.
    if root and x.get("effectiveScope") == "work":
        # Said plainly, because the word "work" invites the wrong assumption.
        extra.append("work runs in %s (not a sandbox)" % root)
    elif root:
        extra.append("work runs in the account home dir (--root %s applies at work scope)" % root)
    if extra:
        print("      %s" % "  .  ".join(extra))
    print()

on = sum(1 for x in devs if x.get("online"))
print("  %d device%s, %d reachable" % (len(devs), "" if len(devs) == 1 else "s", on))
print()
' "$BODY"
