#!/usr/bin/env bash
# huginn-devices — the machines that have offered themselves to huginn.
#
# Host-side for the same reasons as huginn-rounds beside it: one renderer, both
# clients thin, and the bearer token never leaves this machine.
set -u

TOKEN_FILE=/etc/huginn-appd/token
[ -s "$TOKEN_FILE" ] || { echo "huginn-devices: no appd token at $TOKEN_FILE" >&2; exit 1; }

BODY="$(curl -sf -m 10 -H "Authorization: Bearer $(cat "$TOKEN_FILE")" \
  http://127.0.0.1:8787/v1/devices 2>/dev/null)" || {
  echo "huginn-devices: huginn-appd is not answering on 127.0.0.1:8787" >&2
  echo "                (systemctl status huginn-appd)" >&2
  exit 1
}

python3 -c '
import json, sys, time

d = json.loads(sys.argv[1])
devs = d.get("devices", [])
if not devs:
    print()
    print("  No devices enrolled.")
    print()
    print("  A device is another machine that can run a chat in ITS context.")
    print("  Turn on \"Give Huginn access to this PC\" in the desktop client on")
    print("  the machine you want to offer, and it appears here.")
    print()
    sys.exit(0)

def ago(ms):
    if not ms:
        return "never"
    s = time.time() - ms / 1000.0
    if s < 60:    return "%ds ago" % s
    if s < 3600:  return "%dm ago" % (s // 60)
    if s < 86400: return "%dh ago" % (s // 3600)
    return "%dd ago" % (s // 86400)

print()
CTRL = dict.fromkeys(list(range(0, 32)) + list(range(127, 160)), 32)

def clean(v, n=0):
    if not isinstance(v, str):
        return ""
    out = " ".join(v.translate(CTRL).split())
    return out[:n] if n else out

def state_of(x, serving=False):
    if x.get("running"):
        return "RUNNING a job"
    if not x.get("online"):
        return "not reachable  (last seen %s)" % ago(x.get("lastSeen"))
    if x.get("queued"):
        return "%d queued" % x["queued"]
    if serving:
        return "serving"
    if x.get("awaitingPoll"):
        # ⚠ Reachable is not the same as FREE, and the daemon used to answer the
        # second question with the first. remoteRuns is in-memory, so restarting
        # appd wipes it -- while the far machine is still running its claude and
        # is single-job: it will not ask for work again until that child exits,
        # which for a real run is minutes to hours. The row said "idle", the next
        # job was accepted with a 202, and it sat undelivered until it was
        # declared "no word for 5 minutes".
        return "free? unknown - has not asked for work since huginn restarted"
    return "idle"

# One MACHINE, one entry. Rows sharing a machine key are one box wearing two
# credentials (claude work + local-AI serving), and a person owns a box, not a
# credential. Grouping is the daemon-computed key; AUTHORITY stays per-row and
# is untouched by anything rendered here.
groups, order = {}, []
for x in devs:
    k = x.get("machine") or x.get("id") or clean(x.get("name")) or "?"
    if k not in groups:
        groups[k] = []
        order.append(k)
    groups[k].append(x)

for k in order:
    rows = groups[k]
    claude = [x for x in rows if x.get("scope") != "generate"]
    serving = [x for x in rows if x.get("scope") == "generate"]
    head = (claude or serving)[0]
    any_on = any(x.get("online") for x in rows)
    # `or "?"`, not `.get(k, "?")`: the default only covers a MISSING key, and a
    # key that is present-but-null sails straight through it and prints "None".
    print("  %-1s %s" % ("*" if any_on else " ", clean(head.get("name")) or "?"))
    for x in claude:
        # Enrolled scope AND what it will do right now, when they differ: "own,
        # read-only while locked" is a different situation from "enrolled
        # read-only", and showing only the second looks misconfigured.
        scope = x.get("scope") or "?"
        eff = x.get("effectiveScope") or scope
        scope_txt = scope if scope == eff else "%s -> %s while locked" % (scope, eff)
        print("      %s  .  %s  .  %s" % (clean(x.get("platform")) or "?", scope_txt, state_of(x)))
        extra = []
        # A device names ITSELF: root and version are whatever the far machine
        # sent, capped at 300 and 40 bytes and never inspected.
        ver = clean(x.get("version"), 40)
        if ver:
            extra.append("v%s" % ver)
        root = clean(x.get("root"), 200)
        # ⚠ ONLY AT work SCOPE, because that is the only scope that uses it. The
        # policy matrix starts an `own` run in the account home directory, and
        # this line once printed the enrolled root regardless -- the host named
        # a directory that ran nothing.
        if root and x.get("effectiveScope") == "work":
            extra.append("work runs in %s (not a sandbox)" % root)
        elif root:
            extra.append("work runs in the account home dir (--root %s applies at work scope)" % root)
        if extra:
            print("      %s" % "  .  ".join(extra))
    for x in serving:
        models = ", ".join(clean(m.get("display")) or clean(m.get("slug")) or "?"
                           for m in (x.get("models") or [])) or "?"
        bits = ["serves local AI: %s" % models, state_of(x, serving=True)]
        ver = clean(x.get("version"), 40)
        if ver:
            bits.append("v%s" % ver)
        print("      %s" % "  .  ".join(bits))
    print()

machines = len(order)
on = sum(1 for k in order if any(x.get("online") for x in groups[k]))
print("  %d machine%s, %d reachable" % (machines, "" if machines == 1 else "s", on))
print()
' "$BODY"
