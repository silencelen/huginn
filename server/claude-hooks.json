{
  "_comment": "Huginn hooks. Merge this into ~/.claude/settings.json's \"hooks\" object (setup.sh does this for you). Drives huginn-claude-title, which shows Claude's state in the tab title, writes the per-session state file huginn-appd reads, and writes the AskUserQuestion/ExitPlanMode prompt sidecars huginn-appd fuses with its pane scrape. PostToolUse is the primary sidecar clear, so keep it. All async so they never add latency to a turn; they no-op outside tmux.",
  "UserPromptSubmit": [
    { "hooks": [ { "type": "command", "command": "huginn-claude-title UserPromptSubmit", "async": true, "timeout": 10 } ] }
  ],
  "PreToolUse": [
    { "matcher": ".*", "hooks": [ { "type": "command", "command": "huginn-claude-title PreToolUse", "async": true, "timeout": 10 } ] }
  ],
  "PostToolUse": [
    { "matcher": ".*", "hooks": [ { "type": "command", "command": "huginn-claude-title PostToolUse", "async": true, "timeout": 10 } ] }
  ],
  "Notification": [
    { "hooks": [ { "type": "command", "command": "huginn-claude-title Notification", "async": true, "timeout": 10 } ] }
  ],
  "Stop": [
    { "hooks": [ { "type": "command", "command": "huginn-claude-title Stop", "async": true, "timeout": 10 } ] }
  ],
  "SubagentStop": [
    { "hooks": [ { "type": "command", "command": "huginn-claude-title SubagentStop", "async": true, "timeout": 10 } ] }
  ],
  "PreCompact": [
    { "hooks": [ { "type": "command", "command": "huginn-claude-title PreCompact", "async": true, "timeout": 10 } ] }
  ],
  "PostCompact": [
    { "hooks": [ { "type": "command", "command": "huginn-claude-title PostCompact", "async": true, "timeout": 10 } ] }
  ],
  "SessionStart": [
    { "hooks": [ { "type": "command", "command": "huginn-claude-title SessionStart", "async": true, "timeout": 10 } ] }
  ],
  "SessionEnd": [
    { "hooks": [ { "type": "command", "command": "huginn-claude-title SessionEnd", "async": true, "timeout": 10 } ] }
  ]
}
