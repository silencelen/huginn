#!/usr/bin/env bash
# huginn-headroom-gate — the pause button, installed as a Claude Code hook.
#
# It is a DELAY, never a denial. When the daemon has armed a sentinel because the
# account is close to a usage limit, this script sits on the spawn of a subagent
# (SubagentStart) or of an Agent/Workflow tool call (PreToolUse) until the
# sentinel clears, and then lets it through. Exit code is ALWAYS 0: the CLI reads
# a non-zero hook as a block, and a gate that can block is a gate that can wedge
# a session at 3am over a percentage.
#
# Measured facts this script is shaped by (spikes/hook-gate.md):
#   * the CLI blocks the tool call for the whole lifetime of this process —
#     verified to 142 s — so a sleep loop here really is a barrier;
#   * the hook's `timeout` in settings.json is SECONDS, and on expiry the CLI
#     SIGKILLs us and ALLOWS the spawn, silently (`outcome:"cancelled"`, nothing
#     on stderr, nothing in the stream without --include-hook-events). A SIGKILL
#     runs no trap, so a held/<id> file would be orphaned and the operator would
#     be told a spawn is still waiting that is in fact running. That is why we
#     self-release 30 s EARLY (DEADLINE below): every release is then ours, with
#     the held file removed and a `timeout-release` line in the log.
#   * SubagentStart is the only event that sees agents spawned inside a Workflow
#     script, and its payload has no model — so "is this session on Fable?" is
#     answered by the daemon's own `fable-sessions` list, not by the payload.
#
# No jq, no node, no network: coreutils and sed only. This runs on the spawn path
# of every agent, and a dependency that is missing or slow here is felt as the
# session hanging.
set -u
# 0700 on anything we create, whatever the spawning shell's umask happens to be.
# This directory holds the daemon's sentinels and gate.log, and it is created by
# whichever of us runs first on a fresh host; sentinels.ensureDir asks for 0700
# and mkdir does NOT chmod a directory that already exists, so a gate that won
# the race left it world-readable for good.
umask 077

DIR="${HUGINN_HEADROOM_DIR:-/var/lib/huginn-appd/headroom}"
# Mirror of the `timeout` the installer writes into settings.json. Keep them in
# step: this is how long the CLI will wait, and we must finish before it.
GATE_TIMEOUT="${HUGINN_GATE_TIMEOUT:-1800}"
POLL="${HUGINN_GATE_POLL:-2}"
# How long a sentinel may go untouched before it is treated as abandoned.
# The daemon heartbeats every armed sentinel on each headroom tick (a minute at
# its fastest, five at its idlest), so fifteen minutes is several missed ticks
# rather than one slow one. A sentinel older than this means the daemon is gone,
# and a dead daemon must not hold every spawn on the host until the CLI's own
# timeout.
GATE_STALE_S="${HUGINN_GATE_STALE_S:-900}"
LOG_MAX=1048576
case "$GATE_TIMEOUT" in '' | *[!0-9]*) GATE_TIMEOUT=1800 ;; esac
# A FLOOR, not just a shape check. DEADLINE is GATE_TIMEOUT-30, so anything
# under 30 lands in the past and the first iteration releases with `waited=0` —
# the gate silently disabled by a number that passed validation. It fails open,
# which is the right direction, but unreadably.
[ "$GATE_TIMEOUT" -lt 60 ] && GATE_TIMEOUT=60
case "$POLL" in '' | *[!0-9]* | 0) POLL=2 ;; esac
case "$GATE_STALE_S" in '' | *[!0-9]* | 0) GATE_STALE_S=900 ;; esac

START="$(date +%s)"
DEADLINE=$(( START + GATE_TIMEOUT - 30 ))

# ---- payload ---------------------------------------------------------------
# One JSON object on stdin. Flattening on commas keeps each `"key": "value"` on
# its own short line, so the greedy `.*` in the sed below cannot reach across a
# prompt that happens to quote a key name at us — and `1p` then takes the FIRST
# occurrence, which is the envelope's own field rather than anything nested in
# tool_input. Good enough for ids; it is not a JSON parser and must never be
# asked to be one.
PAYLOAD="$(cat 2>/dev/null || true)"
FLAT="$(printf '%s' "$PAYLOAD" | tr '\n\r\t' '   ' | tr ',' '\n')"

jget() {
  printf '%s\n' "$FLAT" |
    sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" |
    sed -n '1p'
}
# The id becomes a FILENAME under held/, from a payload we do not control. Strip
# it to an alphabet that cannot traverse (no dot, no slash) rather than trusting
# that agent ids stay hex forever.
safe_id() { printf '%s' "${1:-}" | sed 's/[^A-Za-z0-9_-]//g' | cut -c1-128; }
# Values that get printed back into a JSON line.
safe_txt() { printf '%s' "${1:-}" | tr -d '\000-\037' | sed 's/[\\"]//g' | cut -c1-200; }

EVENT="$(jget hook_event_name)"
TOOL="$(jget tool_name)"
AGENT_ID="$(jget agent_id)"
AGENT_TYPE="$(jget agent_type)"
SESSION_ID="$(jget session_id)"
TOOL_USE_ID="$(jget tool_use_id)"
TRANSCRIPT="$(jget transcript_path)"

# SubagentStart carries agent_id; PreToolUse carries tool_use_id. Neither is
# guaranteed, so the pid is the last resort — a held file with no id is still
# better than two concurrent gates sharing one name.
ID="$(safe_id "$AGENT_ID")"
[ -n "$ID" ] || ID="$(safe_id "$TOOL_USE_ID")"
[ -n "$ID" ] || ID="pid-$$"
# What the operator sees in the log and on the held row: the agent type when we
# have one, else the tool, else the event.
TYPE="$(safe_txt "$AGENT_TYPE")"
[ -n "$TYPE" ] || TYPE="$(safe_txt "$TOOL")"
[ -n "$TYPE" ] || TYPE="$(safe_txt "$EVENT")"
[ -n "$TYPE" ] || TYPE="-"
SESSION_ID="$(safe_id "$SESSION_ID")"
# Transcripts are named <sessionId>.jsonl — the one field that survives when the
# envelope's session_id does not, and the difference between a Fable session
# being held and slipping through ungated.
if [ -z "$SESSION_ID" ] && [ -n "$TRANSCRIPT" ]; then
  SESSION_ID="$(safe_id "$(basename "$TRANSCRIPT" .jsonl 2>/dev/null || true)")"
fi

# ---- which sentinels bind --------------------------------------------------
# STOP binds everything. STOP-FABLE binds only sessions the daemon listed in
# `fable-sessions` (one Claude session id per line, rewritten each tick), so an
# Opus session keeps working while a Fable one waits out its weekly window.
#
# Decided ONCE, at start, on purpose: a session's model does not change under a
# spawn that is already waiting, and re-reading the list every poll would let a
# tick-time rewrite release (or capture) a hold for reasons the operator cannot
# see in the log line.
BIND_FABLE=0
if [ -n "$SESSION_ID" ] && [ -f "$DIR/fable-sessions" ]; then
  if [ -n "$(sed -n "/^${SESSION_ID}\$/p" "$DIR/fable-sessions" 2>/dev/null)" ]; then
    BIND_FABLE=1
  fi
fi

# Is this sentinel armed AND still being heartbeaten by a live daemon?
#
# Existence alone used to be the whole test, and `arm` deliberately does not move
# `since` on a re-arm — so there was nothing to age against and nothing cleared
# the files on shutdown. A daemon that died with STOP armed blocked every
# Agent/Workflow spawn for GATE_TIMEOUT-30 seconds each, and the only symptom was
# sessions that looked hung. The daemon now touches what it asserts; a sentinel
# nobody has touched for GATE_STALE_S is a sentinel nobody owns.
fresh_sentinel() {
  [ -e "$1" ] || return 1
  mt="$(stat -c %Y "$1" 2>/dev/null || echo 0)"
  case "$mt" in '' | *[!0-9]*) mt=0 ;; esac
  # Unreadable mtime: treat it as armed. Failing OPEN on a file we can see but
  # cannot stat would be a gate that any permissions accident switches off.
  [ "$mt" = 0 ] && return 0
  age=$(( $(date +%s) - mt ))
  [ "$age" -gt "$GATE_STALE_S" ] && return 1
  return 0
}

holding() {
  fresh_sentinel "$DIR/STOP" && return 0
  [ "$BIND_FABLE" = 1 ] && fresh_sentinel "$DIR/STOP-FABLE" && return 0
  return 1
}

# ---- log -------------------------------------------------------------------
logline() {
  [ -d "$DIR" ] || mkdir -p -m 700 "$DIR" 2>/dev/null || return 0
  if [ -f "$DIR/gate.log" ]; then
    sz="$(stat -c %s "$DIR/gate.log" 2>/dev/null || echo 0)"
    case "$sz" in '' | *[!0-9]*) sz=0 ;; esac
    # One generation kept. The gate writes two short lines per spawn; a megabyte
    # is weeks of a busy host, and an unbounded log on a daemon's state dir is
    # how /var fills on the night the fleet is already unhappy.
    [ "$sz" -ge "$LOG_MAX" ] && mv -f "$DIR/gate.log" "$DIR/gate.log.1" 2>/dev/null
  fi
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" >> "$DIR/gate.log" 2>/dev/null || true
}

# ---- held row --------------------------------------------------------------
HELD="$DIR/held/$ID"
hold_begin() {
  mkdir -p -m 700 "$DIR/held" 2>/dev/null || return 0
  printf '{"since":%s,"agent_type":"%s","session_id":"%s"}\n' \
    "$START" "$TYPE" "$SESSION_ID" > "$HELD.tmp" 2>/dev/null &&
    mv -f "$HELD.tmp" "$HELD" 2>/dev/null
  return 0
}
hold_end() { rm -f "$HELD" "$HELD.tmp" 2>/dev/null || true; }
# Covers the ordinary exits and a SIGTERM; a SIGKILL from the CLI's own timeout
# cannot be trapped, which is what the early DEADLINE is for.
trap 'hold_end' EXIT INT TERM

# ---- gate ------------------------------------------------------------------
logline "event=start id=$ID type=$TYPE waited=0"

if holding; then
  hold_begin
  while holding; do
    now="$(date +%s)"
    if [ "$now" -ge "$DEADLINE" ]; then
      hold_end
      logline "event=timeout-release id=$ID type=$TYPE waited=$(( now - START ))"
      exit 0
    fi
    # Never sleep past the deadline: the release has to be ours, and a poll that
    # overshoots is a hold the operator sees end late for no reason.
    rem=$(( DEADLINE - now ))
    if [ "$rem" -lt "$POLL" ]; then sleep "$rem"; else sleep "$POLL"; fi
  done
fi

hold_end
# WHICH kind of release was it? A sentinel still on disk but no longer
# heartbeaten is a dead daemon, not a window that reopened, and the two are worth
# telling apart in the log: one is routine and the other is an incident nothing
# else reports.
if [ -e "$DIR/STOP" ] || { [ "$BIND_FABLE" = 1 ] && [ -e "$DIR/STOP-FABLE" ]; }; then
  logline "event=stale-release id=$ID type=$TYPE waited=$(( $(date +%s) - START )) stale_s=$GATE_STALE_S"
else
  logline "event=release id=$ID type=$TYPE waited=$(( $(date +%s) - START ))"
fi
exit 0
