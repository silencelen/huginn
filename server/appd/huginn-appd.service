[Unit]
Description=huginn-appd - the Huginn server daemon (sessions, chats, devices, apps API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/huginn-appd/huginn-appd.js
Restart=on-failure
RestartSec=3
# The network may not be up yet right after boot - keep retrying.
StartLimitIntervalSec=0
# This server's own settings (bind address, where chats run, alert script) belong
# in a drop-in, not here: install.sh replaces this file on every update and writes
# site.conf once. See systemd.d/README.md for every variable.
WorkingDirectory=/root
# ccusage, Claude Code and anything else resolving ~/.claude need HOME, and
# systemd does not set it.
Environment=HOME=/root
Environment=NODE_ENV=production
# Restarting the daemon must never end your sessions. When the daemon starts the
# first tmux session, the tmux server daemonises into this unit's cgroup; the
# default KillMode=control-group would then kill tmux and every Claude Code
# session in it on each restart or update. `process` stops only the daemon. An
# in-flight headless chat survives a restart as an orphan, which the daemon
# records as interrupted on its next start.
KillMode=process
# Child processes (tmux, Claude Code, PowerShell) log to syslog under this unit.
# Tagging the daemon's own output lets `journalctl -u huginn-appd -t huginn-appd`
# show only the daemon, while children keep their own identifiers.
SyslogIdentifier=huginn-appd

[Install]
WantedBy=multi-user.target
