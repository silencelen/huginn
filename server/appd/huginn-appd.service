[Unit]
Description=huginn-appd — backend for the Huginn Android app (chats + tmux sessions over the tailnet)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/huginn-appd/huginn-appd.js
Restart=on-failure
RestartSec=3
# tailscale IP may not be assignable yet right after boot — keep retrying.
StartLimitIntervalSec=0
# Deployment-specific settings (bind address, chat working directory, memory-node
# probe, alert delivery script) belong in a drop-in, NOT here — deploy.sh rewrites
# this unit on every deploy. See systemd.d/README.md.
# /root/netplan, not /root: appd resolves the host's project skills from its working
# directory, so a bare /root silently removes all 23 of them from phone/desktop chats.
# The live unit was hand-corrected to this; the repo lagged until 2026-08-14.
WorkingDirectory=/root/netplan
Environment=NODE_ENV=production
# ccusage (and anything else resolving ~/.claude) needs HOME; systemd does not
# set it, and without it ccusage exits with 'home directory is not set'.
Environment=HOME=/root

[Install]
WantedBy=multi-user.target
