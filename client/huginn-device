#!/usr/bin/env node
'use strict';
// huginn-device — offer THIS machine to Huginn as a place to run work.
//
// The headless half of "give Huginn access to this PC". The desktop client has a
// runner built in with a toggle in Settings; a server, a Pi or a build box has no
// desktop app and no one to click the toggle, so it gets this instead: the same
// protocol, the same policy, run by systemd.
//
// WHY NODE, on a machine where the rest of the client is shell. A device has to
// hold a 25-second long poll open, stream a child's stdout, batch it upward every
// half second AND notice a cancel arriving in the reply to one of those batches —
// four things at once. Shell can be beaten into that shape with fifos and
// background jobs; the result is not something anyone should have to debug at
// 3am. And the dependency is free: `claude` is itself a Node program, so any
// machine that qualifies as a device already has Node on it.
//
// THE TRANSPORT IS A PULL. This opens outbound connections and listens on
// nothing. That is why it works identically on a box in the next room and a
// laptop on hotel wi-fi, and why offering a machine needs no firewall change.
//
// WHAT THE DAEMON MAY DO TO THIS MACHINE is decided HERE, by the policy below —
// never by what arrives on the wire. A work item carries a request and no
// authority. See shared/device-policy.json for the reasoning.

const fs = require('fs');
const os = require('os');
const path = require('path');
const http = require('http');
const https = require('https');
const readline = require('readline');
const { spawn } = require('child_process');

const VERSION = '0.12.4';

// ---8<--- GENERATED POLICY — scripts/gen-device-policy.js — DO NOT EDIT ---8<---
const POLICY = {
  "scopes": [
    "generate",
    "look",
    "work",
    "own"
  ],
  "exclusiveScopes": [
    "generate"
  ],
  "enrolDefault": "look",
  "modeNeeds": {
    "ask": "look",
    "act": "work",
    "generate": "generate"
  },
  "lockDropsTo": "look",
  "streamFlags": [
    "-p",
    "--output-format",
    "stream-json",
    "--verbose",
    "--include-partial-messages"
  ],
  "tools": {
    "look": {
      "allowed": [
        "Skill",
        "Read",
        "Glob",
        "Grep",
        "WebFetch",
        "WebSearch"
      ],
      "denied": [
        "Bash",
        "Edit",
        "Write",
        "NotebookEdit"
      ]
    },
    "act": {
      "allowed": [
        "Skill",
        "Bash",
        "Read",
        "Edit",
        "Write",
        "Glob",
        "Grep",
        "WebFetch",
        "WebSearch"
      ],
      "denied": []
    }
  },
  "refusals": {
    "locked": "this machine is locked, so it is read-only until someone unlocks it",
    "scope": "this machine is set to {scope}, which cannot run {mode}",
    "engine": "this machine has no local model engine, so it cannot run generate"
  }
};
// ---8<--- END GENERATED POLICY ---8<---

// ------------------------------------------------------------------ config
//
// Two files, deliberately. The token is a credential and lives on its own with
// 0600, the way the host keeps /etc/huginn-appd/token; the rest is settings a
// person edits. Putting a bearer token inside a config file people hand-edit is
// how tokens end up in pastes and in git.

const CONF_DIR = process.env.HUGINN_DEVICE_DIR
  || path.join(os.homedir(), '.config', 'huginn');
const CONF_FILE = path.join(CONF_DIR, 'device.json');
const TOKEN_FILE = path.join(CONF_DIR, 'appd-token');

const DEFAULTS = {
  url: 'http://127.0.0.1:8787',
  name: null,
  // `work` and not `own`, because a default is what people keep. Widening is a
  // decision somebody should make on purpose, on this machine.
  scope: 'work',
  root: null,
  claude: 'claude',
};

function loadConf() {
  let raw = {};
  try { raw = JSON.parse(fs.readFileSync(CONF_FILE, 'utf8')); } catch { /* first run */ }
  const c = { ...DEFAULTS, ...raw };
  c.name = c.name || os.hostname().slice(0, 40) || 'this machine';
  return c;
}

/**
 * `--flag value` AND `--flag=value`, with anything unrecognised refused.
 *
 * Refusing rather than ignoring is the whole point: a typo in a flag that
 * silently does nothing produces a machine enrolled at the wrong scope, in the
 * wrong directory, reported as a success.
 */
function parseFlags(args, allowed) {
  const flags = {};
  for (let i = 0; i < args.length; i += 1) {
    const a = args[i];
    if (!a.startsWith('--')) return { error: `unexpected argument "${a}"` };
    const eq = a.indexOf('=');
    const name = (eq === -1 ? a.slice(2) : a.slice(2, eq));
    if (!allowed.includes(name)) {
      return { error: `unknown flag "--${name}" (try: ${allowed.map((x) => `--${x}`).join(' ')})` };
    }
    if (eq !== -1) { flags[name] = a.slice(eq + 1); continue; }
    const v = args[i + 1];
    if (v === undefined || v.startsWith('--')) return { error: `--${name} needs a value` };
    flags[name] = v; i += 1;
  }
  return { flags };
}

function saveConf(c) {
  fs.mkdirSync(CONF_DIR, { recursive: true, mode: 0o700 });
  fs.writeFileSync(CONF_FILE, JSON.stringify(c, null, 2) + '\n', { mode: 0o600 });
}

function token() {
  return tokenOrWhy().token;
}

/**
 * The token, or WHY there isn't one.
 *
 * ⚠ This used to be `try { read } catch { return '' }`, so a file that was
 * missing, unreadable, a directory, a dangling symlink, or present but empty all
 * produced the same empty string and the same advice: "put one in <path>" —
 * pointing at a file that was, in three of those five cases, sitting right there.
 * Under `serve()` that repeats every 15 seconds forever with the wrong
 * instruction, on a machine with nobody at it to notice the advice is useless.
 *
 * A one-byte newline is the nastiest of them: `client/huginn.sh` guards the
 * fetched token with `[ -s ]`, which a newline passes, so a botched
 * `ssh huginn 'cat /etc/huginn-appd/token'` installs cleanly and then the runner
 * insists there is no token at all.
 */
function tokenOrWhy() {
  const env = (process.env.HUGINN_APPD_TOKEN || '').trim();
  if (env) return { token: env, why: null };
  let raw;
  try {
    raw = fs.readFileSync(TOKEN_FILE, 'utf8');
  } catch (e) {
    if (e.code === 'ENOENT') return { token: '', why: `no token file at ${TOKEN_FILE}` };
    if (e.code === 'EACCES') return { token: '', why: `cannot read ${TOKEN_FILE} (permissions)` };
    if (e.code === 'EISDIR') return { token: '', why: `${TOKEN_FILE} is a directory, not a file` };
    return { token: '', why: `cannot read ${TOKEN_FILE}: ${e.message}` };
  }
  const t = raw.trim();
  if (!t) {
    return {
      token: '',
      why: raw.length
        ? `${TOKEN_FILE} holds only whitespace (${raw.length} byte${raw.length === 1 ? '' : 's'}) — `
          + 'a capture that caught a newline and nothing else'
        : `${TOKEN_FILE} is empty`,
    };
  }
  return { token: t, why: null };
}

function platform() {
  const p = process.platform;
  if (p === 'win32') return 'windows';
  if (p === 'darwin') return 'macos';
  if (p === 'linux') return 'linux';
  return 'other';
}

// ------------------------------------------------------------------ policy
//
// The same rules as the Kotlin runner in the desktop app, reading the same
// table. Both are asserted against shared/device-policy-cases.json, so a request
// cannot come out differently depending on which kind of machine it landed on.

const SESSION_ID_RE = /^[0-9a-fA-F-]{36}$/;

const rank = (s) => POLICY.scopes.indexOf(s);

function parseScope(raw) {
  const s = String(raw ?? '').trim().toLowerCase();
  // Unrecognised is the NARROWEST, never the widest: a typo in a config file must
  // not be a privilege escalation.
  return POLICY.scopes.includes(s) ? s : POLICY.scopes[0];
}

/**
 * An EXCLUSIVE scope (generate) matches only itself, both ways: a generate
 * device runs only generate work, and generate work runs only on a generate
 * device. Rank ordering alone would let `own` satisfy generate — and this
 * machine would spawn claude to answer a local-model request, the silent
 * engine substitution the policy bans in both directions.
 */
const exclusive = (s) => (POLICY.exclusiveScopes || []).includes(s);

// Exclusive scopes ignore the lock drop: a generate run mutates nothing, so a
// lock has nothing to withdraw — and dropping generate to look would
// sideways-GRANT ask, a claude mode this row has no engine for.
const effectiveScope = (scope, locked) => {
  const s = parseScope(scope);
  return exclusive(s) ? s : (locked ? POLICY.lockDropsTo : s);
};

/**
 * ⚠ AN UNKNOWN MODE IS REFUSED. This FAILED OPEN: `POLICY.modeNeeds` comes from
 * JSON so it carries Object.prototype, `modeNeeds.constructor` is a function,
 * `rank()` of it is -1, and `rank(scope) >= -1` is true for every scope — so a
 * look-only machine returned "no refusal" for a mode nobody had ever defined.
 * The tools stayed read-only because argvFor compares mode === 'act' literally,
 * so nothing escalated; but this is the function whose entire job is to say no,
 * and it said yes. Mapping the unknown to 'work' would be no better.
 */
const needFor = (mode) =>
  (Object.prototype.hasOwnProperty.call(POLICY.modeNeeds, mode) && typeof POLICY.modeNeeds[mode] === 'string')
    ? POLICY.modeNeeds[mode] : null;
const allows = (scope, mode) => {
  const n = needFor(mode);
  if (n === null) return false;
  const s = parseScope(scope);
  if (exclusive(n) || exclusive(s)) return s === n;
  return rank(s) >= rank(n);
};

function refusal(scope, locked, mode) {
  if (allows(effectiveScope(scope, locked), mode)) return null;
  // The lock is blamed only when unlocking would actually help — the enrolled
  // scope allows the mode and only the lock-drop is in the way. Everything else
  // names the scope, because the scope is what somebody would have to change.
  return (locked && allows(parseScope(scope), mode))
    ? POLICY.refusals.locked
    : POLICY.refusals.scope.replace('{scope}', parseScope(scope)).replace('{mode}', mode);
}

/**
 * The engine fence — the one rule the policy table cannot hold, because the
 * table cannot see which binary sits at conf.claude/conf.llm. Generate work
 * needs a local model engine; this runner spawns one only when `huginn local
 * on` has configured it. Without one the honest answer is a refusal, never a
 * claude spawn with a tool-flag-free argv.
 */
const engineRefusal = (mode, hasEngine) =>
  (mode === 'generate' && !hasEngine) ? POLICY.refusals.engine : null;

/** How an engine path becomes a spawn: a .js engine runs through node. */
const execFor = (engineBin, argv) =>
  String(engineBin).endsWith('.js')
    ? [process.execPath, [engineBin, ...argv]]
    : [engineBin, argv];

function argvFor(work, scope, locked, persona) {
  // A granted generate argv is the bare stream flags plus the request: no tool
  // flags (the shim has no tool surface — absence is the fence), no --effort,
  // and NO persona — huginn's context never rides to a serving box.
  if (work.mode === 'generate' && allows(effectiveScope(scope, locked), 'generate')) {
    const argv = POLICY.streamFlags.slice();
    if (work.model) argv.push('--model', work.model);
    if (SESSION_ID_RE.test(String(work.resumeSessionId || ''))) {
      argv.push('--resume', work.resumeSessionId);
    }
    return argv;
  }
  const act = work.mode === 'act' && allows(effectiveScope(scope, locked), 'act');
  const argv = POLICY.streamFlags.slice();
  if (work.model) argv.push('--model', work.model);
  if (work.effort) argv.push('--effort', work.effort);
  // ⚠ Checked HERE too, not only where it was stored. This machine builds its own
  // argv — that is the whole security model — so it does not get to assume the
  // other end validated anything. `--resume` takes an optional value, so a string
  // starting with `--` is not an id, it is a second flag.
  if (SESSION_ID_RE.test(String(work.resumeSessionId || ''))) {
    argv.push('--resume', work.resumeSessionId);
  }
  if (persona) argv.push('--append-system-prompt', persona);
  const t = POLICY.tools[act ? 'act' : 'look'];
  argv.push('--allowedTools', t.allowed.join(' '));
  if (t.denied.length) argv.push('--disallowedTools', t.denied.join(' '));
  return argv;
}

// ⚠ WORK IS NOT A JAIL. The difference between `work` and `own` is the directory
// a run starts in, not a kernel boundary — a granted Bash can leave any directory
// and no flag Claude Code takes will stop it. The fences that are real are the
// scope gate above and, on a machine with a screen, the lock rule.
function isDir(p) {
  try { return fs.statSync(p).isDirectory(); } catch { return false; }
}

function cwdFor(scope, locked, root) {
  const home = os.homedir() || process.cwd();
  const r = (root || '').trim();
  return effectiveScope(scope, locked) === 'work' && r ? r : home;
}

/**
 * Is somebody sitting at this machine?
 *
 * On a desktop the runner asks the session manager and drops to read-only while
 * the screen is locked. Here the honest answer is that NOBODY IS EVER SITTING
 * HERE — a headless box has no session to lock — so there is no lock state to
 * report and none is reported.
 *
 * Which means the scope in the config file is the scope in force at 3am. That is
 * not a gap to paper over with a fake lock signal; it is the reason `own` is not
 * the default here and the reason `enrol` says so out loud.
 */
const locked = () => false;

// -------------------------------------------------------------------- http

function api(method, p, body, { timeoutMs = 20000 } = {}) {
  const conf = loadConf();
  const u = new URL(p, conf.url);
  const mod = u.protocol === 'https:' ? https : http;
  const payload = body === undefined ? null : Buffer.from(JSON.stringify(body));
  const tok = token();
  if (!tok) {
    // The REASON, not one guess dressed as a fact. Under serve() this repeats
    // every 15 seconds forever on a machine with nobody at it, so the difference
    // between "there is no file" and "the file is there and holds a newline" is
    // the difference between a fix and an afternoon.
    return Promise.reject(new Error(`no appd token — ${tokenOrWhy().why || 'reason unknown'}`));
  }

  return new Promise((resolve, reject) => {
    const req = mod.request(u, {
      method,
      headers: {
        Authorization: `Bearer ${tok}`,
        ...(payload ? { 'Content-Type': 'application/json', 'Content-Length': payload.length } : {}),
      },
      timeout: timeoutMs,
    }, (res) => {
      let out = '';
      res.setEncoding('utf8');
      res.on('data', (c) => { out += c; });
      res.on('end', () => {
        if (res.statusCode >= 400) {
          return reject(new Error(`${method} ${u.pathname} → ${res.statusCode} ${out.slice(0, 200)}`));
        }
        try { resolve(out ? JSON.parse(out) : {}); } catch (e) { reject(e); }
      });
    });
    req.on('timeout', () => req.destroy(new Error('timed out')));
    req.on('error', reject);
    if (payload) req.write(payload);
    req.end();
  });
}

// ------------------------------------------------------------------ enrol

async function enrol(conf) {
  const dev = await api('POST', '/v1/devices', {
    id: conf.id || undefined,
    name: conf.name,
    platform: platform(),
    scope: parseScope(conf.scope),
    root: conf.root || null,
    version: VERSION,
    locked: locked(),
    // Display-only advertisement (what a serving row says it serves). The
    // daemon renders it untrusted; it is never routing authority.
    models: Array.isArray(conf.models) ? conf.models : undefined,
  });
  // ⚠ THE SCOPE ECHO IS THE FENCE against an old daemon. An appd without the
  // generate rung files an unknown scope as its own floor — which would
  // silently enrol a SERVING machine as a read-only CLAUDE device, the exact
  // misenrolment the exclusive scope exists to prevent. The scope this runner
  // asked for must be the scope the daemon heard, or nothing is offered.
  if (parseScope(conf.scope) === 'generate' && dev.scope !== 'generate') {
    throw new Error(`the daemon did not recognise scope "generate" (it answered "${dev.scope}") — update huginn-appd before enrolling a serving machine`);
  }
  if (dev.llmSlug && conf.llmSlug !== dev.llmSlug) { conf.llmSlug = dev.llmSlug; saveConf(conf); }
  if (dev.id !== conf.id) { conf.id = dev.id; saveConf(conf); }
  return dev.id;
}

// -------------------------------------------------------------------- work

/**
 * One job.
 *
 * Results go up in BATCHES with an explicit terminal frame, not one long chunked
 * upload. A home network drops, and a dropped stream is indistinguishable from a
 * finished run — so the ending is something this machine SAYS, not something the
 * daemon infers from silence. Each batch is also where a cancel comes back, which
 * makes the flush interval the worst-case latency of the stop button.
 */
/**
 * The daemon caps a request body, and a batch that exceeds it is rejected whole.
 *
 * ⚠⚠ THIS LOST ENTIRE ANSWERS. A device runs claude with
 * `--output-format stream-json --verbose --include-partial-messages`, so ONE
 * line can carry a whole tool_result or a whole final answer — a Read of a big
 * file, a chatty Bash, a long report. Over the cap the POST came back 413 and:
 *
 *   1. the whole batch was lost, not just the oversized line;
 *   2. if the terminal frame was in that batch it could NEVER be delivered, since
 *      the retry is identically 413 — so the chat sat `running` forever and this
 *      machine was blocked from every other job;
 *   3. the chat was then blamed on "no word for 5 minutes".
 *
 * The failure was silent, permanent, and reserved for the runs with the most to
 * say. So the RUNNER keeps itself under the limit rather than discovering it: no
 * batch is ever built too large, an oversized line is shrunk in place with a
 * marker where the content was, and the terminal frame is posted ALONE so that
 * whatever else happens, the ending can always land.
 */
const MAX_LINE_BYTES = 128 * 1024;
const MAX_BATCH_BYTES = 192 * 1024;

const bytes = (x) => Buffer.byteLength(typeof x === 'string' ? x : JSON.stringify(x));

/** Truncates every long string inside a parsed event, in place. */
function trimStrings(node, budget, seen = new Set()) {
  if (!node || typeof node !== 'object' || seen.has(node)) return;
  seen.add(node);
  for (const [k, v] of Object.entries(node)) {
    if (typeof v === 'string' && v.length > budget) {
      node[k] = `${v.slice(0, budget)}\n\n[… ${v.length - budget} more characters were too large to send and were dropped]`;
    } else if (v && typeof v === 'object') {
      trimStrings(v, budget, seen);
    }
  }
}

/**
 * A line small enough to send, keeping its own event type wherever possible.
 *
 * Shrinking in place beats substituting a note: a truncated tool_result still
 * renders as a tool_result with most of its content, where a replacement would
 * lose the shape and everything in it.
 */
function shrinkLine(line) {
  if (bytes(line) <= MAX_LINE_BYTES) return line;
  let ev;
  try { ev = JSON.parse(line); } catch { ev = null; }
  if (ev) {
    for (const budget of [32768, 8192, 1024, 200]) {
      trimStrings(ev, budget);
      const out = JSON.stringify(ev);
      if (bytes(out) <= MAX_LINE_BYTES) return out;
    }
  }
  // Unparseable, or structurally huge whatever we do. Said as assistant text so
  // it is VISIBLE in the transcript: a silently missing event is the thing this
  // whole function exists to stop.
  return JSON.stringify({
    type: 'assistant',
    message: { content: [{ type: 'text',
      text: `[one output event of ${bytes(line)} bytes was too large to send and was dropped]` }] },
  });
}

/** Splits lines into batches that will each fit, preserving order. */
function batchLines(lines) {
  const out = []; let cur = []; let size = 0;
  for (const raw of lines) {
    const line = shrinkLine(raw);
    const n = bytes(line) + 2;
    if (cur.length && size + n > MAX_BATCH_BYTES) { out.push(cur); cur = []; size = 0; }
    cur.push(line); size += n;
  }
  if (cur.length) out.push(cur);
  return out;
}

/** True when the daemon will never accept this again, however many times we try. */
const permanent = (e) => / → (40[034]|413) /.test(String(e && e.message));

function runWork(id, work, conf) {
  return new Promise((resolve) => {
    const scope = parseScope(conf.scope);
    const lock = locked();

    const why = refusal(scope, lock, work.mode);
    if (why) {
      // Refused HERE, by the machine, and said out loud. The daemon pre-checks the
      // same rule so a person hears it at the moment they ask — but this is the
      // check that decides, because this is the process holding the file system.
      log(`refused ${work.id}: ${why}`);
      api('POST', `/v1/devices/${id}/work/${work.id}/events`,
        { lines: [], done: true, error: why, locked: lock })
        .catch(() => {}).then(resolve);
      return;
    }

    // The engine fence, after the scope fence: policy said yes, but generate
    // work still needs a configured local engine. Never fall through to claude —
    // a hand-edited `scope: "generate"` on a claude box would otherwise pass
    // the policy and spawn claude with a tool-flag-free argv.
    const engineWhy = engineRefusal(work.mode, !!conf.llm);
    if (engineWhy) {
      log(`refused ${work.id}: ${engineWhy}`);
      api('POST', `/v1/devices/${id}/work/${work.id}/events`,
        { lines: [], done: true, error: engineWhy, locked: lock })
        .catch(() => {}).then(resolve);
      return;
    }

    const argv = argvFor(work, scope, lock);
    const cwd = cwdFor(scope, lock, conf.root);
    log(`running ${work.id} (${work.mode}) in ${cwd}`);

    // ⚠ CHECKED BEFORE THE SPAWN, because spawn() raises ENOENT for a missing
    // EXECUTABLE and for a missing CWD, and the error handler below could only
    // guess. It guessed "claude is not on this machine's PATH" — so a deleted
    // work root made every job on the device fail forever with the one piece of
    // advice the operator had already followed.
    if (!isDir(cwd)) {
      finish(`${conf.name} cannot start work: ${cwd} is not a directory`);
      return;
    }

    // Which engine: the claude CLI for ask/act, the llm shim for generate. The
    // dispatch is by MODE, never by scope — the scope fence already ran. A .js
    // engine spawns through node: Windows cannot spawn a script directly, and
    // shell:true is not acceptable for an argv near a prompt.
    const [bin, fullArgv] = execFor(work.mode === 'generate' ? conf.llm : (conf.claude || 'claude'), argv);
    let child;
    try {
      child = spawn(bin, fullArgv, { cwd, stdio: ['pipe', 'pipe', 'pipe'] });
    } catch (e) {
      return finish(`could not start ${work.mode === 'generate' ? 'the local engine' : 'claude'} on ${conf.name}: ${e.message}`);
    }

    let pending = [];
    let cancelled = false;
    let done = false;

    let flushing = false;
    const flush = setInterval(async () => {
      if (!pending.length || done || flushing) return;
      flushing = true;
      const batch = pending; pending = [];
      try {
        for (const chunk of batchLines(batch)) {
          const ack = await api('POST', `/v1/devices/${id}/work/${work.id}/events`,
            { lines: chunk, locked: lock });
          if (ack && ack.cancel && !cancelled) { cancelled = true; child.kill(); }
        }
      } catch (e) {
        if (permanent(e)) {
          // ⚠ NOT RETRYABLE, and retrying was its own bug: after a daemon
          // restart the run is simply gone, and the old code re-queued the batch
          // and hammered the 404 twice a second for as long as the child lived.
          // There is nothing left to deliver these to.
          log(`giving up on ${work.id}: ${e.message}`);
          cancelled = true;
          try { child.kill(); } catch { /* already gone */ }
        } else {
          // Put them back: a blip mid-run must not silently eat the answer.
          pending = batch.concat(pending);
          log(`batch failed (will retry): ${e.message}`);
        }
      } finally {
        flushing = false;
      }
    }, 500);

    readline.createInterface({ input: child.stdout })
      .on('line', (line) => { if (line.trim()) pending.push(line); });

    // Claude's stderr is not stream-json and the daemon cannot read it, but it is
    // where a startup failure explains itself — so it is kept for the ending
    // rather than discarded into the void.
    let errTail = '';
    child.stderr.on('data', (c) => { errTail = (errTail + c).slice(-500); });

    child.on('error', (e) => finish(
      e.code === 'ENOENT'
        // The cwd was checked above, so ENOENT here really is the executable.
        //
        // ⚠ No config PATH in this string. It lands in a chat that syncs to a
        // phone, and the private layout of a machine is not something to publish
        // there to say a sentence that is just as actionable without it.
        ? `claude was not found on ${conf.name} (set "claude" to its full path in this machine's huginn config)`
        : `could not start claude on ${conf.name}: ${e.message}`));

    child.on('close', (code) => finish(
      cancelled ? `cancelled on ${conf.name}`
        : code === 0 ? null
          : `claude exited ${code} on ${conf.name}${errTail ? `: ${errTail.trim().slice(-200)}` : ''}`,
      code));

    // A spawn that failed leaves a stream whose 'error' would be unhandled, and an
    // unhandled stream error takes the whole runner down over a missing binary.
    child.stdin.on('error', () => {});
    child.stdin.end(work.prompt);

    async function finish(error, exitCode = null) {
      if (done) return;
      done = true;
      clearInterval(flush);
      const tail = pending; pending = [];
      // ⚠ THE TAIL FIRST, THEN THE ENDING ALONE. These used to go in one POST,
      // so an oversized tail took the terminal frame down with it — and its retry
      // was identically 413, meaning the ending could NEVER be delivered. The
      // chat sat `running` forever and this machine was blocked from every other
      // job. The ending is a few hundred bytes and now travels by itself, so the
      // worst a huge tail can cost is the tail.
      for (const chunk of batchLines(tail)) {
        try {
          await api('POST', `/v1/devices/${id}/work/${work.id}/events`, { lines: chunk, locked: lock });
        } catch (e) {
          log(`could not send part of the output of ${work.id}: ${e.message}`);
          if (permanent(e)) break;
        }
      }
      try {
        await api('POST', `/v1/devices/${id}/work/${work.id}/events`,
          { lines: [], done: true, exitCode, error, locked: lock });
      } catch (e) {
        log(`could not report the ending of ${work.id}: ${e.message}`);
      }
      log(`finished ${work.id}${error ? ` — ${error}` : ''}`);
      resolve();
    }
  });
}

// -------------------------------------------------------------------- loop

async function serve() {
  let beat = null;
  for (;;) {
    const conf = loadConf();
    try {
      const id = await enrol(conf);
      log(`enrolled as ${conf.name} (${parseScope(conf.scope)}) → ${conf.url}`);

      // Separate from the poll because they answer different questions: the poll
      // asks "is there work", the beat says "I am still here, and this is what I
      // will do now". A device that only polled would look present but never
      // report a change in what it is willing to do.
      clearInterval(beat);
      beat = setInterval(() => {
        api('POST', `/v1/devices/${id}/beat`, {
          locked: locked(), scope: parseScope(loadConf().scope), version: VERSION,
        }).catch(() => {});
      }, 60000);

      let failures = 0;
      for (;;) {
        let work;
        try {
          // Long poll. The daemon holds this open until there is work or the wait
          // runs out, so a job is picked up in the moment it is created.
          const r = await api('GET', `/v1/devices/${id}/work?wait=25&locked=${locked() ? 1 : 0}`,
            undefined, { timeoutMs: 40000 });
          work = r.work;
          failures = 0;
        } catch (e) {
          // A blip on one poll is not a reason to re-enrol, and re-enrolling on
          // every hiccup is what turns a flaky link into a stream of registrations.
          failures += 1;
          if (failures >= 5) throw e;
          log(`poll failed (${failures}/5): ${e.message}`);
          await sleep(3000);
          continue;
        }
        if (work) await runWork(id, work, loadConf());
      }
    } catch (e) {
      // Never fatal. A daemon that is down, a token that was rotated, a box that
      // suspended — all of these are "try again shortly". A runner that gave up on
      // the first failure would need somebody to notice and restart it.
      clearInterval(beat);
      log(`not reaching huginn: ${e.message} — retrying in 15s`);
      await sleep(15000);
    }
  }
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
const log = (m) => console.log(`[huginn-device] ${new Date().toISOString()} ${m}`);

// ------------------------------------------------------------------ status

async function status() {
  const conf = loadConf();
  console.log('');
  console.log(`  ${conf.name}  (${platform()})`);
  console.log(`    offering    ${parseScope(conf.scope)}${parseScope(conf.scope) === 'own' ? '  — the whole machine, always: nothing here can tell when nobody is looking' : ''}`);
  console.log(`    work runs in ${cwdFor(conf.scope, false, conf.root)} (not a sandbox)`);
  console.log(`    huginn      ${conf.url}`);
  console.log(`    claude      ${conf.claude}`);
  console.log(`    config      ${CONF_FILE}`);
  // ⚠ THE REASON HERE TOO. `status` is precisely where somebody looks when the
  // runner will not start, and printing MISSING for a file that is sitting right
  // there — unreadable, or holding a captured newline — sends them to re-create
  // something they already have.
  const tk = tokenOrWhy();
  console.log(`    token       ${tk.token ? TOKEN_FILE : `MISSING — ${tk.why}`}`);
  if (!conf.id) {
    console.log('');
    // Its OWN name, not `huginn device on`. The CLI wrapper is a convenience a
    // headless box may well not have, and telling somebody to run a command that
    // is not installed is worse than telling them nothing.
    console.log('    Not enrolled yet.  Run:  huginn-device on');
    console.log('');
    return;
  }
  try {
    const d = await api('GET', `/v1/devices/${conf.id}`);
    console.log('');
    console.log(`    huginn sees it as ${d.online ? 'reachable' : 'NOT reachable'}`
      + `, scope ${d.scope}${d.scope === d.effectiveScope ? '' : ` (→ ${d.effectiveScope} right now)`}`
      + `${d.running ? ', running a job' : d.queued ? `, ${d.queued} queued` : ''}`);
  } catch (e) {
    console.log('');
    console.log(`    could not ask huginn: ${e.message}`);
  }
  console.log('');
}

// -------------------------------------------------------------------- main

async function main() {
  const cmd = process.argv[2] || 'help';
  const conf = loadConf();

  if (!POLICY && cmd !== 'help' && cmd !== 'version') {
    // No silent default. A runner with no policy does not get to guess one.
    console.error('huginn-device: no policy compiled in — this file was not generated correctly.');
    console.error('               Run: node scripts/gen-device-policy.js');
    process.exit(2);
  }

  switch (cmd) {
    case 'enrol': case 'enroll': case 'on': {
      // Flags, so `huginn device on --scope own --root /srv` is one command.
      //
      // ⚠ BOTH FORMS, AND NOTHING SILENTLY IGNORED. This matched only the
      // space-separated form by exact string equality, and the if/else chain had
      // no else — so `--scope=own --root=/srv/build` enrolled at the DEFAULT
      // scope with no root and printed `Enrolled flagbox as "work"`. The word
      // root never appeared in the output, so nothing told anyone their build
      // directory had been dropped and every job would land in $HOME. The help,
      // the shell wrapper and the completion all advertise these flags; the
      // equals form is the one people type.
      const parsed = parseFlags(process.argv.slice(3), ['scope', 'root', 'url', 'name', 'claude']);
      if (parsed.error) { console.error(`huginn-device on: ${parsed.error}`); process.exit(2); }
      const f = parsed.flags;
      // Validated, not floored: at enrol time a typo'd scope must be a refusal,
      // not a silent enrolment at the floor — the floor is now generate, and a
      // typo'd claude enrolment landing there would be a dead device row.
      if (f.scope !== undefined) {
        const s = String(f.scope).trim().toLowerCase();
        if (!POLICY.scopes.includes(s)) {
          console.error(`huginn-device on: unknown scope "${f.scope}" — one of: look, work, own`);
          process.exit(2);
        }
        if (exclusive(s)) {
          console.error(`huginn-device on: "${s}" enrolment is created by \`huginn local on\`, not by hand`);
          process.exit(2);
        }
        conf.scope = s;
      }
      if (f.root !== undefined) conf.root = f.root;
      if (f.url !== undefined) conf.url = f.url;
      if (f.name !== undefined) conf.name = f.name.slice(0, 40);
      if (f.claude !== undefined) conf.claude = f.claude;
      // ⚠ SAID OUT LOUD, because the two ends disagreed silently. `root` is the
      // cwd a run STARTS in and the policy matrix only honours it for `work`; an
      // `own` device starts in $HOME. It was accepted, stored and advertised to
      // the host anyway, so `huginn devices` named a directory that ran nothing.
      if (f.root !== undefined && parseScope(conf.scope) !== 'work') {
        console.log('');
        console.log(`  Note: --root is only used at "work" scope. This machine is enrolling as`);
        console.log(`  "${parseScope(conf.scope)}", so work will start in the account's home directory`);
        console.log(`  instead of ${f.root}. The root is kept in the config in case you narrow the`);
        console.log('  scope later.');
      }
      saveConf(conf);
      const id = await enrol(loadConf());
      console.log(`Enrolled ${conf.name} as "${parseScope(conf.scope)}" (${id}).`);
      if (parseScope(conf.scope) !== 'look') {
        // Said at the moment somebody widens it, not buried in a doc.
        console.log('');
        console.log('  This machine has no screen to lock, so it cannot tell when nobody is');
        console.log('  watching — a desktop drops to read-only while locked and this cannot.');
        console.log(`  "${parseScope(conf.scope)}" here means "${parseScope(conf.scope)}", at 3am, unattended.`);
      }
      console.log('');
      console.log('  Start it, on a machine somebody uses:');
      console.log('    huginn-device unit > ~/.config/systemd/user/huginn-device.service');
      console.log('    systemctl --user enable --now huginn-device');
      console.log('  On a headless machine, where nobody logs in:');
      console.log('    huginn-device unit --system > /etc/systemd/system/huginn-device.service');
      console.log('    systemctl enable --now huginn-device');
      break;
    }
    case 'off': {
      if (!conf.id) { console.log('Not enrolled.'); break; }
      // ⚠ THE ID IS THE ONLY HANDLE THAT CAN REMOVE THIS ROW, so it is not thrown
      // away until the host confirms the row is gone. The DELETE used to be
      // `.catch(e => console.error(e.message))` — logged, then ignored — and the
      // id was deleted and "Removed from huginn." printed at exit 0 regardless.
      // So exactly when someone decommissions a machine (host asleep, VPN down,
      // wrong url) the device stayed enrolled, the handle was destroyed, a
      // restart enrolled a SECOND row for the same box, and the stale one went on
      // being offered work for thirty days.
      try {
        await api('DELETE', `/v1/devices/${conf.id}`);
      } catch (e) {
        console.error(`Could NOT remove this machine from huginn: ${e.message}`);
        console.error('');
        console.error(`  Still enrolled as ${conf.id}. Nothing has been changed here, so this`);
        console.error('  is safe to run again once huginn is reachable. Stop the runner');
        console.error('  meanwhile, or it keeps answering for work:');
        console.error('    systemctl disable --now huginn-device');
        process.exit(1);
      }
      delete conf.id;
      saveConf(conf);
      // Said plainly, because "removed" would be a lie: nothing here reaches onto
      // the machine, and a runner still running would simply re-enrol.
      console.log('Removed from huginn. Stop the runner too, or it enrols again:');
      console.log('  systemctl disable --now huginn-device          (system unit)');
      console.log('  systemctl --user disable --now huginn-device   (user unit)');
      break;
    }
    case 'serve': case 'run': await serve(); break;
    case 'status': await status(); break;
    case 'unit': {
      const self = fs.realpathSync(process.argv[1]);
      const system = process.argv.includes('--system');
      const who = os.userInfo();
      // HOME is set explicitly rather than left to systemd. A system unit derives
      // it from User=, which is usually right and silently is not the moment
      // anyone changes User= — and this program finds BOTH its config and claude's
      // credentials under it, so a wrong HOME is a runner that enrols and then
      // cannot log in, which reads as a broken login rather than a wrong unit.
      //
      // ⚠ And HUGINN_DEVICE_DIR with it, pinned to the directory THIS invocation
      // actually used. It relocates both device.json and appd-token, so
      // `HUGINN_DEVICE_DIR=/etc/huginn huginn-device on` followed by the very
      // next line this tool prints produced a service reading ~/.config/huginn:
      // no config, no token. serve() treats that as transient and loops at 15s
      // forever, so the process never exits, Restart=always never fires, and
      // systemd reports the unit perfectly healthy while it does nothing at all.
      console.log(system
        ? `# /etc/systemd/system/huginn-device.service
# A whole machine offering itself, not one person's session: no lingering to
# arrange, and it is up before anyone logs in. This is the headless shape.
[Unit]
Description=Offer this machine to Huginn as a place to run work
After=network-online.target

[Service]
ExecStart=${process.execPath} ${self} serve
User=${who.username}
Environment=HOME=${who.homedir}
Environment=HUGINN_DEVICE_DIR=${CONF_DIR}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target`
        : `# ~/.config/systemd/user/huginn-device.service
# One person's session. Needs \`loginctl enable-linger ${who.username}\` to
# survive logout \u2014 on a machine with nobody logging in, use: huginn-device unit --system
[Unit]
Description=Offer this machine to Huginn as a place to run work
After=network-online.target

[Service]
ExecStart=${process.execPath} ${self} serve
Environment=HOME=${who.homedir}
Environment=HUGINN_DEVICE_DIR=${CONF_DIR}
Restart=always
RestartSec=10

[Install]
WantedBy=default.target`);
      break;
    }
    case 'print-argv': {
      // For scripts/test-device-policy.sh: this runner, driven over the shared case
      // matrix, so it and the Kotlin one are held to the same table.
      // Optional 4th arg: a JSON object {model, effort, resumeSessionId, persona}
      // merged into the work item, so the persona/effort-exclusion rules for
      // generate mode can be driven from the outside like everything else.
      const [scope, lockedArg, mode, extraJson] = process.argv.slice(3);
      const lock = lockedArg === 'true' || lockedArg === '1';
      const extra = extraJson ? JSON.parse(extraJson) : {};
      const work = {
        id: 'w', chatId: 'c', prompt: 'p', mode,
        model: extra.model, effort: extra.effort, resumeSessionId: extra.resumeSessionId,
      };
      process.stdout.write(JSON.stringify({
        effectiveScope: effectiveScope(scope, lock),
        refusal: refusal(scope, lock, mode),
        engineRefusal: engineRefusal(mode, extra.hasEngine === true),
        argv: argvFor(work, scope, lock, extra.persona),
        cwd: cwdFor(scope, lock, '/root-dir') === '/root-dir' ? 'root' : 'home',
      }));
      break;
    }
    case 'version': console.log(VERSION); break;
    default:
      console.log(`huginn-device ${VERSION} — offer this machine to Huginn.

  huginn-device on [--scope look|work|own] [--root DIR] [--url URL]
                              enrol this machine and save the settings
  huginn-device off           stop offering it (and stop the service)
  huginn-device serve         the runner itself; this is what systemd starts
  huginn-device status        what this machine offers, and what huginn sees
  huginn-device unit          print a systemd USER unit (one person's session)
  huginn-device unit --system print a systemd SYSTEM unit (a headless machine)

  Settings:  ${CONF_FILE}
  Token:     ${TOKEN_FILE}   (0600; the same token /etc/huginn-appd/token holds)`);
  }
}

// Run when invoked, importable when not.
//
// ⚠ SO THE SIZE RULES CAN BE TESTED. batchLines/shrinkLine decide whether a
// run's whole answer survives, and until this guard existed there was no way to
// call them without also starting a runner — so the one part of this file that
// silently destroyed output was the part nothing could reach.
if (require.main === module) {
  main().catch((e) => { console.error(`huginn-device: ${e.message}`); process.exit(1); });
} else {
  module.exports = {
    VERSION, MAX_LINE_BYTES, MAX_BATCH_BYTES,
    shrinkLine, batchLines, parseFlags, tokenOrWhy, cwdFor, effectiveScope, allows, argvFor,
    engineRefusal, execFor,
  };
}
