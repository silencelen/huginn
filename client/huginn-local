  <env name="HUGINN_LOCAL_DIR" value="${dir}"/>
  <onfailure action="restart" delay="10 sec"/>
  <log mode="roll-by-size"><sizeThreshold>10240</sizeThreshold><keepFiles>4</keepFiles></log>
</service>
`;
}

function sysctl(args, { user = false } = {}) {
  const base = user ? ['--user'] : [];
  return spawnSync('systemctl', [...base, ...args], { encoding: 'utf8' });
}

function installServiceLinux(which, { system }) {
  const name = which === 'llm' ? LLM_SERVICE : RUNNER_SERVICE;
  const file = system
    ? `/etc/systemd/system/${name}.service`
    : path.join(os.homedir(), '.config', 'systemd', 'user', `${name}.service`);
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, unitText(which, { system }));
  let r = sysctl(['daemon-reload'], { user: !system });
  if (r.status !== 0) throw new Error(`daemon-reload failed: ${r.stderr}`);
  r = sysctl(['enable', '--now', name], { user: !system });
  if (r.status !== 0) throw new Error(`enable --now ${name} failed: ${r.stderr}\nManual: systemctl ${system ? '' : '--user '}enable --now ${name}`);
  console.log(`  service ${name} enabled (${file})`);
}

function installServiceWindows(which) {
  const name = which === 'llm' ? LLM_SERVICE : RUNNER_SERVICE;
  const dir = P('runtime', 'winsw');
  fs.mkdirSync(dir, { recursive: true });
  const exe = path.join(dir, `${name}.exe`);
  fs.copyFileSync(P('runtime', 'WinSW-x64.exe'), exe);
  fs.writeFileSync(path.join(dir, `${name}.xml`), winswXml(which));
  let r = spawnSync(exe, ['install'], { encoding: 'utf8' });
  if (r.status !== 0 && !/already exists/i.test(r.stderr + r.stdout)) {
    throw new Error(`WinSW install ${name} failed: ${r.stderr || r.stdout}`);
  }
  r = spawnSync(exe, ['start'], { encoding: 'utf8' });
  if (r.status !== 0 && !/already.*started|already running/i.test(r.stderr + r.stdout)) {
    throw new Error(`WinSW start ${name} failed: ${r.stderr || r.stdout}`);
  }
  console.log(`  service ${name} installed + started (WinSW, LocalSystem)`);
}

function serviceState(which, conf) {
  const name = which === 'llm' ? LLM_SERVICE : RUNNER_SERVICE;
  if (process.platform === 'win32') {
    const exe = P('runtime', 'winsw', `${name}.exe`);
    if (!fs.existsSync(exe)) return 'not installed';
    const r = spawnSync(exe, ['status'], { encoding: 'utf8' });
    return (r.stdout || '').trim() || 'unknown';
  }
  const r = sysctl(['is-active', name], { user: !(conf && conf.systemUnits) });
  return (r.stdout || '').trim() || 'not installed';
}

// ----------------------------------------------------------------- health

function getJson(url, key) {
  return new Promise((resolve) => {
    const mod = url.startsWith('https:') ? https : http;
    const req = mod.get(url, { headers: key ? { authorization: `Bearer ${key}` } : {} }, (res) => {
      let text = '';
      res.setEncoding('utf8');
      res.on('data', (c) => { if (text.length < 65536) text += c; });
      res.on('end', () => {
        try { resolve({ status: res.statusCode, body: JSON.parse(text) }); }
        catch { resolve({ status: res.statusCode, body: null }); }
      });
    });
    req.on('error', (e) => resolve({ status: 0, error: e.message }));
    req.setTimeout(8000, () => { req.destroy(); resolve({ status: 0, error: 'timeout' }); });
  });
}

/**
 * Health means reading the model-list BODY and requiring it nonempty — never a
 * TCP connect (the empty-daemon trap: a healthy-looking endpoint serving
 * nothing). Auth is asserted, not assumed: a keyless completions request must
 * be refused, or the loopback bind is the only fence and that is said.
 */
async function health(conf) {
  const base = conf.mode === 'adapter' ? conf.adapter.url : `http://127.0.0.1:${conf.port}`;
  const key = conf.mode === 'adapter' ? (conf.adapter.key || null) : readKey();
  const listPath = conf.mode === 'adapter' && conf.adapter.kind === 'ollama' ? '/api/tags' : '/v1/models';
  const r = await getJson(base + listPath, key);
  const list = r.body && (r.body.data || r.body.models);
  const names = Array.isArray(list)
    ? list.map((m) => m.id || m.name || m.model).filter(Boolean) : [];
  return { reachable: r.status > 0, status: r.status, models: names, base };
}

// -------------------------------------------------------------- enrolment

function runnerPath() {
  const machine = P('bin', 'huginn-device.js');
  if (fs.existsSync(machine)) return machine;
  return path.join(os.homedir(), '.huginn', 'huginn-device');
}

function enrolDevice(conf, models) {
  const devDir = P('device');
  fs.mkdirSync(devDir, { recursive: true });
  const devConf = path.join(devDir, 'device.json');
  let existing = {};
  try { existing = JSON.parse(fs.readFileSync(devConf, 'utf8')); } catch { /* fresh */ }
  // Scope is seeded in the CONFIG, deliberately not passed as a flag: the
  // enrol verb refuses `--scope generate` from a hand (a typo'd claude
  // enrolment must never land on the serving rung); this file is how `huginn
  // local on` says it on purpose.
  fs.writeFileSync(devConf, JSON.stringify({
    ...existing,
    url: conf.url,
    name: conf.deviceName,
    scope: 'generate',
    // The ENGINE knob: generate work spawns conf.llm (the shim), never
    // conf.claude — the runner's engine dispatch is by mode, and this row's
    // scope refuses every claude mode anyway.
    llm: P('bin', 'huginn-llm-shim.js'),
    models: models.map((m) => ({ slug: m.slug, display: m.display })),
  }, null, 2) + '\n', { mode: 0o600 });
  const r = spawnSync(process.execPath, [runnerPath(), 'on'], {
    encoding: 'utf8',
    env: { ...process.env, HUGINN_DEVICE_DIR: devDir },
  });
  process.stdout.write(r.stdout || '');
  process.stderr.write(r.stderr || '');
  if (r.status !== 0) throw new Error('enrolment failed — see above; the services are installed but this machine is not offered to huginn yet');
  const after = JSON.parse(fs.readFileSync(devConf, 'utf8'));
  return { llmSlug: after.llmSlug || null, id: after.id || null };
}

// -------------------------------------------------------------------- on

async function cmdOn(flags) {
  if (!MANIFEST) { console.error('this file was not generated correctly — run: node scripts/gen-local-manifest.js'); process.exit(2); }
  const det = detectClass();
  if (det.refuse && !flags.adapter) { console.error(`refused: ${det.refuse}`); process.exit(1); }
  if (flags.class) {
    const order = { A: 0, C: 1, G8: 2, G16: 3 };
    if (!(flags.class in order)) { console.error(`unknown class "${flags.class}" — one of: G8, G16, C, A`); process.exit(2); }
    if (!det.refuse && order[flags.class] > order[det.cls]) {
      console.error(`--class may narrow, never widen: detected ${det.cls}, asked for ${flags.class}`);
      process.exit(1);
    }
    det.cls = flags.class; det.plan = flags.class === 'G16' ? 'G8' : flags.class;
  }
  const hostname = os.hostname().toLowerCase().replace(/[^a-z0-9-]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '').slice(0, 34) || 'machine';
  const conf = loadConf() || {};
  conf.deviceName = flags.name || conf.deviceName || `${hostname}-llm`;
  conf.url = flags.url || conf.url;
  if (!conf.url) { console.error('no daemon url — the shell wrapper passes --url (run: huginn local on)'); process.exit(2); }

  if (flags.adapter) {
    // ---- adapter mode: wrap what already serves; install nothing heavy
    const kind = String(flags.adapter).toLowerCase();
    if (!['ollama', 'lmstudio'].includes(kind)) { console.error(`unknown adapter "${flags.adapter}" — ollama or lmstudio`); process.exit(2); }
    const url = flags['adapter-url'] || (kind === 'ollama' ? 'http://127.0.0.1:11434' : 'http://127.0.0.1:1234');
    const host = new URL(url).hostname;
    if (!['127.0.0.1', 'localhost', '::1'].includes(host)) {
      console.error(`refused: the adapter must be on loopback (got ${host}) — the local tier's contract is loopback-only`);
      process.exit(1);
    }
    conf.mode = 'adapter';
    conf.adapter = { kind, url, key: flags['adapter-key'] || null };
    const h = await health(conf);
    if (!h.models.length) {
      console.error(`refused: ${url} ${h.reachable ? `answered but serves NO models — an alive endpoint with an empty list is the trap, not a healthy install` : `is not answering (${h.error || h.status})`}`);
      process.exit(1);
    }
    conf.class = det.refuse ? 'adapter' : det.cls;
    conf.modelsBySlug = {};
    const models = h.models.slice(0, 16).map((n) => {
      const slug = n.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 30);
      conf.modelsBySlug[slug] = { file: n, display: n };
      return { slug, display: n };
    });
    conf.defaultModel = models[0].slug;
    console.log(`adapter ${kind} at ${url}: ${h.models.length} model(s) — ${h.models.slice(0, 4).join(', ')}${h.models.length > 4 ? ', …' : ''}`);
    installShimCopy();
    if (!flags.yes && !(await consent(`Wrap the existing ${kind} at ${url}, install the runner service, and offer "${conf.deviceName}" to huginn at ${conf.url}?`))) process.exit(1);
    saveConf(conf);
    // Enrol before the runner service starts — see the managed branch: the
    // service's own enrolment must find the id already on disk.
    const e = enrolDevice(conf, models);
    conf.llmSlug = e.llmSlug; saveConf(conf);
    installRunnerService(flags);
    console.log(`\nOn. ${conf.deviceName} serves ${models.length} adapter model(s) to huginn.`);
    return;
  }

  // ---- managed mode
  const plan = planFor(det);
  if (plan.error) { console.error(`refused: ${plan.error}`); process.exit(1); }
  const needBytes = plan.downloads.reduce((s, d) => s + d.bytes, 0);
  const gate = diskGate(needBytes, freeBytes());
  console.log(`class ${det.cls}${det.cls !== plan.plan ? ` (serving the ${plan.plan} plan)` : ''}${det.gpu ? ` — GPU ${det.gpu.name} (${det.gpu.uuid})` : ''}`);
  if (det.note) console.log(`  ${det.note}`);
  console.log(`  ${gate.line}`);
  if (!gate.ok) { console.error('refused: not enough disk'); process.exit(1); }

  console.log('\nThe plan:');
  for (const d of plan.downloads) console.log(`  ${(d.bytes / (1024 * 1024)).toFixed(0).padStart(6)} MB  ${d.name}`);
  console.log(`  services ${LLM_SERVICE} + ${RUNNER_SERVICE}${process.platform === 'win32' ? ' (WinSW, LocalSystem)' : (flags.system ? ' (systemd, system)' : ' (systemd, user — needs linger)')}`);
  console.log(`  llama-swap on 127.0.0.1:8748, api key at ${P('api-key')} — loopback only, authenticated`);
  console.log(`  device row "${conf.deviceName}" at scope generate → ${conf.url}`);
  if (!flags.yes && !(await consent('Install all of the above?'))) process.exit(1);

  conf.mode = 'managed';
  conf.class = det.cls;
  conf.port = 8748;
  conf.gpuUuid = flags['gpu-uuid'] || (det.gpu ? det.gpu.uuid : null);
  conf.systemUnits = process.platform === 'win32' ? true : !!flags.system;

  // 1-2: fetch + verify + unpack runtimes
  for (const d of plan.downloads.filter((x) => x.kind !== 'model')) {
    const file = await fetchVerified(d, P('runtime', '.dl'));
    if (d.kind === 'llama') unpack(file, P('runtime', `llama-${MANIFEST.llamaCpp.release}`));
    if (d.kind === 'cudart') unpack(file, path.dirname(serverBinaryPath()));
    if (d.kind === 'swap') unpack(file, P('runtime', `llama-swap-${MANIFEST.llamaSwap.version}`));
    if (d.kind === 'winsw') fs.copyFileSync(file, P('runtime', 'WinSW-x64.exe'));
  }
  // The win zip is flat; the linux tar carries a version dir — normalise so
  // serverBinaryPath() resolves on both.
  if (process.platform === 'win32') {
    const flat = P('runtime', `llama-${MANIFEST.llamaCpp.release}`, 'llama-server.exe');
    if (!fs.existsSync(flat)) throw new Error('llama-server.exe not found after unpack — the archive layout changed; refuse and re-pin');
  } else if (!fs.existsSync(serverBinaryPath())) {
    throw new Error('llama-server not found after unpack — the archive layout changed; refuse and re-pin');
  }
  // 3: models
  for (const d of plan.downloads.filter((x) => x.kind === 'model')) await fetchVerified(d, P('models'));
  // 4: key + config + yaml
  mintKey();
  conf.modelsBySlug = {};
  for (const m of plan.models) conf.modelsBySlug[m.slug] = { file: m.file, display: m.display, ctx: m.ctx, gpu: m.gpu };
  conf.defaultModel = plan.models.find((m) => m.role === 'chat').slug;
  fs.writeFileSync(P('llama-swap.yaml'), swapYamlFor(conf, plan.models));
  installShimCopy();
  saveConf(conf);
  // 5: services
  if (process.platform === 'win32') { installServiceWindows('llm'); } else { installServiceLinux('llm', { system: !!flags.system }); }
  // 6: health, honestly
  let h = null;
  for (let i = 0; i < 30; i++) { h = await health(conf); if (h.models.length) break; await new Promise((r) => setTimeout(r, 2000)); }
  if (!h.models.length) throw new Error(`the model server came up but lists no models (${JSON.stringify(h)}) — NOT healthy; fix before enrolling`);
  console.log(`  serving ${h.models.join(', ')}`);
  const keyless = await getJson(`http://127.0.0.1:${conf.port}/v1/models`, null);
  if (keyless.status === 200) console.log('  note: the front door answers without the key on the model LIST; completions are key-gated by llama-server itself');
  // 7: enrol FIRST, then start the runner service. The service's own poll loop
  // also enrols, and starting it before the id exists races two registrations
  // into two device rows — found live on the first real install: the second
  // enrolment saw the first one's slug as taken and hash-suffixed itself.
  const e = enrolDevice(conf, plan.models);
  installRunnerService(flags);
  conf.llmSlug = e.llmSlug;
  conf.installed = {
    llamaTag: MANIFEST.llamaCpp.release, swapVersion: MANIFEST.llamaSwap.version,
    models: plan.models.map((m) => m.slug), manifestHash: manifestHash(),
  };
  saveConf(conf);
  console.log(`\nOn. class ${conf.class}, ${plan.models.length} model(s), device "${conf.deviceName}"${conf.llmSlug ? ` (slug ${conf.llmSlug})` : ''}.`);
}

function installShimCopy() {
  const src = process.env.HUGINN_SHIM_SOURCE || path.join(os.homedir(), '.huginn', 'huginn-llm-shim');
  if (!fs.existsSync(src)) throw new Error(`the shim is not at ${src} — run through the shell wrapper (huginn local on), which fetches it`);
  fs.mkdirSync(P('bin'), { recursive: true });
  fs.copyFileSync(src, P('bin', 'huginn-llm-shim.js'));
  const runnerSrc = path.join(os.homedir(), '.huginn', 'huginn-device');
  if (fs.existsSync(runnerSrc)) fs.copyFileSync(runnerSrc, P('bin', 'huginn-device.js'));
}

function installRunnerService(flags) {
  if (process.platform === 'win32') installServiceWindows('runner');
  else installServiceLinux('runner', { system: !!flags.system });
}

function consent(question) {
  return new Promise((resolve) => {
    process.stdout.write(`${question} [y/N] `);
    process.stdin.setEncoding('utf8');
    process.stdin.once('data', (d) => { process.stdin.pause(); resolve(/^y(es)?$/i.test(String(d).trim())); });
  });
}

function manifestHash() {
  return crypto.createHash('sha256').update(JSON.stringify(MANIFEST)).digest('hex').slice(0, 16);
}

// ------------------------------------------------------------------- off

async function cmdOff(flags) {
  const conf = loadConf();
  if (!conf) { console.error('not set up — nothing to turn off'); process.exit(1); }
  let failed = 0;
  const step = (name, fn) => {
    try { fn(); console.log(`  ok      ${name}`); }
    catch (e) { failed += 1; console.error(`  FAILED  ${name}: ${e.message}`); }
  };
  // Runner first, so nothing re-enrols while the rest comes down.
  if (process.platform === 'win32') {
    for (const which of ['runner', 'llm']) {
      const name = which === 'runner' ? RUNNER_SERVICE : LLM_SERVICE;
      const exe = P('runtime', 'winsw', `${name}.exe`);
      if (fs.existsSync(exe)) {
        step(`stop ${name}`, () => { const r = spawnSync(exe, ['stop'], { encoding: 'utf8' }); if (r.status !== 0 && !/not.*started|stopped/i.test(r.stderr + r.stdout)) throw new Error(r.stderr || r.stdout); });
        step(`uninstall ${name}`, () => { const r = spawnSync(exe, ['uninstall'], { encoding: 'utf8' }); if (r.status !== 0) throw new Error(r.stderr || r.stdout); });
      }
    }
  } else {
    for (const name of [RUNNER_SERVICE, LLM_SERVICE]) {
      step(`disable ${name}`, () => {
        const r = sysctl(['disable', '--now', name], { user: !conf.systemUnits });
        if (r.status !== 0 && !/does not exist|not loaded/i.test(r.stderr)) throw new Error(r.stderr.trim());
      });
    }
  }
  // Deregister — inherits the device-off honesty: a DELETE failure keeps the
  // id and exits nonzero, and this command then does NOT proceed to deletions.
  const r = spawnSync(process.execPath, [runnerPath(), 'off'], {
    encoding: 'utf8', env: { ...process.env, HUGINN_DEVICE_DIR: P('device') },
  });
  process.stdout.write(r.stdout || ''); process.stderr.write(r.stderr || '');
  if (r.status !== 0) {
    console.error('\nStill enrolled at the daemon — services are down; run `huginn local off` again when huginn is reachable.');
    process.exit(1);
  }
  if (flags['purge-models']) {
    if (!flags.yes) {
      const sure = await new Promise((res) => {
        process.stdout.write(`Type "delete" to remove ${P('models')} and ${P('sessions')}: `);
        process.stdin.setEncoding('utf8');
        process.stdin.once('data', (d) => { process.stdin.pause(); res(String(d).trim() === 'delete'); });
      });
      if (!sure) { console.log('kept the models.'); process.exit(failed ? 1 : 0); }
    }
    step('purge models + sessions', () => { fs.rmSync(P('models'), { recursive: true, force: true }); fs.rmSync(P('sessions'), { recursive: true, force: true }); });
  } else {
    let kept = 0;
    try { kept = fs.readdirSync(P('models')).length; } catch { /* none */ }
    if (kept) console.log(`off, not gone: ${kept} model file(s) remain at ${P('models')} — remove with: huginn local off --purge-models`);
  }
  if (failed) { console.error(`\n${failed} step(s) failed — NOT fully off.`); process.exit(1); }
  console.log('\nOff.');
}

// ---------------------------------------------------------------- status

async function statusInfo() {
  const conf = loadConf();
  if (!conf) return { setup: false };
  const h = await health(conf).catch(() => ({ reachable: false, models: [] }));
  let shimVersion = null;
  try {
    const r = spawnSync(process.execPath, [P('bin', 'huginn-llm-shim.js'), '--version'], { encoding: 'utf8' });
    shimVersion = (r.stdout || '').trim() || null;
  } catch { /* absent */ }
  let sessions = 0;
  try { sessions = fs.readdirSync(P('sessions')).length; } catch { /* none */ }
  return {
    setup: true,
    mode: conf.mode, class: conf.class, deviceName: conf.deviceName, llmSlug: conf.llmSlug || null,
    port: conf.port || null, adapter: conf.adapter || null,
    services: { llm: conf.mode === 'adapter' ? 'n/a (adapter)' : serviceState('llm', conf), runner: serviceState('runner', conf) },
    engine: { reachable: h.reachable, models: h.models, base: h.base },
    models: Object.keys(conf.modelsBySlug || {}),
    defaultModel: conf.defaultModel || null,
    shimVersion,
    sessions,
    installed: conf.installed || null,
  };
}

async function cmdStatus(flags) {
  const s = await statusInfo();
  if (flags.json) { process.stdout.write(JSON.stringify(s) + '\n'); return; }
  if (!s.setup) { console.log('not set up — run: huginn local on'); return; }
  console.log(`mode        ${s.mode} (class ${s.class})`);
  console.log(`device      ${s.deviceName}${s.llmSlug ? ` (slug ${s.llmSlug})` : ''}`);
  console.log(`services    llm: ${s.services.llm} · runner: ${s.services.runner}`);
  console.log(`engine      ${s.engine.reachable ? `serving ${s.engine.models.length} model(s): ${s.engine.models.join(', ')}` : 'NOT ANSWERING'} at ${s.engine.base || '?'}`);
  console.log(`shim        ${s.shimVersion || 'not installed'}`);
  console.log(`sessions    ${s.sessions} file(s)`);
  if (s.installed) console.log(`pins        llama.cpp ${s.installed.llamaTag} · llama-swap ${s.installed.swapVersion} · manifest ${s.installed.manifestHash}`);
}

// ---------------------------------------------------------------- update

async function cmdUpdate(flags) {
  if (!MANIFEST) { console.error('this file was not generated correctly'); process.exit(2); }
  const conf = loadConf();
  if (!conf) { console.error('not set up — run: huginn local on'); process.exit(1); }
  installShimCopy();
  console.log('  shim + runner copies refreshed from ~/.huginn');
  if (conf.mode === 'adapter') { console.log('adapter mode: nothing else to update.'); return; }
  if (conf.installed && conf.installed.manifestHash === manifestHash()) {
    console.log(`pins unchanged (manifest ${manifestHash()}) — done.`);
    return;
  }
  console.log(`pins changed: ${conf.installed ? conf.installed.manifestHash : '(none)'} → ${manifestHash()}`);
  const det = detectClass();
  det.cls = conf.class; det.plan = conf.class === 'G16' ? 'G8' : conf.class;
  const plan = planFor(det);
  if (plan.error) { console.error(`refused: ${plan.error}`); process.exit(1); }
  const needBytes = plan.downloads.reduce((s, d) => s + d.bytes, 0);
  const gate = diskGate(needBytes, freeBytes());
  console.log(`  ${gate.line}`);
  if (!gate.ok) { console.error('refused: not enough disk'); process.exit(1); }
  if (!flags.yes && !(await consent('Download and switch to the new pins?'))) process.exit(1);
  for (const d of plan.downloads.filter((x) => x.kind !== 'model')) {
    const file = await fetchVerified(d, P('runtime', '.dl'));
    if (d.kind === 'llama') unpack(file, P('runtime', `llama-${MANIFEST.llamaCpp.release}`));
    if (d.kind === 'cudart') unpack(file, path.dirname(serverBinaryPath()));
    if (d.kind === 'swap') unpack(file, P('runtime', `llama-swap-${MANIFEST.llamaSwap.version}`));
    if (d.kind === 'winsw') fs.copyFileSync(file, P('runtime', 'WinSW-x64.exe'));
  }
  for (const d of plan.downloads.filter((x) => x.kind === 'model')) await fetchVerified(d, P('models'));
  conf.modelsBySlug = {};
  for (const m of plan.models) conf.modelsBySlug[m.slug] = { file: m.file, display: m.display, ctx: m.ctx, gpu: m.gpu };
  conf.defaultModel = plan.models.find((m) => m.role === 'chat').slug;
  fs.writeFileSync(P('llama-swap.yaml'), swapYamlFor(conf, plan.models));
  if (process.platform === 'win32') {
    const exe = P('runtime', 'winsw', `${LLM_SERVICE}.exe`);
    spawnSync(exe, ['restart'], { encoding: 'utf8' });
  } else {
    sysctl(['restart', LLM_SERVICE], { user: !conf.systemUnits });
  }
  let h = null;
  for (let i = 0; i < 30; i++) { h = await health(conf); if (h.models.length) break; await new Promise((r) => setTimeout(r, 2000)); }
  if (!h.models.length) { console.error('the updated server lists NO models — the previous runtime generation is still on disk; investigate before deleting anything'); process.exit(1); }
  conf.installed = { llamaTag: MANIFEST.llamaCpp.release, swapVersion: MANIFEST.llamaSwap.version, models: plan.models.map((m) => m.slug), manifestHash: manifestHash() };
  saveConf(conf);
  console.log(`updated: serving ${h.models.join(', ')}`);
}

// ---------------------------------------------------------------- doctor

async function cmdDoctor() {
  const s = await statusInfo();
  if (!s.setup) { console.log('not set up.'); return; }
  await cmdStatus({});
  console.log('\ndoctor:');
  const shim = P('bin', 'huginn-llm-shim.js');
  const r = spawnSync(process.execPath, [shim, '--contract-check'], { encoding: 'utf8' });
  const frames = (r.stdout || '').trim().split('\n').filter(Boolean);
  const okShape = r.status === 0 && frames.length >= 3
    && frames[0].includes('"subtype":"init"') && frames[frames.length - 1].includes('"type":"result"');
  console.log(`  ${okShape ? 'ok    ' : 'FAIL  '}shim --contract-check (${frames.length} frames)`);
  const gate = diskGate(0, freeBytes());
  console.log(`  ok    disk: ${gate.line}`);
  const g = gpus();
  console.log(`  ok    gpu: ${g.length ? g.map((x) => `${x.name} ${Math.round(x.memMiB / 1024)}GiB`).join(', ') : 'none visible'}`);
  for (const [kind, url] of [['ollama', 'http://127.0.0.1:11434/api/tags'], ['lmstudio', 'http://127.0.0.1:1234/v1/models']]) {
    const probe = await getJson(url, null);
    const list = probe.body && (probe.body.models || probe.body.data);
    if (Array.isArray(list)) console.log(`  note  an existing ${kind} serves ${list.length} model(s) here — adapter mode can wrap it`);
  }
}

// ------------------------------------------------------------------- main

function usage() {
  console.log(`huginn-local ${VERSION} — serve local AI models to Huginn from this machine.

  huginn local on     [--class G8|G16|C|A] [--gpu-uuid U] [--name N] [--yes] [--system]
                      [--adapter ollama|lmstudio [--adapter-url URL] [--adapter-key K]]
  huginn local off    [--purge-models] [--yes]
  huginn local status [--json]
  huginn local unit   [--system] [--which llm|runner]
  huginn local update [--yes]
  huginn local doctor`);
}

async function main() {
  const cmd = process.argv[2];
  const rest = process.argv.slice(3);
  const known = ['class', 'gpu-uuid', 'name', 'url', 'yes', 'system', 'json', 'adapter', 'adapter-url', 'adapter-key', 'purge-models', 'which'];
  const parsed = parseFlags(rest, known);
  if (parsed.error) { console.error(`huginn-local ${cmd || ''}: ${parsed.error}`); process.exit(2); }
  const flags = parsed.flags;
  switch (cmd) {
    case 'on': await cmdOn(flags); break;
    case 'off': await cmdOff(flags); break;
    case 'status': await cmdStatus(flags); break;
    case 'update': await cmdUpdate(flags); break;
    case 'doctor': await cmdDoctor(flags); break;
    case 'unit': {
      const which = flags.which || 'llm';
      if (!['llm', 'runner'].includes(which)) { console.error('--which llm|runner'); process.exit(2); }
      process.stdout.write(unitText(which, { system: !!flags.system }));
      break;
    }
    case 'version': console.log(VERSION); break;
    default: usage(); process.exit(cmd ? 2 : 0);
  }
}

if (require.main === module) {
  main().catch((e) => { console.error(`huginn-local: ${e.message}`); process.exit(1); });
} else {
  module.exports = {
    VERSION, MANIFEST, parseFlags, detectClass, planFor, diskGate, swapYamlFor,
    unitText, winswXml, mintKey, localDir, statusInfo, manifestHash,
    LLM_SERVICE, RUNNER_SERVICE,
  };
}
