/**
 * The human whose machine this is — the unit's `User=`, and the subject of
 * linger.
 *
 * Under an elevation the process user is root, and `os.userInfo()` would name
 * root: that installs a model server running as root and enables linger for an
 * account that has no session. Both are wrong in a way nothing would ever
 * report, so the invoking identity is carried explicitly and the two
 * elevators' own breadcrumbs are the fallbacks.
 */
function serviceUser() {
  const named = process.env.HUGINN_LOCAL_USER || process.env.SUDO_USER || null;
  if (named && named !== 'root') return named;
  if (process.env.PKEXEC_UID) {
    const r = RUN('id', ['-nu', String(process.env.PKEXEC_UID)]);
    const who = String((r && r.stdout) || '').trim();
