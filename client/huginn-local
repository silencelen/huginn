// -------------------------------------------------------------- detection

function gpus() {
  const r = RUN('nvidia-smi', ['--query-gpu=memory.total,uuid,name', '--format=csv,noheader,nounits']);
  if (r.error || r.status !== 0) return [];
  return r.stdout.trim().split('\n').filter(Boolean).map((l) => {
    const [mem, uuid, ...name] = l.split(',').map((s) => s.trim());
    return { memMiB: Number(mem) || 0, uuid, name: name.join(',') };
  });
}

function hasAvx2() {
  if (process.platform !== 'linux') return true; // probed by the binary itself at validate time
  try { return /\bavx2\b/.test(fs.readFileSync('/proc/cpuinfo', 'utf8')); } catch { return false; }
}

const GIB = 1024 * 1024 * 1024;

/**
 * The chosen device and class are ALWAYS printed; a refusal names the floor
 * that failed. `--class` may narrow, never widen. G16 hardware is reported but
 * installs the G8 plan (no 14B row ships until a real G16 use exists).
 */
function detectClass(env = {}) {
  const g = env.gpus ?? gpus();
  const ram = env.ram ?? os.totalmem();
  const arch = env.arch ?? process.arch;
  const platform = env.platform ?? process.platform;
  const avx2 = env.avx2 ?? hasAvx2();
  const big = g.filter((x) => x.memMiB >= 7680);
  if (big.length >= 2) return { cls: 'G16', plan: 'G8', gpu: big[0], platform, note: 'two capable GPUs found; serving the G8 plan on one card (no 14B row is pinned yet)' };
  if (big.length === 1) return { cls: 'G8', plan: 'G8', gpu: big[0], platform };
  if (g.length) {
    return { refuse: `a GPU is present (${g[0].name}, ${Math.round(g[0].memMiB / 1024)} GiB) but below the 7.5 GiB floor — CPU classes need AVX2 x86 or arm64 with enough RAM` };
  }
  if (arch === 'arm64') {
    return ram >= 7 * GIB ? { cls: 'A', plan: 'A', platform }
      : { refuse: `arm64 with ${(ram / GIB).toFixed(1)} GiB RAM is below the 7 GiB floor for the A class` };
  }
  if (arch === 'x64') {
    if (!avx2) return { refuse: 'this CPU has no AVX2, which the pinned llama-server build requires — the local tier refuses rather than degrades' };
    return ram >= 7.5 * GIB ? { cls: 'C', plan: 'C', platform }
      : { refuse: `x86 with ${(ram / GIB).toFixed(1)} GiB RAM is below the 7.5 GiB floor for the C class` };
  }
  return { refuse: `unsupported architecture "${arch}"` };
}

/** Which runtime assets this platform+plan needs. Linux GPU is refused honestly. */
function planFor(det, manifest = MANIFEST) {
  const plan = det.plan;
  const models = manifest.models[plan];
  if (!models) return { error: `no pinned models for class ${plan}` };
  const wantGpu = plan.startsWith('G');
  let llamaKey;
  if (process.platform === 'win32') llamaKey = wantGpu ? 'win-x64-cuda' : 'win-x64-cpu';
  else if (process.platform === 'linux') {
    if (wantGpu) return { error: 'no pinned CUDA build exists for Linux yet — GPU serving is Windows-only in this release' };
    llamaKey = process.arch === 'arm64' ? 'linux-arm64' : 'linux-x64';
  } else return { error: `unsupported platform "${process.platform}"` };
  const swapKey = process.platform === 'win32' ? 'win-x64' : (process.arch === 'arm64' ? 'linux-arm64' : 'linux-x64');
  const downloads = [
    { kind: 'llama', ...manifest.llamaCpp.assets[llamaKey], url: manifest.llamaCpp.urlBase + manifest.llamaCpp.assets[llamaKey].name },
    ...(llamaKey === 'win-x64-cuda'
      ? [{ kind: 'cudart', ...manifest.llamaCpp.assets['win-cudart'], url: manifest.llamaCpp.urlBase + manifest.llamaCpp.assets['win-cudart'].name }]
      : []),
    { kind: 'swap', ...manifest.llamaSwap.assets[swapKey], url: manifest.llamaSwap.urlBase + manifest.llamaSwap.assets[swapKey].name },
    ...(process.platform === 'win32'
      ? [{ kind: 'winsw', name: 'WinSW-x64.exe', sha256: manifest.winsw.sha256, bytes: manifest.winsw.bytes, url: manifest.winsw.url }]
      : []),
    ...models.map((m) => ({ kind: 'model', name: m.file, sha256: m.sha256, bytes: m.bytes, url: `https://huggingface.co/${m.repo}/resolve/main/${m.file}` })),
  ];
  return { plan, models, downloads, llamaKey };
}

/** BEFORE any download: need + 2 GiB headroom, both numbers printed. */
function diskGate(needBytes, freeBytes) {
  const need = needBytes + 2 * GIB;
  return {
    ok: freeBytes >= need,
    line: `need ${(need / GIB).toFixed(1)} GiB (incl. 2 GiB headroom), have ${(freeBytes / GIB).toFixed(1)} GiB free at ${localDir()}`,
  };
}

/**
 * Free space where the tier WOULD live.
 *
 * ⚠ IT WALKS UP UNTIL SOMETHING EXISTS, and "unknown" is never read as "zero".
 * This used to statfs the local dir, fall back to its PARENT, and return 0 if
 * neither was there — and 0 fails the gate, so `huginn local plan` on a machine
 * that has installed nothing (which is the entire audience for `plan`: it is
 * documented as "what `on` would install here, without installing anything")
 * answered `have 0.0 GiB free … refused: not enough disk` and exited 1. On Linux
 * ~/.config usually exists and the one-step fallback hid it; on WINDOWS
 * %USERPROFILE%\.config typically does NOT exist until something creates it, and
 * Windows is a supported serving platform. Every ancestor is tried now, up to
 * the root, because the first one that exists is on the same filesystem the
 * install would land on.
 */
function freeBytes() {
  let dir = path.resolve(localDir());
  for (;;) {
    try { const s = fs.statfsSync(dir); return s.bavail * s.bsize; } catch { /* not there yet */ }
    const up = path.dirname(dir);
    // dirname() of a root is the root itself: that is the end of the walk, and
    // a filesystem whose root cannot be statfs'd is a machine with nothing to
    // report rather than a machine with no space.
    if (up === dir) return 0;
    dir = up;
  }
}

// ------------------------------------------------------------- downloads

function sha256File(file) {
  const h = crypto.createHash('sha256');
  const fd = fs.openSync(file, 'r');
  const buf = Buffer.alloc(4 * 1024 * 1024);
  let n;
  while ((n = fs.readSync(fd, buf, 0, buf.length)) > 0) h.update(buf.subarray(0, n));
  fs.closeSync(fd);
  return h.digest('hex');
}

function fetchToFile(url, dest, redirects = 0) {
  return new Promise((resolve, reject) => {
    if (redirects > 5) return reject(new Error(`too many redirects for ${url}`));
    const mod = url.startsWith('https:') ? https : http;
    mod.get(url, { headers: { 'user-agent': 'huginn-local' } }, (res) => {
      if ([301, 302, 303, 307, 308].includes(res.statusCode)) {
        res.resume();
        return resolve(fetchToFile(res.headers.location, dest, redirects + 1));
      }
      if (res.statusCode !== 200) { res.resume(); return reject(new Error(`${url} answered ${res.statusCode}`)); }
      const out = fs.createWriteStream(dest);
      const total = Number(res.headers['content-length'] || 0);
      let got = 0, lastPct = -10;
      res.on('data', (c) => {
        got += c.length;
        if (total) {
          const pct = Math.floor((got / total) * 100);
          if (pct >= lastPct + 10) { lastPct = pct; process.stdout.write(`\r    ${path.basename(dest)}: ${pct}%   `); }
        }
      });
      res.pipe(out);
      out.on('finish', () => { process.stdout.write('\r'); out.close(() => resolve()); });
      out.on('error', reject);
      res.on('error', reject);
    }).on('error', reject);
  });
}

/** Download to .dl.tmp, verify sha256 against the pin, then move into place. */
async function fetchVerified(d, destDir) {
  fs.mkdirSync(destDir, { recursive: true });
  const dest = path.join(destDir, d.name);
  if (fs.existsSync(dest) && sha256File(dest) === d.sha256) {
    console.log(`  kept    ${d.name} (already present, hash matches)`);
    return dest;
  }
  const tmp = dest + '.dl.tmp';
  console.log(`  fetch   ${d.name} (${(d.bytes / (1024 * 1024)).toFixed(0)} MB)`);
  await fetchToFile(d.url, tmp);
  const got = sha256File(tmp);
  if (got !== d.sha256) {
    fs.unlinkSync(tmp);
    throw new Error(`${d.name}: sha256 mismatch — expected ${d.sha256}, got ${got}. The pin refuses it; nothing was installed.`);
  }
  fs.renameSync(tmp, dest);
  console.log(`  ok      ${d.name} sha256 verified`);
  return dest;
}

function unpack(archive, destDir) {
  fs.mkdirSync(destDir, { recursive: true });
  if (archive.endsWith('.tar.gz')) {
    const r = spawnSync('tar', ['-xzf', archive, '-C', destDir], { encoding: 'utf8' });
    if (r.status !== 0) throw new Error(`tar failed on ${archive}: ${r.stderr}`);
  } else if (archive.endsWith('.zip')) {
    if (process.platform === 'win32') {
      const r = spawnSync('powershell.exe', ['-NoProfile', '-Command',
        `Expand-Archive -LiteralPath "${archive}" -DestinationPath "${destDir}" -Force`], { encoding: 'utf8' });
      if (r.status !== 0) throw new Error(`Expand-Archive failed on ${archive}: ${r.stderr}`);
    } else {
      const r = spawnSync('unzip', ['-oq', archive, '-d', destDir], { encoding: 'utf8' });
      if (r.status !== 0) throw new Error(`unzip failed on ${archive}: ${r.stderr}`);
    }
  } else {
    throw new Error(`no unpacker for ${archive}`);
  }
}

// -------------------------------------------------------------- llama-swap

function serverBinaryPath(manifest = MANIFEST) {
  const rel = manifest.llamaCpp.serverBinary[process.platform === 'win32' ? 'win32' : 'linux'];
  return path.join(P('runtime', `llama-${manifest.llamaCpp.release}`), rel);
}

function swapBinaryPath(manifest = MANIFEST) {
  const name = process.platform === 'win32' ? 'llama-swap.exe' : 'llama-swap';
  return path.join(P('runtime', `llama-swap-${manifest.llamaSwap.version}`), name);
}

/**
 * GENERATED — the banner says so in the file itself. One entry per pinned
 * model; the chat model gets the class TTL (VRAM is surrendered when idle —
 * the serving box may be somebody's gaming PC), the embedder a short one.
 */
function swapYamlFor(conf, models, manifest = MANIFEST) {
  const server = serverBinaryPath(manifest);
  const lines = [
    `# GENERATED by huginn-local v${VERSION} — do not hand-edit; regenerated by 'huginn local on|update'.`,
    'healthCheckTimeout: 300',
    'models:',
  ];
  for (const m of models) {
    const gpuArgs = m.gpu ? ' -ngl 99 --flash-attn on' : ' -ngl 0';
    // Chat models answer, they do not think out loud: verified live on b10628.
    const reason = m.role === 'chat' ? ' --reasoning off' : '';
    const env = (m.gpu && conf.gpuUuid) ? `\n    env:\n      - "CUDA_VISIBLE_DEVICES=${conf.gpuUuid}"` : '';
    const embed = m.role === 'embed' ? ' --embedding' : '';
    lines.push(
      `  "${m.slug}":`,
      `    name: "${m.display} - ${conf.deviceName || os.hostname()}"`,
      `    cmd: >`,
      `      ${server}`,
      `      --host 127.0.0.1 --port \${PORT}`,
      `      --api-key-file ${P('api-key')}`,
      `      -m ${P('models', m.file)}`,
      `      -c ${m.ctx}${gpuArgs}${reason}${embed}${env}`,
      `    ttl: ${m.role === 'embed' ? 300 : 900}`,
    );
  }
  return lines.join('\n') + '\n';
}

function mintKey() {
  const file = P('api-key');
  if (fs.existsSync(file) && fs.readFileSync(file, 'utf8').trim()) return file; // idempotent
  fs.mkdirSync(localDir(), { recursive: true });
  fs.writeFileSync(file, crypto.randomBytes(32).toString('hex') + '\n', { mode: 0o600 });
  if (process.platform === 'win32') {
    spawnSync('icacls', [file, '/inheritance:r', '/grant', 'SYSTEM:R', '/grant', 'Administrators:F'], { encoding: 'utf8' });
  }
  return file;
}

function readKey() {
  try { return fs.readFileSync(P('api-key'), 'utf8').trim() || null; } catch { return null; }
}

// --------------------------------------------------------------- services

const LLM_SERVICE = 'huginn-local-llm';
const RUNNER_SERVICE = 'huginn-local-runner';

/**
 * The engines adapter mode can WRAP — never install, never bundle (vendor
 * terms), never start.
 *
 * `llama-swap` is this tier's own stack, adopted rather than managed: a box
 * where somebody hand-edited llama-swap.yaml to add a model the pinned
 * manifest does not carry is a real machine in this fleet, and the choice is
 * between supporting that shape explicitly or having it stay off-book. It gets
 * the keyless-completions gate because it CAN clear it — llama-server takes an
 * --api-key-file. LM Studio and Ollama commonly run open on loopback, so the
 * same gate there would refuse every ordinary install; they keep the note.
 */
const ADAPTERS = {
  'llama-swap': { url: 'http://127.0.0.1:8748', keyGate: true },
  lmstudio: { url: 'http://127.0.0.1:1234', keyGate: false },
  ollama: { url: 'http://127.0.0.1:11434', keyGate: false },
};

/**
 * Both units pin HOME and HUGINN_LOCAL_DIR (and the runner HUGINN_DEVICE_DIR):
 * the device-unit lesson — a unit that pins HOME in a six-line comment and
 * then drops the variable that moves the same files produces a service that
 * loops forever while systemd reports it healthy.
 */
function unitText(which, { system = false, user = serviceUser(), home = os.homedir(), dir = localDir(), node = process.execPath, runner = path.join(os.homedir(), '.huginn', 'huginn-device'), manifest = MANIFEST } = {}) {
  if (which === 'llm') {
    return `[Unit]
Description=Huginn local model server (llama-swap fronting llama-server, loopback only)
After=network-online.target

[Service]
ExecStart=${swapBinaryPath(manifest)} --config ${path.join(dir, 'llama-swap.yaml')} --listen 127.0.0.1:8748
${system ? `User=${user}\n` : ''}Environment=HOME=${home}
Environment=HUGINN_LOCAL_DIR=${dir}
Restart=always
RestartSec=10

[Install]
WantedBy=${system ? 'multi-user.target' : 'default.target'}
`;
  }
  return `[Unit]
Description=Offer this machine's local models to Huginn (device runner + llm shim)
After=network-online.target ${LLM_SERVICE}.service

[Service]
ExecStart=${node} ${runner} serve
${system ? `User=${user}\n` : ''}Environment=HOME=${home}
Environment=HUGINN_DEVICE_DIR=${path.join(dir, 'device')}
Environment=HUGINN_LOCAL_DIR=${dir}
Restart=always
RestartSec=10

[Install]
WantedBy=${system ? 'multi-user.target' : 'default.target'}
`;
}

function winswXml(which, { dir = localDir(), node = process.execPath, manifest = MANIFEST } = {}) {
  if (which === 'llm') {
    return `<service>
  <id>${LLM_SERVICE}</id>
  <name>Huginn local model server</name>
  <description>llama-swap fronting llama-server on 127.0.0.1:8748 for the huginn local tier</description>
  <executable>${swapBinaryPath(manifest)}</executable>
  <arguments>--config "${path.join(dir, 'llama-swap.yaml')}" --listen 127.0.0.1:8748</arguments>
  <env name="HUGINN_LOCAL_DIR" value="${dir}"/>
  <onfailure action="restart" delay="10 sec"/>
  <log mode="roll-by-size"><sizeThreshold>10240</sizeThreshold><keepFiles>4</keepFiles></log>
</service>
`;
  }
  return `<service>
  <id>${RUNNER_SERVICE}</id>
  <name>Huginn local runner (device + llm shim)</name>
  <description>Offers this machine's local models to Huginn over an outbound long-poll</description>
  <executable>${node}</executable>
  <arguments>"${path.join(dir, 'bin', 'huginn-device.js')}" serve</arguments>
  <env name="HOME" value="${dir}"/>
  <env name="HUGINN_DEVICE_DIR" value="${path.join(dir, 'device')}"/>
  <env name="HUGINN_LOCAL_DIR" value="${dir}"/>
  <onfailure action="restart" delay="10 sec"/>
  <log mode="roll-by-size"><sizeThreshold>10240</sizeThreshold><keepFiles>4</keepFiles></log>
</service>
`;
}

function sysctl(args, { user = false } = {}) {
  return user ? userSystemctl(args) : RUN('systemctl', args);
}

/** Where a unit file for [name] lives, in each of the two scopes. */
// Where system units live. Overridable ONLY so that `off --purge` - which
// DELETES unit files - can be proved by a test without writing into a real /etc;
// nothing else reads the variable, and unset it is the real path.
const SYSTEMD_SYSTEM_DIR = process.env.HUGINN_SYSTEMD_SYSTEM_DIR || '/etc/systemd/system';
function unitFile(name, { system, home = os.homedir() } = {}) {
  return system
    ? path.join(SYSTEMD_SYSTEM_DIR, `${name}.service`)
    : path.join(home, '.config', 'systemd', 'user', `${name}.service`);
}

/**
 * What this machine's install looks like, read off the DISK rather than the
 * config - for the one command that runs with no config left to read.
 *
 * ⚠ WHY THIS EXISTS. `off` deletes local.json (the credentials are the point of
 * the verb) and its own closing line - "off, not gone: N model file(s) remain
 * ... (or --purge for everything)" - invites a second run. That run arrived with
 * `conf = stored || {}` and had lost the install's SCOPE and MODE: on a
 * --system install every systemd call flipped to user scope, so the purge
 * deleted $HOME/.config/systemd/user/huginn-local-{llm,runner}.service - files
 * this install never owned - never looked in /etc/systemd/system, and still
 * printed "ok remove the systemd unit files" and "Off." at exit 0.
 *
 * The unit files themselves still say which install this was: a system install
 * put them in /etc, and an ADAPTER install only ever wrote the RUNNER unit (it
 * adopts somebody else's engine, which is also why its api-key is not ours to
 * delete).
 */
function probeInstall({ home = os.homedir() } = {}) {
  const at = (n, system) => fs.existsSync(unitFile(n, { system, home }));
  const llm = { system: at(LLM_SERVICE, true), user: at(LLM_SERVICE, false) };
  const run = { system: at(RUNNER_SERVICE, true), user: at(RUNNER_SERVICE, false) };
  const out = { probed: true, systemUnits: llm.system || run.system };
  if ((run.system || run.user) && !(llm.system || llm.user)) out.mode = 'adapter';
  return out;
}

/**
 * A systemd USER unit is bound to a login session: it dies at logout, and it
 * does not exist at all until somebody has logged in once. Linger is the one
 * switch that unbinds it — and nothing in this tool ever touched it, so every
 * Linux install this manager has ever done quietly stopped serving the moment
 * its owner logged out. Attempted, then REPORTED, whichever way it goes.
 */
function ensureLinger() {
  const user = serviceUser();
  if (lingerState(user) === true) {
    console.log(`  linger  already on for ${user} — this install serves while you are logged out`);
    return true;
  }
  const r = enableLinger(user);
  const after = r.ok ? lingerState(user) : false;
  if (r.ok && after !== false) {
    console.log(`  linger  enabled for ${user} — this install serves while you are logged out`);
    return true;
  }
  console.log(`  linger  NOT enabled for ${user}${r.error ? ` (${r.error})` : ''}`);
  console.log('          this install STOPS when you log out — make it permanent: huginn local persist');
  return false;
}

/**
 * A LocalSystem service cannot be installed, started or removed from an
 * unelevated shell — and discovering that AFTER a multi-GB download is the
 * worst place to. `net session` answers only for elevated tokens (SYSTEM
 * included), costs nothing, and exists on every Windows this supports.
 * Everywhere else the answer is simply yes.
 */
function isElevatedWin() {
  if (process.platform !== 'win32') return true;
  const r = RUN('net', ['session']);
  return !!r && r.status === 0;
}

function refuseUnelevated(doing) {
  if (isElevatedWin()) return;
  console.error(`refused: ${doing} touches the LocalSystem services (WinSW), which needs an elevated shell — re-run from an Administrator terminal. Verified downloads are kept, so nothing already fetched is lost.`);
  process.exit(1);
}

function installServiceLinux(which, { system }) {
  const name = which === 'llm' ? LLM_SERVICE : RUNNER_SERVICE;
  const file = unitFile(name, { system });
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, unitText(which, { system }));
  let r = sysctl(['daemon-reload'], { user: !system });
  if (r.status !== 0) throw new Error(`daemon-reload failed: ${r.stderr}`);
  r = sysctl(['enable', '--now', name], { user: !system });
  if (r.status !== 0) throw new Error(`enable --now ${name} failed: ${r.stderr}\nManual: systemctl ${system ? '' : '--user '}enable --now ${name}`);
  console.log(`  service ${name} enabled (${file})`);
}

function installServiceWindows(which) {
  const name = which === 'llm' ? LLM_SERVICE : RUNNER_SERVICE;
  const dir = P('runtime', 'winsw');
  fs.mkdirSync(dir, { recursive: true });
  const exe = path.join(dir, `${name}.exe`);
  fs.copyFileSync(P('runtime', 'WinSW-x64.exe'), exe);
  fs.writeFileSync(path.join(dir, `${name}.xml`), winswXml(which));
  let r = spawnSync(exe, ['install'], { encoding: 'utf8' });
  if (r.status !== 0 && !/already exists/i.test(r.stderr + r.stdout)) {
    throw new Error(`WinSW install ${name} failed: ${r.stderr || r.stdout}`);
  }
  r = spawnSync(exe, ['start'], { encoding: 'utf8' });
  if (r.status !== 0 && !/already.*started|already running/i.test(r.stderr + r.stdout)) {
    throw new Error(`WinSW start ${name} failed: ${r.stderr || r.stdout}`);
  }
  console.log(`  service ${name} installed + started (WinSW, LocalSystem)`);
}

function serviceState(which, conf) {
  const name = which === 'llm' ? LLM_SERVICE : RUNNER_SERVICE;
  if (process.platform === 'win32') {
    const exe = P('runtime', 'winsw', `${name}.exe`);
    if (!fs.existsSync(exe)) return 'not installed';
    const r = RUN(exe, ['status']);
    return (r.stdout || '').trim() || 'unknown';
  }
  const r = sysctl(['is-active', name], { user: !(conf && conf.systemUnits) });
  return (r.stdout || '').trim() || 'not installed';
}

// ----------------------------------------------------------------- health

function getJson(url, key) {
  return new Promise((resolve) => {
    const mod = url.startsWith('https:') ? https : http;
    const req = mod.get(url, { headers: key ? { authorization: `Bearer ${key}` } : {} }, (res) => {
      let text = '';
      res.setEncoding('utf8');
      res.on('data', (c) => { if (text.length < 65536) text += c; });
      res.on('end', () => {
        try { resolve({ status: res.statusCode, body: JSON.parse(text) }); }
        catch { resolve({ status: res.statusCode, body: null }); }
      });
    });
    req.on('error', (e) => resolve({ status: 0, error: e.message }));
    req.setTimeout(8000, () => { req.destroy(); resolve({ status: 0, error: 'timeout' }); });
  });
}

// Just the status code of a POST — used by the keyless-completions guardrail, which
// only cares whether the door refuses (401/403) or answers. Returns 0 on any
// transport error so a flaky probe never blocks an install on its own.
function postStatus(url, key, body) {
  return new Promise((resolve) => {
    const mod = url.startsWith('https:') ? https : http;
    const data = Buffer.from(JSON.stringify(body));
    const req = mod.request(url, {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'content-length': data.length, ...(key ? { authorization: `Bearer ${key}` } : {}) },
    }, (res) => { res.resume(); res.on('end', () => resolve(res.statusCode)); });
    req.on('error', () => resolve(0));
    req.setTimeout(8000, () => { req.destroy(); resolve(0); });
    req.end(data);
  });
}

/**
 * Health means reading the model-list BODY and requiring it nonempty — never a
 * TCP connect (the empty-daemon trap: a healthy-looking endpoint serving
 * nothing). Auth is asserted, not assumed: a keyless completions request must
 * be refused, or the loopback bind is the only fence and that is said.
 */
async function health(conf) {
  const base = conf.mode === 'adapter' ? conf.adapter.url : `http://127.0.0.1:${conf.port}`;
  const key = conf.mode === 'adapter' ? (conf.adapter.key || null) : readKey();
  const listPath = conf.mode === 'adapter' && conf.adapter.kind === 'ollama' ? '/api/tags' : '/v1/models';
  const r = await getJson(base + listPath, key);
  const list = r.body && (r.body.data || r.body.models);
  const names = Array.isArray(list)
    ? list.map((m) => m.id || m.name || m.model).filter(Boolean) : [];
  return { reachable: r.status > 0, status: r.status, models: names, base };
}

// -------------------------------------------------------------- enrolment

function runnerPath() {
  const machine = P('bin', 'huginn-device.js');
  if (fs.existsSync(machine)) return machine;
  return path.join(os.homedir(), '.huginn', 'huginn-device');
}

function enrolDevice(conf, models) {
  const p = persistence(conf);
  const devDir = P('device');
  fs.mkdirSync(devDir, { recursive: true });
  const devConf = path.join(devDir, 'device.json');
  let existing = {};
  try { existing = JSON.parse(fs.readFileSync(devConf, 'utf8')); } catch { /* fresh */ }
  // Scope is seeded in the CONFIG, deliberately not passed as a flag: the
  // enrol verb refuses `--scope generate` from a hand (a typo'd claude
  // enrolment must never land on the serving rung); this file is how `huginn
  // local on` says it on purpose.
  fs.writeFileSync(devConf, JSON.stringify({
    ...existing,
    url: conf.url,
    name: conf.deviceName,
    scope: 'generate',
    // The ENGINE knob: generate work spawns conf.llm (the shim), never
    // conf.claude — the runner's engine dispatch is by mode, and this row's
    // scope refuses every claude mode anyway.
    llm: P('bin', 'huginn-llm-shim.js'),
    models: models.map((m) => ({ slug: m.slug, display: m.display })),
    // The FACET the fleet view reads: does this box serve with nobody logged
    // in? Written here because only the manager knows how the services were
    // installed — the runner just forwards it. Omitted rather than guessed
    // when this machine cannot answer, because `false` is a claim.
    ...(typeof p.persistent === 'boolean' ? { persistent: p.persistent } : {}),
  }, null, 2) + '\n', { mode: 0o600 });
  const r = spawnSync(process.execPath, [runnerPath(), 'on'], {
    encoding: 'utf8',
    env: { ...process.env, HUGINN_DEVICE_DIR: devDir },
  });
  process.stdout.write(r.stdout || '');
  process.stderr.write(r.stderr || '');
  if (r.status !== 0) throw new Error('enrolment failed — see above; the services are installed but this machine is not offered to huginn yet');
  const after = JSON.parse(fs.readFileSync(devConf, 'utf8'));
  return { llmSlug: after.llmSlug || null, id: after.id || null };
}

// -------------------------------------------------------------------- on

/** `--class` may narrow, never widen; G16 asked-for still serves the G8 plan. */
function narrowClass(det, cls) {
  const order = { A: 0, C: 1, G8: 2, G16: 3 };
  if (!(cls in order)) return { error: `unknown class "${cls}" — one of: G8, G16, C, A`, exit: 2 };
  if (!det.refuse && order[cls] > order[det.cls]) {
    return { error: `--class may narrow, never widen: detected ${det.cls}, asked for ${cls}`, exit: 1 };
  }
  det.cls = cls; det.plan = cls === 'G16' ? 'G8' : cls;
  return null;
}

/**
 * `--system` on Linux, resolved to ONE prompt or an honest fallback.
 *
 * Decision 33's shape: system units behind a single elevation, exactly as
 * Windows installs LocalSystem services behind a single UAC prompt. A machine
 * offering itself is a machine, not one person's session — so the whole verb
 * re-runs as root rather than asking per systemctl call.
 *
 * When there is nothing to elevate WITH, or the prompt is declined, this does
 * not fail and does not pretend: it drops to a user unit and marks the run as
 * owing an explicit linger, which the caller then reports either way.
 * Returns 'done' when the elevated child did the work and this process should
 * stop, 'direct' when it should carry on itself.
 */
function resolveSystemInstall(flags, argv = process.argv.slice(2)) {
  if (process.platform !== 'linux' || !flags.system || isRoot()) return 'direct';
  const r = elevateOnce(argv, (tool) =>
    console.log(`  elevating once with ${tool} — the services install into /etc/systemd/system`));
  if (r.ok) return 'done';
  if (r.reason === 'none') {
    console.log('  no pkexec and no sudo here — falling back to a user unit kept alive by linger');
  } else {
    console.log(`  ${r.tool} did not elevate (${elevationDetail(r)}) — falling back to a user unit kept alive by linger`);
  }
  flags.system = false;
  flags.lingerFallback = true;
  return 'direct';
}

/**
 * Linger is settled BEFORE enrolment, not after: the device row carries a
 * `persistent` facet computed from this very answer, and a row enrolled while
 * linger was still off would tell the fleet view "only while someone is logged
 * in" about a machine that had just been made permanent.
 */
function settlePersistence(conf) {
  if (process.platform === 'linux' && !conf.systemUnits) ensureLinger();
}

/** Said once at the end, whichever road got us here. */
function reportPersistence(conf) {
  console.log(`  persist ${persistenceLine(persistence(conf))}`);
}

async function cmdOn(flags) {
  if (!MANIFEST) { console.error('this file was not generated correctly — run: node scripts/gen-local-manifest.js'); process.exit(2); }
  refuseUnelevated('turning on');
  if (resolveSystemInstall(flags) === 'done') return;
  const det = detectClass();
  if (det.refuse && !flags.adapter) { console.error(`refused: ${det.refuse}`); process.exit(1); }
  if (flags.class) {
    const err = narrowClass(det, flags.class);
    if (err) { console.error(err.error); process.exit(err.exit); }
  }
  const hostname = os.hostname().toLowerCase().replace(/[^a-z0-9-]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '').slice(0, 34) || 'machine';
  const conf = loadConf() || {};
  conf.deviceName = flags.name || conf.deviceName || `${hostname}-llm`;
  conf.url = flags.url || conf.url;
  if (!conf.url) { console.error('no daemon url — the shell wrapper passes --url (run: huginn local on)'); process.exit(2); }

  if (flags.adapter) {
    // ---- adapter mode: wrap what already serves; install nothing heavy
    const kind = String(flags.adapter).toLowerCase();
    if (!ADAPTERS[kind]) { console.error(`unknown adapter "${flags.adapter}" — ${Object.keys(ADAPTERS).join(', ')}`); process.exit(2); }
    // ⚠ NEVER ON TOP OF A MANAGED INSTALL. Adoption and management share
    // local.json, api-key and the model dir, and `saveConf` here would
    // overwrite the config of a tier this machine already runs — then `off`
    // would delete a key that is not ours. Two tiers, two directories.
    if (conf.mode === 'managed') {
      console.error(`refused: ${localDir()} already holds a MANAGED install (class ${conf.class || '?'}) — adopting into it would overwrite its config and its api key. Turn that off first, or point HUGINN_LOCAL_DIR at a directory of its own.`);
      process.exit(1);
    }
    const url = flags['adapter-url'] || ADAPTERS[kind].url;
    const host = new URL(url).hostname;
    if (!['127.0.0.1', 'localhost', '::1'].includes(host)) {
      console.error(`refused: the adapter must be on loopback (got ${host}) — the local tier's contract is loopback-only`);
      process.exit(1);
    }
    conf.mode = 'adapter';
    // Said in the config, not inferred later: the engine behind an adapter
    // belongs to somebody else — an externally installed llama-swap with its
    // own yaml and its own extra models — and every later verb has to know
    // that before it stops or deletes anything.
    conf.adopted = true;
    conf.adapter = { kind, url, key: flags['adapter-key'] || null };
    const h = await health(conf);
    if (!h.models.length) {
      console.error(`refused: ${url} ${h.reachable ? `answered but serves NO models — an alive endpoint with an empty list is the trap, not a healthy install` : `is not answering (${h.error || h.status})`}`);
      process.exit(1);
    }
    // The SAME keyless-completions gate a managed install must clear, for the
    // adapters that speak the same dialect. An adopted llama-swap is our own
    // stack installed by hand, so it gets the hard gate: a keyless completion
    // being answered means anything that reaches loopback can spend this
    // machine's model, and enrolling it would offer that to the daemon.
    if (ADAPTERS[kind].keyGate) {
      const probe = await postStatus(`${url}/v1/chat/completions`, null,
        { model: h.models[0], messages: [{ role: 'user', content: 'x' }], max_tokens: 1 });
      if (probe === 0) {
        console.log('  note: could not run the keyless-completions guardrail probe — verify by hand that a keyless completion is refused');
      } else if (probe !== 401 && probe !== 403) {
        console.error(`refused: a KEYLESS completions request to ${url} was answered ${probe} (expected 401/403) — this engine is NOT key-gated, so it is not adoptable. Give llama-server an --api-key-file and try again.`);
        process.exit(1);
      } else {
        console.log('  ok: keyless completions are refused — the adopted engine enforces its key');
      }
    }
    conf.class = det.refuse ? 'adapter' : det.cls;
    conf.modelsBySlug = {};
    const models = h.models.slice(0, 16).map((n) => {
      const slug = n.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 30);
      conf.modelsBySlug[slug] = { file: n, display: n };
      return { slug, display: n };
    });
    conf.defaultModel = models[0].slug;
    console.log(`adapter ${kind} at ${url}: ${h.models.length} model(s) — ${h.models.slice(0, 4).join(', ')}${h.models.length > 4 ? ', …' : ''}`);
    // ⚠ RECORDED, not re-derived. `off`, `status` and `update` all ask
    // conf.systemUnits which systemd scope to talk to, and the adapter branch
    // never wrote it — so an adapter runner installed with --system was later
    // looked for on the USER bus, where it does not exist: `status` reported
    // "not installed" for a running service and `off` left it running.
    conf.systemUnits = process.platform === 'win32' ? true : !!flags.system;
    installShimCopy();
    if (!flags.yes && !(await consent(`Wrap the existing ${kind} at ${url}, install the runner service, and offer "${conf.deviceName}" to huginn at ${conf.url}?`))) process.exit(1);
    saveConf(conf);
    settlePersistence(conf);
    // Enrol before the runner service starts — see the managed branch: the
    // service's own enrolment must find the id already on disk.
    const e = enrolDevice(conf, models);
    conf.llmSlug = e.llmSlug; saveConf(conf);
    installRunnerService(flags);
    if (process.platform === 'linux' && isRoot()) handBackOwnership();
    reportPersistence(conf);
    console.log(`\nOn. ${conf.deviceName} serves ${models.length} adopted model(s) from ${kind} to huginn.`);
    return;
  }

  // ---- managed mode
  const plan = planFor(det);
  if (plan.error) { console.error(`refused: ${plan.error}`); process.exit(1); }
  const needBytes = plan.downloads.reduce((s, d) => s + d.bytes, 0);
  const gate = diskGate(needBytes, freeBytes());
  console.log(`class ${det.cls}${det.cls !== plan.plan ? ` (serving the ${plan.plan} plan)` : ''}${det.gpu ? ` — GPU ${det.gpu.name} (${det.gpu.uuid})` : ''}`);
  if (det.note) console.log(`  ${det.note}`);
  console.log(`  ${gate.line}`);
  if (!gate.ok) { console.error('refused: not enough disk'); process.exit(1); }

  console.log('\nThe plan:');
  for (const d of plan.downloads) console.log(`  ${(d.bytes / (1024 * 1024)).toFixed(0).padStart(6)} MB  ${d.name}`);
  console.log(`  services ${LLM_SERVICE} + ${RUNNER_SERVICE}${servicePlanLine(flags)}`);
  console.log(`  llama-swap on 127.0.0.1:8748, api key at ${P('api-key')} — loopback only, authenticated`);
  console.log(`  device row "${conf.deviceName}" at scope generate → ${conf.url}`);
  if (!flags.yes && !(await consent('Install all of the above?'))) process.exit(1);

  conf.mode = 'managed';
  conf.class = det.cls;
  conf.port = 8748;
  conf.gpuUuid = flags['gpu-uuid'] || (det.gpu ? det.gpu.uuid : null);
  conf.systemUnits = process.platform === 'win32' ? true : !!flags.system;

  // 1-2: fetch + verify + unpack runtimes
  for (const d of plan.downloads.filter((x) => x.kind !== 'model')) {
    const file = await fetchVerified(d, P('runtime', '.dl'));
    if (d.kind === 'llama') unpack(file, P('runtime', `llama-${MANIFEST.llamaCpp.release}`));
    if (d.kind === 'cudart') unpack(file, path.dirname(serverBinaryPath()));
    if (d.kind === 'swap') unpack(file, P('runtime', `llama-swap-${MANIFEST.llamaSwap.version}`));
    if (d.kind === 'winsw') fs.copyFileSync(file, P('runtime', 'WinSW-x64.exe'));
  }
  // The win zip is flat; the linux tar carries a version dir — normalise so
  // serverBinaryPath() resolves on both.
  if (process.platform === 'win32') {
    const flat = P('runtime', `llama-${MANIFEST.llamaCpp.release}`, 'llama-server.exe');
    if (!fs.existsSync(flat)) throw new Error('llama-server.exe not found after unpack — the archive layout changed; refuse and re-pin');
  } else if (!fs.existsSync(serverBinaryPath())) {
    throw new Error('llama-server not found after unpack — the archive layout changed; refuse and re-pin');
  }
  // 3: models
  for (const d of plan.downloads.filter((x) => x.kind === 'model')) await fetchVerified(d, P('models'));
  // 4: key + config + yaml
  mintKey();
  conf.modelsBySlug = {};
  for (const m of plan.models) conf.modelsBySlug[m.slug] = { file: m.file, display: m.display, ctx: m.ctx, gpu: m.gpu };
  conf.defaultModel = plan.models.find((m) => m.role === 'chat').slug;
  fs.writeFileSync(P('llama-swap.yaml'), swapYamlFor(conf, plan.models));
  installShimCopy();
  saveConf(conf);
  // 5: services
  if (process.platform === 'win32') { installServiceWindows('llm'); } else { installServiceLinux('llm', { system: !!flags.system }); }
  settlePersistence(conf);
  // 6: health, honestly
  let h = null;
  for (let i = 0; i < 30; i++) { h = await health(conf); if (h.models.length) break; await new Promise((r) => setTimeout(r, 2000)); }
  if (!h.models.length) throw new Error(`the model server came up but lists no models (${JSON.stringify(h)}) — NOT healthy; fix before enrolling`);
  console.log(`  serving ${h.models.join(', ')}`);
  const keyless = await getJson(`http://127.0.0.1:${conf.port}/v1/models`, null);
  if (keyless.status === 200) console.log('  note: the front door answers without the key on the model LIST; completions are key-gated by llama-server itself');
  // Enforce the documented guardrail (LOCAL-TIER.md): a keyless COMPLETIONS request
  // must be refused, or the loopback bind is the only fence. The model LIST being
  // open is expected; a keyless COMPLETION being answered is not — it means anything
  // that can reach loopback can spend this machine's model, so refuse to enrol.
  const probeModel = (plan.models[0] && plan.models[0].slug) || conf.defaultModel;
  const keylessComp = await postStatus(`http://127.0.0.1:${conf.port}/v1/chat/completions`, null,
    { model: probeModel, messages: [{ role: 'user', content: 'x' }], max_tokens: 1 });
  if (keylessComp === 0) {
    console.log('  note: could not run the keyless-completions guardrail probe — verify by hand that a keyless completion is refused');
  } else if (keylessComp !== 401 && keylessComp !== 403) {
    throw new Error(`SECURITY: a KEYLESS completions request was answered ${keylessComp} (expected 401/403) — completions are NOT key-gated, so refusing to enrol. Set the engine's API key before turning this on.`);
  } else {
    console.log('  ok: keyless completions are refused — the API key is enforced');
  }
  // 7: enrol FIRST, then start the runner service. The service's own poll loop
  // also enrols, and starting it before the id exists races two registrations
  // into two device rows — found live on the first real install: the second
  // enrolment saw the first one's slug as taken and hash-suffixed itself.
  const e = enrolDevice(conf, plan.models);
  // Persist the enrolment identity BEFORE starting the runner service: if the
  // service install throws, the box has already registered a device row, and
  // losing its slug here would strand it in a misleading half-enrolled state.
  conf.llmSlug = e.llmSlug;
  saveConf(conf);
  installRunnerService(flags);
  conf.installed = {
    llamaTag: MANIFEST.llamaCpp.release, swapVersion: MANIFEST.llamaSwap.version,
    models: plan.models.map((m) => m.slug), manifestHash: manifestHash(),
  };
  saveConf(conf);
  if (process.platform === 'linux' && isRoot()) handBackOwnership();
  reportPersistence(conf);
  console.log(`\nOn. class ${conf.class}, ${plan.models.length} model(s), device "${conf.deviceName}"${conf.llmSlug ? ` (slug ${conf.llmSlug})` : ''}.`);
}

/**
 * What the consent card says about the two services, TRUE on the OS reading
 * it. "always-on" was printed on Linux for a user unit that dies at logout,
 * which is the one thing about this tier somebody consents to.
 */
function servicePlanLine(flags, platform = process.platform) {
  if (platform === 'win32') return ' (WinSW, LocalSystem — serve while you are logged out)';
  if (platform !== 'linux') return '';
  if (flags.system) return ' (systemd system units — serve while you are logged out)';
  if (flags.lingerFallback) return ' (systemd USER units — kept alive by linger, or they stop when you log out)';
  return ' (systemd user units — they STOP when you log out unless linger is on; --system makes them permanent)';
}

function installShimCopy() {
  const src = process.env.HUGINN_SHIM_SOURCE || path.join(os.homedir(), '.huginn', 'huginn-llm-shim');
  if (!fs.existsSync(src)) throw new Error(`the shim is not at ${src} — run through the shell wrapper (huginn local on), which fetches it`);
  fs.mkdirSync(P('bin'), { recursive: true });
  fs.copyFileSync(src, P('bin', 'huginn-llm-shim.js'));
  const runnerSrc = path.join(os.homedir(), '.huginn', 'huginn-device');
  if (fs.existsSync(runnerSrc)) fs.copyFileSync(runnerSrc, P('bin', 'huginn-device.js'));
  else if (!fs.existsSync(P('bin', 'huginn-device.js'))) {
    // Without the runner there is a model server but no way to serve it to
    // huginn — refuse HERE, not at enrolment with a bare spawn error.
    throw new Error(`the device runner is not at ${runnerSrc} — run through a door that fetches it (huginn local on, or the desktop's set-up flow)`);
  }
}

function installRunnerService(flags) {
  if (process.platform === 'win32') installServiceWindows('runner');
  else installServiceLinux('runner', { system: !!flags.system });
}

function consent(question) {
  return new Promise((resolve) => {
    process.stdout.write(`${question} [y/N] `);
    process.stdin.setEncoding('utf8');
    process.stdin.once('data', (d) => { process.stdin.pause(); resolve(/^y(es)?$/i.test(String(d).trim())); });
  });
}

function manifestHash() {
  return crypto.createHash('sha256').update(JSON.stringify(MANIFEST)).digest('hex').slice(0, 16);
}

// ------------------------------------------------------------------- off

/**
 * The whole local tier, gone. GUARDED rather than trusted: HUGINN_LOCAL_DIR is
 * an argument somebody supplies, and a recursive delete of whatever it happens
 * to hold is the one mistake this file must never make. The two answers that
 * mean it was set to the wrong thing are a filesystem root and a home
 * directory, and neither is something the local tier ever owns.
 */
function purgeDir() {
  const dir = path.resolve(localDir());
  if (dir === path.parse(dir).root || dir === path.resolve(os.homedir())) {
    throw new Error(`refusing to delete ${dir} — HUGINN_LOCAL_DIR names a directory the local tier does not own`);
  }
  fs.rmSync(dir, { recursive: true, force: true });
}

/** The typed confirmation. A y/n is too cheap for a delete this size. */
function typedDelete(what) {
  return new Promise((res) => {
    process.stdout.write(`Type "delete" to remove ${what}: `);
    process.stdin.setEncoding('utf8');
    process.stdin.once('data', (d) => { process.stdin.pause(); res(String(d).trim() === 'delete'); });
  });
}

async function cmdOff(flags) {
  const stored = loadConf();
  const purging = flags.purge === true || flags['purge-models'] === true;
  // ⚠ `off` now takes local.json with it — the credentials are the point of the
  // verb — so the SECOND off, the one somebody runs after reading "off, not
  // gone: 12 model file(s) remain", arrives with no config to load. Refusing
  // there would strand the exact files that message just pointed at.
  if (!stored && !(purging && fs.existsSync(localDir()))) {
    console.error('not set up — nothing to turn off'); process.exit(1);
  }
  // No config left (this is the second run - see probeInstall): read the scope
  // and the mode off the unit files instead of defaulting to the user scope.
  const conf = stored || probeInstall();
  refuseUnelevated('turning off');
  let failed = 0;
  const step = (name, fn) => {
    try { fn(); console.log(`  ok      ${name}`); }
    catch (e) { failed += 1; console.error(`  FAILED  ${name}: ${e.message}`); }
  };
  // ⚠ ONLY THE SERVICES THIS TIER INSTALLED. In adapter mode the model server
  // belongs to somebody else — an externally installed llama-swap with its own
  // yaml and its own extra models — and stopping it here would take down a
  // service this tool never started, on the one kind of box where that is the
  // whole point. Adoption ends by giving the engine back, untouched.
  const ours = conf.mode === 'adapter' ? ['runner'] : ['runner', 'llm'];
  // Runner first, so nothing re-enrols while the rest comes down.
  if (process.platform === 'win32') {
    for (const which of ours) {
      const name = which === 'runner' ? RUNNER_SERVICE : LLM_SERVICE;
      const exe = P('runtime', 'winsw', `${name}.exe`);
      if (fs.existsSync(exe)) {
        step(`stop ${name}`, () => { const r = spawnSync(exe, ['stop'], { encoding: 'utf8' }); if (r.status !== 0 && !/not.*started|stopped/i.test(r.stderr + r.stdout)) throw new Error(r.stderr || r.stdout); });
        step(`uninstall ${name}`, () => { const r = spawnSync(exe, ['uninstall'], { encoding: 'utf8' }); if (r.status !== 0) throw new Error(r.stderr || r.stdout); });
      }
    }
  } else {
    for (const name of ours.map((w) => (w === 'runner' ? RUNNER_SERVICE : LLM_SERVICE))) {
      step(`disable ${name}`, () => {
        const r = sysctl(['disable', '--now', name], { user: !conf.systemUnits });
        if (r.status !== 0 && !/does not exist|not loaded/i.test(r.stderr)) throw new Error(r.stderr.trim());
      });
    }
  }
  // Deregister — inherits the device-off honesty: a DELETE failure keeps the
  // id and exits nonzero, and this command then does NOT proceed to deletions.
  const r = spawnSync(process.execPath, [runnerPath(), 'off'], {
    encoding: 'utf8', env: { ...process.env, HUGINN_DEVICE_DIR: P('device') },
  });
  process.stdout.write(r.stdout || ''); process.stderr.write(r.stderr || '');
  if (r.status !== 0) {
    console.error('\nStill enrolled at the daemon — services are down; run `huginn local off` again when huginn is reachable.');
    process.exit(1);
  }

  // ⚠ THE CREDENTIALS GO WITH THE ROW, and this is the half `off` used to skip.
  // The delegation above has just taken <localDir>/device/{device.json,appd-token}
  // with it (huginn-device's own forget()), and these are the rest: local.json
  // names the row, the models and the port, and api-key is the bearer the
  // loopback server checks. A machine that had been turned off kept all of them
  // on disk, so "off" meant a stopped service and a full set of live secrets.
  // Not conditional on --purge: a token is not a model, and nobody turns a
  // service off in order to keep its key.
  step('remove local.json + api-key', () => {
    // api-key only when THIS tier minted it. An adopted engine authenticates
    // with a key somebody else wrote, and deleting it would break a service
    // `off` has just promised not to touch.
    const files = conf.mode === 'adapter'
      ? ['local.json', 'local.json.tmp']
      : ['local.json', 'local.json.tmp', 'api-key'];
    for (const f of files) fs.rmSync(P(f), { force: true });
    // Belt and braces — the delegation normally already did these.
    fs.rmSync(P('device', 'appd-token'), { force: true });
    fs.rmSync(P('device', 'device.json'), { force: true });
  });

  if (flags.purge === true) {
    // The whole tier: models, sessions, bin, runtime, and the directory itself.
    // The services are already stopped and deregistered above; on Linux their
    // UNIT FILES outlive `disable`, and a unit file pointing at a deleted
    // binary is a service that fails on every boot forever.
    if (!flags.yes && !(await typedDelete(localDir()))) {
      console.log('kept the local tier.'); process.exit(failed ? 1 : 0);
    }
    if (process.platform !== 'win32') {
      step('remove the systemd unit files', () => {
        // ⚠ ONLY FILES THAT ARE THERE, IN WHICHEVER SCOPE THEY ARE THERE. A
        // single guessed scope is how a purge deleted user units it never
        // installed while the real system units survived `disable`d in /etc -
        // root-owned residue that a later user-scope re-install collides with.
        const scopes = new Set();
        for (const which of ours) {
          const name = which === 'runner' ? RUNNER_SERVICE : LLM_SERVICE;
          for (const system of [true, false]) {
            const f = unitFile(name, { system });
            if (fs.existsSync(f)) { fs.rmSync(f, { force: true }); scopes.add(system); }
          }
        }
        if (!scopes.size) scopes.add(!!conf.systemUnits);
        for (const system of scopes) sysctl(['daemon-reload'], { user: !system });
      });
    }
    step(`remove ${localDir()}`, () => purgeDir());
  } else if (flags['purge-models']) {
    if (!flags.yes && !(await typedDelete(`${P('models')} and ${P('sessions')}`))) {
      console.log('kept the models.'); process.exit(failed ? 1 : 0);
    }
    step('purge models + sessions', () => { fs.rmSync(P('models'), { recursive: true, force: true }); fs.rmSync(P('sessions'), { recursive: true, force: true }); });
  } else {
    let kept = 0;
    try { kept = fs.readdirSync(P('models')).length; } catch { /* none */ }
    if (kept) console.log(`off, not gone: ${kept} model file(s) remain at ${P('models')} — remove with: huginn local off --purge-models  (or --purge for everything)`);
  }
  if (failed) { console.error(`\n${failed} step(s) failed — NOT fully off.`); process.exit(1); }
  console.log('\nOff.');
}

// ---------------------------------------------------------------- status

async function statusInfo() {
  const conf = loadConf();
  if (!conf) return { setup: false };
  const h = await health(conf).catch(() => ({ reachable: false, models: [] }));
  let shimVersion = null;
  try {
    const r = RUN(process.execPath, [P('bin', 'huginn-llm-shim.js'), '--version']);
    shimVersion = (r.stdout || '').trim() || null;
  } catch { /* absent */ }
  let sessions = 0;
  try { sessions = fs.readdirSync(P('sessions')).length; } catch { /* none */ }
  const p = persistence(conf);
  return {
    setup: true,
    mode: conf.mode, class: conf.class, deviceName: conf.deviceName, llmSlug: conf.llmSlug || null,
    port: conf.port || null, adapter: conf.adapter || null,
    // Whether the engine behind this row is ours to stop. True in adapter
    // mode, and the reason `off` leaves the model server alone.
    adopted: conf.adopted === true || conf.mode === 'adapter',
    // ⚠ THE QUESTION NO SURFACE COULD ANSWER. `services.llm: active` is true
    // of a user unit five seconds before its owner logs out. These three say
    // which kind of install this is and whether it survives that; `null` is a
    // real value and means this machine could not be asked.
    systemUnits: p.systemUnits,
    linger: p.linger,
    persistent: p.persistent,
    services: { llm: conf.mode === 'adapter' ? `n/a (adopted ${(conf.adapter && conf.adapter.kind) || 'engine'})` : serviceState('llm', conf), runner: serviceState('runner', conf) },
    engine: { reachable: h.reachable, models: h.models, base: h.base },
    models: Object.keys(conf.modelsBySlug || {}),
    defaultModel: conf.defaultModel || null,
    shimVersion,
    sessions,
    installed: conf.installed || null,
  };
}

async function cmdStatus(flags) {
  const s = await statusInfo();
  if (flags.json) { process.stdout.write(JSON.stringify(s) + '\n'); return; }
  if (!s.setup) { console.log('not set up — run: huginn local on'); return; }
  console.log(`mode        ${s.mode}${s.adopted ? ` (adopted ${(s.adapter && s.adapter.kind) || 'engine'}, class ${s.class})` : ` (class ${s.class})`}`);
  console.log(`device      ${s.deviceName}${s.llmSlug ? ` (slug ${s.llmSlug})` : ''}`);
  console.log(`services    llm: ${s.services.llm} · runner: ${s.services.runner}`);
  console.log(`persistence ${persistenceLine({ systemUnits: s.systemUnits, linger: s.linger, persistent: s.persistent })}`);
  console.log(`engine      ${s.engine.reachable ? `serving ${s.engine.models.length} model(s): ${s.engine.models.join(', ')}` : 'NOT ANSWERING'} at ${s.engine.base || '?'}`);
  console.log(`shim        ${s.shimVersion || 'not installed'}`);
  console.log(`sessions    ${s.sessions} file(s)`);
  if (s.installed) console.log(`pins        llama.cpp ${s.installed.llamaTag} · llama-swap ${s.installed.swapVersion} · manifest ${s.installed.manifestHash}`);
}

// ---------------------------------------------------------------- update

async function cmdUpdate(flags) {
  if (!MANIFEST) { console.error('this file was not generated correctly'); process.exit(2); }
  const conf = loadConf();
  if (!conf) { console.error('not set up — run: huginn local on'); process.exit(1); }
  refuseUnelevated('updating');
  // A system unit cannot be restarted from an unprivileged shell, and this
  // verb ends in a restart — so the whole update takes the same ONE prompt
  // the install took rather than failing at its last step with the new
  // runtime already on disk.
  if (conf.systemUnits && process.platform === 'linux' && !isRoot()) {
    const r = elevateOnce(process.argv.slice(2), (tool) =>
      console.log(`  elevating once with ${tool} — this install runs as system units`));
    if (r.ok) return;
    if (r.reason === 'none') {
      console.error('refused: this install runs as system units and there is no pkexec or sudo here — re-run as root');
    } else {
      console.error(updateElevationRefusal(`${r.tool}: ${elevationDetail(r)}`));
    }
    process.exit(1);
  }
  installShimCopy();
  console.log('  shim + runner copies refreshed from ~/.huginn');
  if (conf.mode === 'adapter') { console.log('adapter mode: nothing else to update.'); return; }
  if (conf.installed && conf.installed.manifestHash === manifestHash()) {
    console.log(`pins unchanged (manifest ${manifestHash()}) — done.`);
    return;
  }
  console.log(`pins changed: ${conf.installed ? conf.installed.manifestHash : '(none)'} → ${manifestHash()}`);
  const det = detectClass();
  det.cls = conf.class; det.plan = conf.class === 'G16' ? 'G8' : conf.class;
  const plan = planFor(det);
  if (plan.error) { console.error(`refused: ${plan.error}`); process.exit(1); }
  const needBytes = plan.downloads.reduce((s, d) => s + d.bytes, 0);
  const gate = diskGate(needBytes, freeBytes());
  console.log(`  ${gate.line}`);
  if (!gate.ok) { console.error('refused: not enough disk'); process.exit(1); }
  if (!flags.yes && !(await consent('Download and switch to the new pins?'))) process.exit(1);
  for (const d of plan.downloads.filter((x) => x.kind !== 'model')) {
    const file = await fetchVerified(d, P('runtime', '.dl'));
    if (d.kind === 'llama') unpack(file, P('runtime', `llama-${MANIFEST.llamaCpp.release}`));
    if (d.kind === 'cudart') unpack(file, path.dirname(serverBinaryPath()));
    if (d.kind === 'swap') unpack(file, P('runtime', `llama-swap-${MANIFEST.llamaSwap.version}`));
    if (d.kind === 'winsw') fs.copyFileSync(file, P('runtime', 'WinSW-x64.exe'));
  }
  for (const d of plan.downloads.filter((x) => x.kind === 'model')) await fetchVerified(d, P('models'));
  conf.modelsBySlug = {};
  for (const m of plan.models) conf.modelsBySlug[m.slug] = { file: m.file, display: m.display, ctx: m.ctx, gpu: m.gpu };
  conf.defaultModel = plan.models.find((m) => m.role === 'chat').slug;
  fs.writeFileSync(P('llama-swap.yaml'), swapYamlFor(conf, plan.models));
  if (process.platform === 'win32') {
    const exe = P('runtime', 'winsw', `${LLM_SERVICE}.exe`);
    spawnSync(exe, ['restart'], { encoding: 'utf8' });
  } else {
    sysctl(['restart', LLM_SERVICE], { user: !conf.systemUnits });
  }
  let h = null;
  for (let i = 0; i < 30; i++) { h = await health(conf); if (h.models.length) break; await new Promise((r) => setTimeout(r, 2000)); }
  if (!h.models.length) { console.error('the updated server lists NO models — the previous runtime generation is still on disk; investigate before deleting anything'); process.exit(1); }
  conf.installed = { llamaTag: MANIFEST.llamaCpp.release, swapVersion: MANIFEST.llamaSwap.version, models: plan.models.map((m) => m.slug), manifestHash: manifestHash() };
  saveConf(conf);
  console.log(`updated: serving ${h.models.join(', ')}`);
}

// ---------------------------------------------------------------- doctor

/**
 * The persistence verdict, as a doctor line.
 *
 * ⚠ IT FAILS, it does not note. "user unit + no linger" is a box that serves
 * until its owner logs out and then quietly stops, while every other line on
 * this screen stays green — `systemctl --user is-active` says `active` right
 * up until the session ends. A checkup whose only word for that is a polite
 * note is a checkup that agrees with the machine's own wrong answer.
 */
function persistenceVerdict(s) {
  const line = persistenceLine({ systemUnits: s.systemUnits, linger: s.linger, persistent: s.persistent });
  if (s.persistent === true) return { level: 'ok', line };
  if (s.persistent === false) return { level: 'FAIL', line };
  return { level: 'note', line };
}

async function cmdDoctor() {
  const s = await statusInfo();
  if (!s.setup) { console.log('not set up.'); return; }
  await cmdStatus({});
  console.log('\ndoctor:');
  let failed = 0;
  const shim = P('bin', 'huginn-llm-shim.js');
  const r = RUN(process.execPath, [shim, '--contract-check']);
  const frames = ((r && r.stdout) || '').trim().split('\n').filter(Boolean);
  const okShape = !!r && r.status === 0 && frames.length >= 3
    && frames[0].includes('"subtype":"init"') && frames[frames.length - 1].includes('"type":"result"');
  if (!okShape) failed += 1;
  console.log(`  ${okShape ? 'ok    ' : 'FAIL  '}shim --contract-check (${frames.length} frames)`);
  const pv = persistenceVerdict(s);
  if (pv.level === 'FAIL') failed += 1;
  console.log(`  ${pv.level.padEnd(6)}persistence: ${pv.line}`);
  const gate = diskGate(0, freeBytes());
  console.log(`  ok    disk: ${gate.line}`);
  const g = gpus();
  console.log(`  ok    gpu: ${g.length ? g.map((x) => `${x.name} ${Math.round(x.memMiB / 1024)}GiB`).join(', ') : 'none visible'}`);
  for (const [kind, url] of [['ollama', 'http://127.0.0.1:11434/api/tags'], ['lmstudio', 'http://127.0.0.1:1234/v1/models']]) {
    const probe = await getJson(url, null);
    const list = probe.body && (probe.body.models || probe.body.data);
    if (Array.isArray(list)) console.log(`  note  an existing ${kind} serves ${list.length} model(s) here — adapter mode can wrap it`);
  }
  if (failed) {
    console.error(`\n${failed} check(s) FAILED — this install is not doing what it says.`);
    process.exit(1);
  }
}

// ---------------------------------------------------------------- persist

/**
 * Move a user-unit install onto system units, in order.
 *
 * Returned as data rather than done inline so the order can be gated: this
 * sequence is the whole correctness of the verb. The runner stops first (or it
 * re-enrols into the gap), the old unit FILES go before the new ones are
 * written (or a logout later resurrects a second llama-swap onto the same
 * port), and the system llm comes up before the system runner (the same
 * enrolment race the managed install already avoids).
 */
function persistSteps({ home = os.homedir(), user = serviceUser() } = {}) {
  return [
    { kind: 'stop-user', names: [RUNNER_SERVICE, LLM_SERVICE] },
    { kind: 'disable-user', names: [RUNNER_SERVICE, LLM_SERVICE] },
    { kind: 'remove-user-units', files: [RUNNER_SERVICE, LLM_SERVICE].map((n) => unitFile(n, { system: false, home })) },
    { kind: 'reload-user' },
    { kind: 'write-system-units', files: [LLM_SERVICE, RUNNER_SERVICE].map((n) => unitFile(n, { system: true })) },
    { kind: 'reload-system' },
    { kind: 'enable-system', names: [LLM_SERVICE, RUNNER_SERVICE] },
    { kind: 'hand-back', dir: localDir(), user },
    { kind: 'record', conf: { systemUnits: true } },
  ];
}

/**
 * `huginn local persist` — make an existing install survive logout.
 *
 * The verb exists because the honest answer changed AFTER people had already
 * installed: every Linux box activated before this release holds user units,
 * and telling somebody to uninstall and re-download a 5 GB tier to move two
 * text files would be a worse answer than moving them.
 *
 * The user half runs UNELEVATED first — `systemctl --user` as root talks to
 * root's own manager and would exit 0 having stopped nothing — and only the
 * /etc half asks for the one prompt.
 */
async function cmdPersist(flags) {
  const conf = loadConf();
  if (!conf) { console.error('not set up — run: huginn local on'); process.exit(1); }
  if (process.platform === 'win32') {
    console.log('Windows already installs both services as LocalSystem — they serve while you are logged out. Nothing to do.');
    return;
  }
  if (process.platform !== 'linux') { console.error(`refused: persist is a systemd verb and this is ${process.platform}`); process.exit(1); }
  if (conf.systemUnits) {
    console.log(`already on system units — ${persistenceLine(persistence(conf))}`);
    return;
  }

  let failed = 0;
  const step = (name, fn) => {
    try { fn(); console.log(`  ok      ${name}`); }
    catch (e) { failed += 1; console.error(`  FAILED  ${name}: ${e.message}`); }
  };
  const steps = persistSteps();
  const userHalf = steps.filter((x) => x.kind.endsWith('-user'));
  const run = (list) => {
    for (const st of list) {
      switch (st.kind) {
        case 'stop-user':
          for (const n of st.names) step(`stop --user ${n}`, () => { sysctl(['stop', n], { user: true }); });
          break;
        case 'disable-user':
          for (const n of st.names) step(`disable --user ${n}`, () => { sysctl(['disable', n], { user: true }); });
          break;
        case 'remove-user-units':
          step('remove the user unit files', () => { for (const f of st.files) fs.rmSync(f, { force: true }); });
          break;
        case 'reload-user':
          step('daemon-reload --user', () => { sysctl(['daemon-reload'], { user: true }); });
          break;
        case 'write-system-units':
          step('write the system unit files', () => {
            for (const which of ['llm', 'runner']) {
              const f = unitFile(which === 'llm' ? LLM_SERVICE : RUNNER_SERVICE, { system: true });
              fs.mkdirSync(path.dirname(f), { recursive: true });
              fs.writeFileSync(f, unitText(which, { system: true }));
            }
          });
          break;
        case 'reload-system':
          step('daemon-reload', () => { const r = sysctl(['daemon-reload']); if (r.status !== 0) throw new Error(String(r.stderr || '').trim()); });
          break;
        case 'enable-system':
          for (const n of st.names) {
            step(`enable --now ${n}`, () => { const r = sysctl(['enable', '--now', n]); if (r.status !== 0) throw new Error(String(r.stderr || '').trim()); });
          }
          break;
        case 'hand-back':
          step(`hand ${st.dir} back to ${st.user}`, () => { handBackOwnership(st.dir, st.user); });
          break;
        case 'record':
          step('record systemUnits in local.json', () => { saveConf({ ...loadConf(), ...st.conf }); });
          break;
        default: break;
      }
    }
  };

  if (!isRoot()) {
    // The half that MUST be unprivileged, before the prompt.
    run(userHalf);
    const r = elevateOnce(['persist', ...(flags.yes ? ['--yes'] : [])], (tool) =>
      console.log(`  elevating once with ${tool} — the units move into /etc/systemd/system`));
    if (r.ok) return;
    if (r.reason === 'none') {
      console.error('  no pkexec and no sudo here');
    } else {
      console.error(`  ${r.tool} did not elevate (${elevationDetail(r)})`);
    }
    // Declined or unavailable: linger is the honest second-best, and the user
    // units were just taken down — put them back before offering it.
    console.log('  falling back to a user unit kept alive by linger');
    step('reinstall the user units', () => {
      for (const which of ['llm', 'runner']) installServiceLinux(which, { system: false });
    });
    const lingered = ensureLinger();
    console.log(`  persist ${persistenceLine(persistence(loadConf() || {}))}`);
    process.exit(failed || !lingered ? 1 : 0);
  }

  run(steps);
  console.log(`  persist ${persistenceLine(persistence(loadConf() || {}))}`);
  if (failed) { console.error(`\n${failed} step(s) failed — NOT migrated.`); process.exit(1); }
  console.log('\nPersistent. This machine serves huginn with nobody logged in.');
}

// ------------------------------------------------------------------- plan

/**
 * Everything `on` would decide, with nothing `on` would do: detection, the
 * chosen plan, the disk gate and the device name, as one answer. This is the
 * desktop app's consent card — the UI shows exactly what the terminal flow
 * would have printed, and only after a human has read it does anything run
 * `on --yes`. No file is written, no service touched, nothing downloaded.
 */
async function cmdPlan(flags) {
  if (!MANIFEST) { console.error('this file was not generated correctly — run: node scripts/gen-local-manifest.js'); process.exit(2); }
  const det = detectClass();
  if (flags.class && !det.refuse) {
    const err = narrowClass(det, flags.class);
    if (err) { console.error(err.error); process.exit(err.exit); }
  }
  const hostname = os.hostname().toLowerCase().replace(/[^a-z0-9-]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '').slice(0, 34) || 'machine';
  const conf = loadConf() || {};
  const out = {
    version: VERSION,
    dir: localDir(),
    platform: process.platform,
    elevated: isElevatedWin(),
    setup: !!conf.mode,
    deviceName: flags.name || conf.deviceName || `${hostname}-llm`,
    services: [LLM_SERVICE, RUNNER_SERVICE],
    // What the consent card needs to tell the truth about persistence BEFORE
    // anything is installed. `elevation` is how the one prompt would happen
    // (null = there is no way to become root here); `persistent` is what the
    // install would BE — true when the services can be system-scoped, null on
    // Linux with no elevator, because linger is attempted and may not take,
    // and promising in advance is how the old "always-on" copy got it wrong.
    elevation: elevator(),
    persistent: process.platform === 'win32' ? true : (elevator() ? true : null),
  };
  if (det.refuse) { out.refuse = det.refuse; }
  else {
    out.cls = det.cls;
    if (det.note) out.note = det.note;
    if (det.gpu) out.gpu = { name: det.gpu.name, memMiB: det.gpu.memMiB };
    const plan = planFor(det);
    if (plan.error) { out.refuse = plan.error; }
    else {
      out.plan = plan.plan;
      out.downloads = plan.downloads.map((d) => ({ kind: d.kind, name: d.name, bytes: d.bytes }));
      out.needBytes = plan.downloads.reduce((s, d) => s + d.bytes, 0);
      const gate = diskGate(out.needBytes, freeBytes());
      out.gate = { ok: gate.ok, line: gate.line };
    }
  }
  if (flags.json) { console.log(JSON.stringify(out)); return; }
  if (out.refuse) { console.error(`refused: ${out.refuse}`); process.exit(1); }
  console.log(`class ${out.cls}${out.cls !== out.plan ? ` (serving the ${out.plan} plan)` : ''}${out.gpu ? ` — GPU ${out.gpu.name}` : ''}`);
  if (out.note) console.log(`  ${out.note}`);
  console.log(`  ${out.gate.line}`);
  for (const d of out.downloads) console.log(`  ${(d.bytes / (1024 * 1024)).toFixed(0).padStart(6)} MB  ${d.name}`);
  console.log(`  device row "${out.deviceName}" at scope generate`);
  if (!out.gate.ok) { console.error('refused: not enough disk'); process.exit(1); }
}

// ------------------------------------------------------------------- main

function usage() {
  console.log(`huginn-local ${VERSION} — serve local AI models to Huginn from this machine.

  huginn local on     [--class G8|G16|C|A] [--gpu-uuid U] [--name N] [--yes] [--system]
                      [--adapter llama-swap|ollama|lmstudio [--adapter-url URL] [--adapter-key K]]
                      --system installs SYSTEM services behind ONE elevation prompt, so
                      this machine serves while you are logged out; without it (or when
                      the prompt is declined) the user units are kept alive by linger
  huginn local persist [--yes]
                      make an existing install permanent: migrate user units to system
                      units, or enable linger if there is nothing to elevate with
  huginn local plan   [--class G8|G16|C|A] [--name N] [--json]   what \`on\` would do, doing nothing
  huginn local off    [--purge-models] [--purge] [--yes]
                      off keeps the models; --purge-models takes those too;
                      --purge removes the whole tier, ${localDir()} included.
                      An ADOPTED engine is never stopped or deleted — only the runner
  huginn local status [--json]
  huginn local unit   [--system] [--which llm|runner]
  huginn local update [--yes]
  huginn local doctor   exits nonzero when this install is not doing what it says`);
}

async function main() {
  const cmd = process.argv[2];
  const rest = process.argv.slice(3);
  const known = ['class', 'gpu-uuid', 'name', 'url', 'yes', 'system', 'json', 'adapter', 'adapter-url', 'adapter-key', 'purge-models', 'purge', 'which'];
  const parsed = parseFlags(rest, known);
  if (parsed.error) { console.error(`huginn-local ${cmd || ''}: ${parsed.error}`); process.exit(2); }
  const flags = parsed.flags;
  switch (cmd) {
    case 'on': await cmdOn(flags); break;
    case 'persist': await cmdPersist(flags); break;
    case 'plan': await cmdPlan(flags); break;
    case 'off': await cmdOff(flags); break;
    case 'status': await cmdStatus(flags); break;
    case 'update': await cmdUpdate(flags); break;
    case 'doctor': await cmdDoctor(flags); break;
    case 'unit': {
      const which = flags.which || 'llm';
      if (!['llm', 'runner'].includes(which)) { console.error('--which llm|runner'); process.exit(2); }
      process.stdout.write(unitText(which, { system: !!flags.system }));
      break;
    }
    case 'version': console.log(VERSION); break;
    default: usage(); process.exit(cmd ? 2 : 0);
  }
}

if (require.main === module) {
  main().catch((e) => { console.error(`huginn-local: ${e.message}`); process.exit(1); });
} else {
  module.exports = {
    VERSION, MANIFEST, parseFlags, detectClass, planFor, diskGate, swapYamlFor,
    unitText, winswXml, mintKey, localDir, statusInfo, manifestHash, narrowClass,
    LLM_SERVICE, RUNNER_SERVICE, ADAPTERS,
    // The persistence half, exported so it can be driven on a machine that has
    // neither systemd nor logind — see setRunner.
    setRunner, serviceUser, lingerState, enableLinger, persistence, persistenceLine,
    persistenceVerdict, probeInstall, elevator, elevators, elevateOnce, updateElevationRefusal,
    elevationArgv, unitFile, persistSteps, servicePlanLine,
  };
}
