function localDir() {
  if (process.env.HUGINN_LOCAL_DIR) return process.env.HUGINN_LOCAL_DIR;
  return process.platform === 'win32'
    ? path.join(process.env.ProgramData || 'C:\\ProgramData', 'huginn-local')
    : path.join(os.homedir(), '.config', 'huginn-local');
}
const P = (...xs) => path.join(localDir(), ...xs);

function loadConf() {
  try { return JSON.parse(fs.readFileSync(P('local.json'), 'utf8')); } catch { return null; }
}
function saveConf(conf) {
  fs.mkdirSync(localDir(), { recursive: true });
  const tmp = P('local.json.tmp');
  fs.writeFileSync(tmp, JSON.stringify(conf, null, 2) + '\n', { mode: 0o600 });
  fs.renameSync(tmp, P('local.json'));
}

// ------------------------------------------------------------------ flags

/**
 * `--flag value` AND `--flag=value`, anything unrecognised REFUSED with exit 2.
 * The --scpoe lesson: a silently ignored flag prints success over the exact
 * thing the operator asked for and did not get.
 */
function parseFlags(argv, known) {
  const flags = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (!a.startsWith('--')) return { error: `unexpected argument "${a}"` };
    const eq = a.indexOf('=');
    const name = (eq >= 0 ? a.slice(2, eq) : a.slice(2));
    if (!known.includes(name)) return { error: `unknown flag "--${name}"` };
    // The value-less flags, and NO `=` form for them. `--purge-models=false`
    // has one honest reading and it is "keep the models", but the eq branch
    // below stores a STRING, and every `if (flags.x)` here reads a non-empty
    // string as yes — so the one spelling somebody reaches for to turn a
    // destructive flag off is the spelling that turns it on.
    if (['yes', 'system', 'json', 'purge-models', 'purge'].includes(name)) {
      if (eq >= 0) return { error: `--${name} takes no value (write it as --${name})` };
      flags[name] = true; continue;
    }
    if (eq >= 0) { flags[name] = a.slice(eq + 1); continue; }
    const v = argv[++i];
    if (v === undefined) return { error: `--${name} needs a value` };
    flags[name] = v;
  }
  return { flags };
}

