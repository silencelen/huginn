const LLM_SERVICE = 'huginn-local-llm';
const RUNNER_SERVICE = 'huginn-local-runner';

/**
 * Both units pin HOME and HUGINN_LOCAL_DIR (and the runner HUGINN_DEVICE_DIR):
 * the device-unit lesson — a unit that pins HOME in a six-line comment and
 * then drops the variable that moves the same files produces a service that
 * loops forever while systemd reports it healthy.
 */
function unitText(which, { system = false, user = os.userInfo().username, home = os.homedir(), dir = localDir(), node = process.execPath, runner = path.join(os.homedir(), '.huginn', 'huginn-device'), manifest = MANIFEST } = {}) {
  if (which === 'llm') {
    return `[Unit]
Description=Huginn local model server (llama-swap fronting llama-server, loopback only)
After=network-online.target

[Service]
ExecStart=${swapBinaryPath(manifest)} --config ${path.join(dir, 'llama-swap.yaml')} --listen 127.0.0.1:8748
${system ? `User=${user}\n` : ''}Environment=HOME=${home}
Environment=HUGINN_LOCAL_DIR=${dir}
Restart=always
RestartSec=10

[Install]
WantedBy=${system ? 'multi-user.target' : 'default.target'}
`;
  }
  return `[Unit]
Description=Offer this machine's local models to Huginn (device runner + llm shim)
After=network-online.target ${LLM_SERVICE}.service

[Service]
ExecStart=${node} ${runner} serve
${system ? `User=${user}\n` : ''}Environment=HOME=${home}
Environment=HUGINN_DEVICE_DIR=${path.join(dir, 'device')}
Environment=HUGINN_LOCAL_DIR=${dir}
Restart=always
RestartSec=10

[Install]
WantedBy=${system ? 'multi-user.target' : 'default.target'}
`;
}

function winswXml(which, { dir = localDir(), node = process.execPath, manifest = MANIFEST } = {}) {
