// ------------------------------------------------------------------ paths

function localDir() {
  if (process.env.HUGINN_LOCAL_DIR) return process.env.HUGINN_LOCAL_DIR;
  return process.platform === 'win32'
    ? path.join(process.env.ProgramData || 'C:\\ProgramData', 'huginn-local')
    : path.join(os.homedir(), '.config', 'huginn-local');
}
const P = (...xs) => path.join(localDir(), ...xs);

function loadConf() {
  try { return JSON.parse(fs.readFileSync(P('local.json'), 'utf8')); } catch { return null; }
}
function saveConf(conf) {
  fs.mkdirSync(localDir(), { recursive: true });
  const tmp = P('local.json.tmp');
  fs.writeFileSync(tmp, JSON.stringify(conf, null, 2) + '\n', { mode: 0o600 });
  fs.renameSync(tmp, P('local.json'));
}

// ------------------------------------------------------------------ flags

/**
 * `--flag value` AND `--flag=value`, anything unrecognised REFUSED with exit 2.
 * The --scpoe lesson: a silently ignored flag prints success over the exact
 * thing the operator asked for and did not get.
 */
function parseFlags(argv, known) {
  const flags = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (!a.startsWith('--')) return { error: `unexpected argument "${a}"` };
    const eq = a.indexOf('=');
    const name = (eq >= 0 ? a.slice(2, eq) : a.slice(2));
    if (!known.includes(name)) return { error: `unknown flag "--${name}"` };
    if (eq >= 0) { flags[name] = a.slice(eq + 1); continue; }
    if (['yes', 'system', 'json', 'purge-models'].includes(name)) { flags[name] = true; continue; }
    const v = argv[++i];
    if (v === undefined) return { error: `--${name} needs a value` };
    flags[name] = v;
  }
  return { flags };
}

// -------------------------------------------------------------- detection

function gpus() {
  const r = spawnSync('nvidia-smi', ['--query-gpu=memory.total,uuid,name', '--format=csv,noheader,nounits'], { encoding: 'utf8' });
  if (r.error || r.status !== 0) return [];
  return r.stdout.trim().split('\n').filter(Boolean).map((l) => {
    const [mem, uuid, ...name] = l.split(',').map((s) => s.trim());
    return { memMiB: Number(mem) || 0, uuid, name: name.join(',') };
  });
}

function hasAvx2() {
  if (process.platform !== 'linux') return true; // probed by the binary itself at validate time
  try { return /\bavx2\b/.test(fs.readFileSync('/proc/cpuinfo', 'utf8')); } catch { return false; }
}

const GIB = 1024 * 1024 * 1024;

/**
 * The chosen device and class are ALWAYS printed; a refusal names the floor
 * that failed. `--class` may narrow, never widen. G16 hardware is reported but
 * installs the G8 plan (no 14B row ships until a real G16 use exists).
 */
function detectClass(env = {}) {
  const g = env.gpus ?? gpus();
  const ram = env.ram ?? os.totalmem();
  const arch = env.arch ?? process.arch;
  const platform = env.platform ?? process.platform;
  const avx2 = env.avx2 ?? hasAvx2();
  const big = g.filter((x) => x.memMiB >= 7680);
  if (big.length >= 2) return { cls: 'G16', plan: 'G8', gpu: big[0], platform, note: 'two capable GPUs found; serving the G8 plan on one card (no 14B row is pinned yet)' };
  if (big.length === 1) return { cls: 'G8', plan: 'G8', gpu: big[0], platform };
  if (g.length) {
    return { refuse: `a GPU is present (${g[0].name}, ${Math.round(g[0].memMiB / 1024)} GiB) but below the 7.5 GiB floor — CPU classes need AVX2 x86 or arm64 with enough RAM` };
  }
  if (arch === 'arm64') {
    return ram >= 7 * GIB ? { cls: 'A', plan: 'A', platform }
      : { refuse: `arm64 with ${(ram / GIB).toFixed(1)} GiB RAM is below the 7 GiB floor for the A class` };
  }
  if (arch === 'x64') {
    if (!avx2) return { refuse: 'this CPU has no AVX2, which the pinned llama-server build requires — the local tier refuses rather than degrades' };
    return ram >= 7.5 * GIB ? { cls: 'C', plan: 'C', platform }
      : { refuse: `x86 with ${(ram / GIB).toFixed(1)} GiB RAM is below the 7.5 GiB floor for the C class` };
  }
  return { refuse: `unsupported architecture "${arch}"` };
}

/** Which runtime assets this platform+plan needs. Linux GPU is refused honestly. */
function planFor(det, manifest = MANIFEST) {
  const plan = det.plan;
  const models = manifest.models[plan];
  if (!models) return { error: `no pinned models for class ${plan}` };
  const wantGpu = plan.startsWith('G');
  let llamaKey;
  if (process.platform === 'win32') llamaKey = wantGpu ? 'win-x64-cuda' : 'win-x64-cpu';
  else if (process.platform === 'linux') {
    if (wantGpu) return { error: 'no pinned CUDA build exists for Linux yet — GPU serving is Windows-only in this release' };
    llamaKey = process.arch === 'arm64' ? 'linux-arm64' : 'linux-x64';
  } else return { error: `unsupported platform "${process.platform}"` };
  const swapKey = process.platform === 'win32' ? 'win-x64' : (process.arch === 'arm64' ? 'linux-arm64' : 'linux-x64');
  const downloads = [
    { kind: 'llama', ...manifest.llamaCpp.assets[llamaKey], url: manifest.llamaCpp.urlBase + manifest.llamaCpp.assets[llamaKey].name },
    ...(llamaKey === 'win-x64-cuda'
      ? [{ kind: 'cudart', ...manifest.llamaCpp.assets['win-cudart'], url: manifest.llamaCpp.urlBase + manifest.llamaCpp.assets['win-cudart'].name }]
      : []),
    { kind: 'swap', ...manifest.llamaSwap.assets[swapKey], url: manifest.llamaSwap.urlBase + manifest.llamaSwap.assets[swapKey].name },
    ...(process.platform === 'win32'
      ? [{ kind: 'winsw', name: 'WinSW-x64.exe', sha256: manifest.winsw.sha256, bytes: manifest.winsw.bytes, url: manifest.winsw.url }]
      : []),
    ...models.map((m) => ({ kind: 'model', name: m.file, sha256: m.sha256, bytes: m.bytes, url: `https://huggingface.co/${m.repo}/resolve/main/${m.file}` })),
  ];
  return { plan, models, downloads, llamaKey };
}

/** BEFORE any download: need + 2 GiB headroom, both numbers printed. */
function diskGate(needBytes, freeBytes) {
  const need = needBytes + 2 * GIB;
  return {
    ok: freeBytes >= need,
    line: `need ${(need / GIB).toFixed(1)} GiB (incl. 2 GiB headroom), have ${(freeBytes / GIB).toFixed(1)} GiB free at ${localDir()}`,
  };
}

function freeBytes() {
  try { const s = fs.statfsSync(localDir()); return s.bavail * s.bsize; }
  catch { try { const s = fs.statfsSync(path.dirname(localDir())); return s.bavail * s.bsize; } catch { return 0; } }
}

// ------------------------------------------------------------- downloads

function sha256File(file) {
  const h = crypto.createHash('sha256');
  const fd = fs.openSync(file, 'r');
  const buf = Buffer.alloc(4 * 1024 * 1024);
  let n;
  while ((n = fs.readSync(fd, buf, 0, buf.length)) > 0) h.update(buf.subarray(0, n));
  fs.closeSync(fd);
  return h.digest('hex');
}

function fetchToFile(url, dest, redirects = 0) {
  return new Promise((resolve, reject) => {
    if (redirects > 5) return reject(new Error(`too many redirects for ${url}`));
    const mod = url.startsWith('https:') ? https : http;
    mod.get(url, { headers: { 'user-agent': 'huginn-local' } }, (res) => {
      if ([301, 302, 303, 307, 308].includes(res.statusCode)) {
        res.resume();
        return resolve(fetchToFile(res.headers.location, dest, redirects + 1));
      }
      if (res.statusCode !== 200) { res.resume(); return reject(new Error(`${url} answered ${res.statusCode}`)); }
      const out = fs.createWriteStream(dest);
      const total = Number(res.headers['content-length'] || 0);
      let got = 0, lastPct = -10;
      res.on('data', (c) => {
        got += c.length;
        if (total) {
          const pct = Math.floor((got / total) * 100);
          if (pct >= lastPct + 10) { lastPct = pct; process.stdout.write(`\r    ${path.basename(dest)}: ${pct}%   `); }
        }
      });
      res.pipe(out);
      out.on('finish', () => { process.stdout.write('\r'); out.close(() => resolve()); });
      out.on('error', reject);
      res.on('error', reject);
    }).on('error', reject);
  });
}

/** Download to .dl.tmp, verify sha256 against the pin, then move into place. */
async function fetchVerified(d, destDir) {
  fs.mkdirSync(destDir, { recursive: true });
  const dest = path.join(destDir, d.name);
  if (fs.existsSync(dest) && sha256File(dest) === d.sha256) {
    console.log(`  kept    ${d.name} (already present, hash matches)`);
    return dest;
  }
  const tmp = dest + '.dl.tmp';
  console.log(`  fetch   ${d.name} (${(d.bytes / (1024 * 1024)).toFixed(0)} MB)`);
  await fetchToFile(d.url, tmp);
  const got = sha256File(tmp);
  if (got !== d.sha256) {
    fs.unlinkSync(tmp);
    throw new Error(`${d.name}: sha256 mismatch — expected ${d.sha256}, got ${got}. The pin refuses it; nothing was installed.`);
  }
  fs.renameSync(tmp, dest);
  console.log(`  ok      ${d.name} sha256 verified`);
  return dest;
}

function unpack(archive, destDir) {
  fs.mkdirSync(destDir, { recursive: true });
  if (archive.endsWith('.tar.gz')) {
    const r = spawnSync('tar', ['-xzf', archive, '-C', destDir], { encoding: 'utf8' });
    if (r.status !== 0) throw new Error(`tar failed on ${archive}: ${r.stderr}`);
  } else if (archive.endsWith('.zip')) {
    if (process.platform === 'win32') {
      const r = spawnSync('powershell.exe', ['-NoProfile', '-Command',
        `Expand-Archive -LiteralPath "${archive}" -DestinationPath "${destDir}" -Force`], { encoding: 'utf8' });
      if (r.status !== 0) throw new Error(`Expand-Archive failed on ${archive}: ${r.stderr}`);
    } else {
      const r = spawnSync('unzip', ['-oq', archive, '-d', destDir], { encoding: 'utf8' });
      if (r.status !== 0) throw new Error(`unzip failed on ${archive}: ${r.stderr}`);
    }
  } else {
    throw new Error(`no unpacker for ${archive}`);
  }
}

// -------------------------------------------------------------- llama-swap

function serverBinaryPath(manifest = MANIFEST) {
  const rel = manifest.llamaCpp.serverBinary[process.platform === 'win32' ? 'win32' : 'linux'];
  return path.join(P('runtime', `llama-${manifest.llamaCpp.release}`), rel);
}

function swapBinaryPath(manifest = MANIFEST) {
  const name = process.platform === 'win32' ? 'llama-swap.exe' : 'llama-swap';
  return path.join(P('runtime', `llama-swap-${manifest.llamaSwap.version}`), name);
}

/**
 * GENERATED — the banner says so in the file itself. One entry per pinned
 * model; the chat model gets the class TTL (VRAM is surrendered when idle —
 * the serving box may be somebody's gaming PC), the embedder a short one.
 */
function swapYamlFor(conf, models, manifest = MANIFEST) {
  const server = serverBinaryPath(manifest);
  const lines = [
    `# GENERATED by huginn-local v${VERSION} — do not hand-edit; regenerated by 'huginn local on|update'.`,
    'healthCheckTimeout: 300',
    'models:',
  ];
  for (const m of models) {
    const gpuArgs = m.gpu ? ' -ngl 99 --flash-attn on' : ' -ngl 0';
    const env = (m.gpu && conf.gpuUuid) ? `\n    env:\n      - "CUDA_VISIBLE_DEVICES=${conf.gpuUuid}"` : '';
    const embed = m.role === 'embed' ? ' --embedding' : '';
    lines.push(
      `  "${m.slug}":`,
      `    name: "${m.display} - ${conf.deviceName || os.hostname()}"`,
      `    cmd: >`,
      `      ${server}`,
      `      --host 127.0.0.1 --port \${PORT}`,
      `      --api-key-file ${P('api-key')}`,
      `      -m ${P('models', m.file)}`,
      `      -c ${m.ctx}${gpuArgs}${embed}${env}`,
      `    ttl: ${m.role === 'embed' ? 300 : 900}`,
    );
  }
  return lines.join('\n') + '\n';
}

function mintKey() {
  const file = P('api-key');
  if (fs.existsSync(file) && fs.readFileSync(file, 'utf8').trim()) return file; // idempotent
  fs.mkdirSync(localDir(), { recursive: true });
  fs.writeFileSync(file, crypto.randomBytes(32).toString('hex') + '\n', { mode: 0o600 });
  if (process.platform === 'win32') {
    spawnSync('icacls', [file, '/inheritance:r', '/grant', 'SYSTEM:R', '/grant', 'Administrators:F'], { encoding: 'utf8' });
  }
  return file;
}

function readKey() {
  try { return fs.readFileSync(P('api-key'), 'utf8').trim() || null; } catch { return null; }
}

