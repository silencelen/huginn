<?xml version="1.0" encoding="utf-8"?>
<!-- Where camera captures land: app cache, cleaned by the OS under pressure and
     by us after upload. Nothing outside the app's own storage is ever shared. -->
<paths>
    <cache-path name="captures" path="captures/" />
    <!-- Where a downloaded, sha256-verified update APK lives until the system
         installer reads it (PhoneUpdater). App cache only. -->
    <cache-path name="updates" path="updates/" />
    <!-- A file Claude sent, copied here for the moment another app opens it
         (AndroidSentFiles). App cache only; overwritten per open. -->
    <cache-path name="sent" path="sent/" />
</paths>
