<?xml version="1.0" encoding="utf-8"?>
<!-- The Huginn raven: upright, profile facing right, one fold along the wing, ink on
     the bone tile. One evenodd path so nothing detaches at small sizes; the eye is a
     hole so it shows the tile through it. The group centres the mark at (54,54)
     scaled 0.72, which keeps the farthest vertex 28 dp from the centre, inside the
     33 dp adaptive-icon safe circle (the launcher mask crops the outer 18dp).
     Canonical path: assets/brand/raven.svg - change both together, and
     assets/brand/generate.sh for the rasters. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        android:width="108dp"
        android:height="108dp"
        android:viewportWidth="108"
        android:viewportHeight="108">
    <group
        android:pivotX="52"
        android:pivotY="43"
        android:scaleX="0.72"
        android:scaleY="0.72"
        android:translateX="2"
        android:translateY="11">
        <path
            android:fillColor="#141615"
            android:fillType="evenOdd"
            android:pathData="M76.5,28 L67.5,24.6 L54,17.8 L45,17.8 L36,21.2 L32.18,26.972 L41.616,51.925 L32.334,65.952 L30.666,64.848 L39.384,51.675 L31.106,29.786 L22.5,68.8 L40.5,68.8 L54,62 L58.5,62 L63,48.4 L63,34.8 Z M48.55,26.3 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0 Z" />
    </group>
</vector>
