<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only to tell you a session is waiting on an answer; declined simply
         means the background poll notifies nothing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice mode's streaming recognizer. Declined simply means the mic button
         falls back to the system dictation dialog, which needs no permission. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Continuous watching: a live connection so a "needs you" arrives in
         seconds rather than on WorkManager's 15-minute floor. specialUse rather
         than dataSync because dataSync is capped at 6 hours per day on Android 15
         and this is meant to sit connected; the app is sideloaded via devstore, so
         there is no store review to satisfy. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets the app ask to sit on the Doze allowlist. Without that entry the
         system suspends this app's network access while the phone is idle, so the
         heartbeat alarm still fires but its request reaches nothing — a failure that
         looks identical to no alarm at all. Play policy restricts this permission to
         a few app categories; this app is sideloaded from devstore, so the only judge
         of whether it is warranted is the person who owns both the phone and the host
         it watches. Asking is all it does: the system dialogue decides. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Lets the app self-update from GitHub releases (PhoneUpdater): the app
         downloads a sha256-verified APK and hands it to the system installer,
         which shows its own "install unknown apps" confirmation. Same reasoning
         as the Doze entry — sideloaded, so the owner is the judge, and asking is
         all it does. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Package visibility (Android 11+): resolveActivity for the system speech
         dialog silently returns null without this, which made the dictation mic
         REMOVE ITSELF on devices where it had always worked — reported as "the
         voice button used to open Google speech to text, now nothing". -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- The SERVICE, not just the (extinct) dialog activity: this is what
             SpeechRecognizer.isRecognitionAvailable resolves, and without it the
             check answers "no recognizer" on a phone carrying Google's. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Huginn">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Huginn">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- huginn in the system share sheet: a link or paragraph from any
                 app, or a photo, arrives as a new chat with it staged. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!-- Hands the camera app a write-target URI for "take a photo" attachments.
             Not exported; grants are per-capture. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.silencelen.huginn.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".notify.WatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains a connection to the user's own huginn host to deliver alerts when a Claude Code session needs an answer" />
        </service>

        <receiver
            android:name=".notify.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Installing a new version cancels this app's pending alarms, so
                     without this a release would quietly end the heartbeat. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- FCM. Data-only messages, so this runs even while the app is backgrounded
             and the app itself decides what has already been shown; a `notification`
             block would be drawn by the system without consulting the app, which would
             leave the ten-minute alarm free to repeat the same alert later. -->
        <service
            android:name=".notify.HuginnMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Answers a session's question from the notification's action buttons. Not
             exported: only this app's own notifications trigger it. -->
        <receiver
            android:name=".notify.AnswerReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- Receives what was typed into a notification's reply box. Not exported
             for the same reason: the PendingIntent that carries the text has to be
             mutable, but only this app can hand it out. -->
        <receiver
            android:name=".notify.ReplyReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- Woken by AlarmManager while the phone is idle. Not exported: it is
             triggered only by an alarm this app scheduled against its own component. -->
        <receiver
            android:name=".notify.HeartbeatReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- The home-screen widget: the session fleet at a glance. Exported as
             every appwidget receiver must be — APPWIDGET_UPDATE is a protected
             broadcast only the system can send. -->
        <receiver
            android:name=".widget.FleetWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_fleet_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fleet_widget_info" />
        </receiver>

        <!-- The ask bar: a search-bar widget that opens AskActivity. -->
        <receiver
            android:name=".widget.AskWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_ask_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ask_widget_info" />
        </receiver>

        <!-- The ask bar's overlay: a text field over the launcher, keyboard up.
             Not exported — only this app's own widget PendingIntent opens it.
             Excluded from Recents because it is a moment, not a place: after a
             send (or a dismissal) there is nothing to come back to. -->
        <activity
            android:name=".widget.AskActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Huginn.Ask"
            android:windowSoftInputMode="adjustResize|stateVisible" />
    </application>
</manifest>
