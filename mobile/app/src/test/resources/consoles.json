  "approval": {
    "applied": false,
    "runBy": "owner",
    "markerPath": "/var/lib/huginn-appd/consoles-rebind.applied",
    "title": "Reach these consoles from outside the host",
    "why": "Every page below is bound to this host's own address, so the probe can see them and a phone cannot. These steps rebind them and open the four ports on the hypervisor's firewall.",
    "steps": [
      {
        "id": "rebind",
        "where": "huginn",
        "summary": "Bind the four services to 0.0.0.0 instead of the tailnet address",
        "file": null,
        "commands": [
          "systemctl edit armap jtyper-trainer boardserver",
          "systemctl restart armap jtyper-trainer boardserver",
          "ss -ltnp | grep -E '8088|8091|8092|8093'"
        ]
      },
      {
        "id": "firewall",
        "where": "heimdall",
        "summary": "Allow the four ports from the LAN gateway",
        "file": "/etc/pve/firewall/117.fw",
        "commands": [
          "IN ACCEPT -source 192.168.2.131 -p tcp -dport 8088 -log nolog",
          "IN ACCEPT -source 192.168.2.131 -p tcp -dport 8091 -log nolog",
          "IN ACCEPT -source 192.168.2.131 -p tcp -dport 8092 -log nolog",
          "IN ACCEPT -source 192.168.2.131 -p tcp -dport 8093 -log nolog"
        ]
      }
    ],
    "note": "Run these in a netplan session; the second step is on the hypervisor, not on huginn."
  }
}
