    "markerPath": "/var/lib/huginn-appd/consoles-rebind-applied",
    "title": "Open these from your phone or laptop",
    "why": "Three of these pages are bound to this host only, so the probe below can reach them and your devices cannot. Applying this changes that. Huginn does not run these commands.",
    "steps": [
      {
        "id": "rebind",
        "where": "huginn (this host)",
        "summary": "Bind the three units to 0.0.0.0. bursar-sim already does.",
        "file": null,
        "commands": [
          "systemctl edit atlas.service            # ExecStart: bind 0.0.0.0 instead of the tailnet address",
          "systemctl edit jotter.service   # same",
          "systemctl edit boardserver.service      # same",
          "systemctl restart atlas jotter-trainer boardserver",
          "ss -ltnp | grep -E '8088|8091|8092'"
        ]
      },
      {
        "id": "firewall",
        "where": "pve1",
        "summary": "Add four rules to /etc/pve/firewall/100.fw, one source and one port each.",
        "file": "/etc/pve/firewall/100.fw",
        "commands": [
          "IN ACCEPT -source 192.168.1.131 -p tcp -dport 8088 -log nolog",
          "IN ACCEPT -source 192.168.1.131 -p tcp -dport 8091 -log nolog",
          "IN ACCEPT -source 192.168.1.131 -p tcp -dport 8092 -log nolog",
          "IN ACCEPT -source 192.168.1.131 -p tcp -dport 8093 -log nolog"
        ]
      }
    ],
    "note": "Copy these into a the ops repo session and run them there. When they are done, `touch /var/lib/huginn-appd/consoles-rebind-applied` and every console row will say so."
  }
}
