# Huginn tmux status line - Slate & Verdigris (color-02-slate-verdigris)
# Drop into server/tmux.conf in place of the current status-left line.
#
# The hex values are app tokens (tier 1 / tier 3 surfaces, onSurface, the accent);
# they need truecolor, which in tmux means BOTH of these (without the override tmux
# rounds every hex to the nearest of 256 colours):
#   set -g  default-terminal "tmux-256color"
#   set -as terminal-overrides ",*:Tc"          # tmux >= 3.2 may use: set -as terminal-features ",*:RGB"
# A 16-colour-only fallback with the same layout is at the bottom of this file.
set -g status-position bottom
set -g status-justify left
set -g status-style "bg=#1B1F25,fg=#9DA6AE"
set -g status-left-length 60
set -g status-right-length 60
# left: the one-row raven in the accent on the tier-3 surface, then the session name
# (the quiet default from ascii-04-lockups). The raven is `◢▆█▀`: U+25E2 U+2586 U+2588
# U+2580 (ascii-03-compact raven-1line-a); if the host font lacks Geometric Shapes use
# `▗▆█▀` (U+2597 first). The separator is U+258C. All single-width; no powerline
# glyphs (private-use, often missing).
set -g status-left "#[fg=#5DBBA6,bg=#2A3038,bold] ◢▆█▀ #[fg=#E4E2DC,bg=#2A3038,bold]#{session_name} #[fg=#2A3038,bg=#1B1F25]▌#[default] "
set -g window-status-format "#[fg=#9DA6AE] #I:#W "
set -g window-status-current-format "#[fg=#E4E2DC,bold] #I:#W #[fg=#5DBBA6]▌#[default]"
set -g window-status-separator ""
# right: the keybind hints the current config shows, then host and clock
set -g status-right "#[fg=#6F7983]Alt-d:detach  Alt-o:solo  ^b[:scroll #[fg=#9DA6AE] #H #[fg=#5DBBA6,bold] %H:%M "
set -g pane-border-style "fg=#3A424B"
set -g pane-active-border-style "fg=#5DBBA6"
set -g message-style "bg=#2A3038,fg=#E4E2DC"
set -g message-command-style "bg=#2A3038,fg=#5DBBA6"
set -g mode-style "bg=#2A3F3C,fg=#E4E2DC"
set -g clock-mode-colour "#5DBBA6"

# ---- 16-colour fallback: no truecolor, ANSI names only. With slate-verdigris.ansi.json
# installed in the terminal these are black=#3A424B (outlineVariant), brightblack=#6F7983
# (outline), white=#C9CDCF, cyan=#5DBBA6 (the accent slot); on any other palette
# they are that palette's colours.
# set -g status-style "bg=black,fg=brightblack"
# set -g status-left "#[fg=cyan,bg=brightblack,bold] ◢▆█▀ #[fg=white,bg=brightblack,bold]#{session_name} #[fg=brightblack,bg=black]▌#[default] "
# set -g window-status-format "#[fg=brightblack] #I:#W "
# set -g window-status-current-format "#[fg=white,bold] #I:#W #[fg=cyan]▌#[default]"
# set -g status-right "#[fg=brightblack]Alt-d:detach  Alt-o:solo  ^b[:scroll #[fg=white] #H #[fg=cyan,bold] %H:%M "
# set -g pane-border-style "fg=brightblack"
# set -g pane-active-border-style "fg=cyan"
# set -g message-style "bg=brightblack,fg=white"
# set -g clock-mode-colour "cyan"
