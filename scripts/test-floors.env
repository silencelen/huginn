# Asserted test-count floors — ONE definition, sourced by every gate.
#
# These scripts assert the COUNT, not the exit code, because a runner whose glob
# matches nothing exits 0 having run zero tests. That design only works if the
# numbers are right, and they had drifted: the same Kotlin floor was written in
# two places (one as a hand-summed total), and the appd floor was >0 in the script
# that puts the DAEMON into production while the desktop release demanded >=300 —
# so the production path accepted a suite that had lost 90% of its tests.
#
# Raise a floor here when tests are added; never edit a copy in a script.

KOTLIN_SHARED_MIN=700    # :core jvm + :core android + :app + :ui jvm   (actual 722 on 2026-08-23)
DESKTOP_EXTRA_MIN=189    # + :app-desktop, added on top of the shared floor
APPD_MIN=365             # server/appd node --test  (actual 509 on 2026-08-23)
